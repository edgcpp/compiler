{
  "version": 1,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 19,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "macos-arm-common",
      "hidden": true,
      "description": "MacOS ARM base config",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "DEBUG",
        "EDG_CPP_RT_LIBS": "macos_arm64"
      }
    },
    {
      "name": "macos-arm-clang-debug",
      "inherits": "macos-arm-common",
      "displayName": "MacOS ARM (Clang) Build Config - DEBUG",
      "description": "MacOS ARM build using Clang",
      "binaryDir": "${sourceDir}/build/clang",
      "cacheVariables": {
        "EDG_MACRO_CONF": "macos-arm-clang",
        "CMAKE_BUILD_TYPE": "Debug"
      },
      "environment": {
        "CC": "clang",
        "CXX": "clang++"
      }
    },
    {
      "name": "macos-arm-clang-release",
      "inherits": "macos-arm-common",
      "displayName": "MacOS ARM (Clang) Build Config - RELEASE",
      "description": "MacOS ARM build using Clang",
      "binaryDir": "${sourceDir}/build/clang-release",
      "cacheVariables": {
        "EDG_MACRO_CONF": "macos-arm-clang-release",
        "CMAKE_BUILD_TYPE": "Release"
      },
      "environment": {
        "CC": "clang",
        "CXX": "clang++"
      }
    },
    {
      "name": "macos-arm-gcc-be-debug",
      "inherits": "macos-arm-common",
      "displayName": "MacOS ARM (GCC Backend) Build Config - DEBUG",
      "description": "MacOS ARM build with libgccjit backend enabled",
      "binaryDir": "${sourceDir}/build/gcc-be-debug",
      "cacheVariables": {
        "EDG_MACRO_CONF": "macos-arm-clang",
        "CMAKE_BUILD_TYPE": "Debug",
        "EDG_ENABLE_GCC_BACKEND": "ON"
      },
      "environment": {
        "CC": "clang",
        "CXX": "clang++"
      }
    },
