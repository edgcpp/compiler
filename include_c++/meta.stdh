/*
meta -- Include file for std::meta facilities

This header approximates support for facilities as described in the C++
committee's paper P2996.
*/
#ifndef __META_STDH
#define __META_STDH

/* The library feature-test macro for reflection, with the value GCC 16
   uses.  As in GCC, it is defined only when reflection is enabled. */
#if defined(__cpp_impl_reflection) && !defined(__cpp_lib_reflection)
#define __cpp_lib_reflection 202603L
#endif /* defined(__cpp_impl_reflection) && ... */

#include <concepts>
#include <initializer_list>
#include <memory>
#include <new>
#include <utility>
#include <optional>
#include <ranges>
#include <source_location>
#include <span>
#include <string>
#include <string_view>
#include <type_traits>
#include <vector>
#include <climits>
#include <compare>

/*
Most of the functions declared in this header are handled intrinsically at
compile time (by the front end's interpreter).  No definitions are provided
for them here.
*/

namespace std {

  constexpr void __report_constexpr_value(long long);

  constexpr void __report_constexpr_value(char const*);

  namespace meta {
    using info = decltype(^^::);

    using __str = std::string_view;

    consteval bool has_identifier(info);

    consteval __str identifier_of(info);
    consteval std::u8string_view u8identifier_of(info);

    consteval __str display_string_of(info);
    consteval std::u8string_view u8display_string_of(info);

    consteval std::source_location source_location_of(info);

    struct access_context {
      access_context() = delete;
      consteval info scope() const { return __scope; }
      consteval info designating_class() const { return __designating_class; }
      /* current() must yield the access_context whose scope is the function,
         class, or namespace from which it is invoked.  It has no definition:
         the front end recognizes it as a constexpr intrinsic and the
         interpreter synthesizes the result by capturing the call site's
         lexical scope. */
      static consteval access_context current() noexcept;
      static consteval access_context unprivileged() noexcept {
        return access_context(^^::, info{});
      }
      static consteval access_context unchecked() noexcept {
        return access_context(info{}, info{});
      }
      consteval access_context via(info __cls) const {
        return access_context(__scope, __cls);
      }
    private:
      info __scope;
      info __designating_class;
      consteval access_context(info __s, info __dc)
        : __scope(__s), __designating_class(__dc) {}
    };

    consteval bool is_accessible(info __r, access_context __ctx);

    consteval bool has_inaccessible_nonstatic_data_members(
                                     info __r, access_context __ctx);

    consteval bool has_inaccessible_bases(info __r, access_context __ctx);

    consteval bool has_inaccessible_subobjects(info __r, access_context __ctx);

    consteval info current_function();
    consteval info current_class();
    consteval info current_namespace();

    consteval std::vector<info> members_of(info __r, access_context __ctx);

    consteval std::vector<info> static_data_members_of(
                                              info __r, access_context __ctx);

    consteval std::vector<info> nonstatic_data_members_of(
                                              info __r, access_context __ctx);

    consteval std::vector<info> bases_of(info __r, access_context __ctx);

    consteval std::vector<info> subobjects_of(info __r, access_context __ctx);

    consteval std::vector<info> enumerators_of(info __r);

    consteval std::vector<info> parameters_of(info __r);

    consteval std::vector<info> current_parameters();

    consteval bool is_same_type(info, info);

    consteval info remove_cvref(info);

    template<typename __R>
      concept reflection_range = ranges::input_range<__R> &&
          is_same_type(^^ranges::range_value_t<__R>, ^^info) &&
          is_same_type(remove_cvref(^^ranges::range_reference_t<__R>), ^^info);

    template<reflection_range __R = initializer_list<info>>
      consteval info substitute(info __templ, __R&& __args);

    template<reflection_range __R = initializer_list<info>>
      consteval bool can_substitute(info __templ, __R&& __args);

    template<reflection_range __R = initializer_list<info>>
      consteval bool is_constructible_type(info __type, __R&& __type_args);

    template<reflection_range __R = initializer_list<info>>
      consteval bool is_trivially_constructible_type(info __type,
                                                     __R&& __type_args);

    template<reflection_range __R = initializer_list<info>>
      consteval bool is_nothrow_constructible_type(info __type,
                                                   __R&& __type_args);

    template<reflection_range __R = initializer_list<info>>
      consteval bool is_invocable_type(info __type, __R&& __type_args);

    template<reflection_range __R = initializer_list<info>>
      consteval bool is_invocable_r_type(info __type_result, info __type,
                                         __R&& __type_args);

    template<reflection_range __R = initializer_list<info>>
      consteval bool is_nothrow_invocable_type(info __type, __R&& __type_args);

    template<reflection_range __R = initializer_list<info>>
      consteval bool is_nothrow_invocable_r_type(info __type_result,
                                                 info __type,
                                                 __R&& __type_args);

    template<reflection_range __R = initializer_list<info>>
      consteval info common_type(__R&& __type_args);

    template<reflection_range __R = initializer_list<info>>
      consteval info common_reference(__R&& __type_args);

    template<reflection_range __R = initializer_list<info>>
      consteval info invoke_result(info __type, __R&& __type_args);

    template<typename T>
      requires (std::is_copy_constructible_v<T>)
    consteval info reflect_constant(T v);

    template<typename T>
    consteval T extract(info);

    template<typename T>
      requires (!std::is_function_v<std::remove_reference_t<T>>)
    consteval info reflect_object(T& __obj);

    template<typename T>
      requires (std::is_function_v<std::remove_reference_t<T>>)
    consteval info reflect_function(T& __fn);

    consteval info object_of(info);
    consteval info constant_of(info);

    template<std::ranges::input_range __R>
    consteval info reflect_constant_string(__R&& __r);

    template<std::ranges::input_range __R>
    consteval info reflect_constant_array(__R&& __r);

    consteval bool is_public(info);
    consteval bool is_protected(info);
    consteval bool is_private(info);

    consteval bool is_virtual(info);
    consteval bool is_pure_virtual(info);
    consteval bool is_override(info);
    consteval bool is_final(info);

    consteval bool is_deleted(info);
    consteval bool is_defaulted(info);
    consteval bool is_user_provided(info);
    consteval bool is_user_declared(info);
    consteval bool is_explicit(info);
    consteval bool is_noexcept(info);

    consteval bool is_bit_field(info);
    consteval bool is_enumerator(info);
    consteval bool is_annotation(info);

    consteval bool is_const(info);
    consteval bool is_volatile(info);
    consteval bool is_mutable_member(info);
    consteval bool is_lvalue_reference_qualified(info);
    consteval bool is_rvalue_reference_qualified(info);

    consteval bool has_static_storage_duration(info);
    consteval bool has_thread_storage_duration(info);
    consteval bool has_automatic_storage_duration(info);

    consteval bool has_internal_linkage(info);
    consteval bool has_module_linkage(info);
    consteval bool has_external_linkage(info);
    consteval bool has_c_language_linkage(info);
    consteval bool has_linkage(info);

    consteval bool is_complete_type(info);
    consteval bool is_enumerable_type(info);

    consteval bool is_variable(info);
    consteval bool is_type(info);
    consteval bool is_namespace(info);
    consteval bool is_type_alias(info);
    consteval bool is_namespace_alias(info);

    consteval bool is_function(info);
    consteval bool is_conversion_function(info);
    consteval bool is_operator_function(info);
    consteval bool is_literal_operator(info);
    consteval bool is_special_member_function(info);
    consteval bool is_constructor(info);
    consteval bool is_default_constructor(info);
    consteval bool is_copy_constructor(info);
    consteval bool is_move_constructor(info);
    consteval bool is_assignment(info);
    consteval bool is_copy_assignment(info);
    consteval bool is_move_assignment(info);
    consteval bool is_destructor(info);

    consteval bool is_function_parameter(info);
    consteval bool is_explicit_object_parameter(info);
    consteval bool has_default_argument(info);
    consteval bool is_vararg_function(info);

    consteval bool is_template(info);
    consteval bool is_function_template(info);
    consteval bool is_variable_template(info);
    consteval bool is_class_template(info);
    consteval bool is_alias_template(info);
    consteval bool is_conversion_function_template(info);
    consteval bool is_operator_function_template(info);
    consteval bool is_literal_operator_template(info);
    consteval bool is_constructor_template(info);
    consteval bool is_concept(info);

    consteval bool is_value(info);
    consteval bool is_object(info);

    consteval bool is_structured_binding(info);

    consteval bool is_class_member(info);
    consteval bool is_namespace_member(info);
    consteval bool is_nonstatic_data_member(info);
    consteval bool is_static_member(info);
    consteval bool is_base(info);

    consteval bool has_default_member_initializer(info);

    consteval bool has_parent(info);

    consteval bool has_template_arguments(info);

    consteval std::vector<info> template_arguments_of(info r);

    consteval info template_of(info);

    consteval info type_of(info);

    consteval info variable_of(info);

    consteval info return_type_of(info);

    consteval info parent_of(info);

    consteval info dealias(info);

    consteval std::size_t size_of(info entity);

    struct member_offset {
      std::ptrdiff_t bytes;
      std::ptrdiff_t bits;
      constexpr std::ptrdiff_t total_bits() const {
        return bytes * CHAR_BIT + bits;
      }
      auto operator<=>(member_offset const &) const = default;
    };

    consteval member_offset offset_of(info entity);

    consteval std::size_t bit_size_of(info entity);

    consteval std::size_t alignment_of(info entity);


    enum class operators {
      op_new = 1,
      op_delete,
      op_array_new,
      op_array_delete,
      op_co_await,
      op_parentheses,
      op_square_brackets,
      op_arrow,
      op_arrow_star,
      op_tilde,
      op_exclamation,
      op_plus,
      op_minus,
      op_star,
      op_slash,
      op_percent,
      op_caret,
      op_ampersand,
      op_equals,
      op_pipe,
      op_plus_equals,
      op_minus_equals,
      op_star_equals,
      op_slash_equals,
      op_percent_equals,
      op_caret_equals,
      op_ampersand_equals,
      op_pipe_equals,
      op_equals_equals,
      op_exclamation_equals,
      op_less,
      op_greater,
      op_less_equals,
      op_greater_equals,
      op_spaceship,
      op_ampersand_ampersand,
      op_pipe_pipe,
      op_less_less,
      op_greater_greater,
      op_less_less_equals,
      op_greater_greater_equals,
      op_plus_plus,
      op_minus_minus,
      op_comma
    };
    using enum operators;

    consteval operators operator_of(info);
    consteval std::string_view symbol_of(operators);
    consteval std::u8string_view u8symbol_of(operators);

    struct data_member_options {
      /* The name of a described data member, held either as a u8string or as a
         narrow string; __is_u8 says which.  The front end reads the engaged
         string in place, so the declaration order of the members below is
         significant. */
      struct __name {
        template<class __T>
          requires std::constructible_from<std::u8string, __T>
          consteval __name(__T&& __n) : __is_u8(true), __u8s((__T&&) __n) {}

        template<class __T>
          requires std::constructible_from<std::string, __T>
          consteval __name(__T&& __n) : __is_u8(false), __s((__T&&) __n) {}

      private:
        bool __is_u8;
        std::u8string __u8s;
        std::string __s;
        info __unused = {};
      };

      std::optional<__name> name;
      std::optional<int>    alignment = {};
      std::optional<int>    bit_width = {};
      bool                  no_unique_address = false;
      std::vector<info>     annotations = {};
    };

    consteval info data_member_spec(info, data_member_options = {});

    consteval bool is_data_member_spec(info);

    template<reflection_range __R = initializer_list<info>>
      consteval info define_aggregate(info __type, __R&& __mdescrs);

    template<reflection_range __R = initializer_list<info>>
      consteval info reflect_invoke(info __r, __R&& __args);

    consteval bool is_token_sequence(info);

    consteval bool is_empty_token_sequence(info);

    consteval info nearest_token_queuing_context();

    consteval info nearest_class_or_namespace();

    consteval info nearest_namespace();

    consteval void __report_tokens(info  tokens);

#ifdef __EDG_INJECTION_ENABLED__
    /* Accumulates a token sequence in which the pieces added with += are
       separated by the given separator, a comma by default.  The default is
       supplied by a second constructor rather than by a default argument
       because a token-sequence default argument is not yet parsed correctly
       (its deferred parse disturbs the token sequences in the member function
       bodies that follow).  Writing the token sequences below requires token
       injection to be enabled. */
    struct list_builder {
      consteval list_builder() {}
      consteval list_builder(info separator): separator(separator) {}
      consteval operator info() const { return this->tokens; }
      consteval void operator+=(info  next_tokens) {
        if (is_empty_token_sequence(next_tokens)) {
          /* Do nothing. */
        } else if (first) {
          this->tokens = next_tokens;
          first = false;
        } else {
          this->tokens = ^^{ \{this->tokens}
                             \{separator}
                             \{next_tokens} };
        }  /* if */
      }
    private:
      bool first = true;
      info tokens = ^^{}, separator = ^^{,};
    };
#endif /* __EDG_INJECTION_ENABLED__ */

    consteval void queue_injection(info, info);

    consteval void queue_injection(info  tokens) {
      queue_injection(nearest_token_queuing_context(), tokens);
    }

    consteval void namespace_inject(info, info);

    consteval void namespace_inject(info  tokens) {
      namespace_inject(nearest_namespace(), tokens);
    }


    consteval std::vector<info> annotations_of(info r);

    consteval std::vector<info> annotations_of_with_type(info r, info type);

    /* Reaching this (deliberately non-constexpr) function during constant
       evaluation makes the caller a non-constant expression.  Reflection
       precondition violations are currently reported this way -- by failing
       constant evaluation rather than by throwing an exception (because
       constant-evaluation of exceptions is not implemented yet). */
    inline void __meta_precondition_violation(const char *) {}

    template<typename T>
    consteval std::optional<T> annotation_of_type(info r) {
      auto v = annotations_of_with_type(r, ^^T);
      std::optional<T> result{};
      for (info a: v) {
        if (result.has_value()) {
          if (extract<T>(a) != result) {
            __meta_precondition_violation("inconsistent annotations");
          }
        } else {
          result = extract<T>(a);
        }
      }
      return result;
    }

    /* Type traits. */

    consteval bool is_void_type(info);

    consteval bool is_null_pointer_type(info);

    consteval bool is_integral_type(info);

    consteval bool is_floating_point_type(info);

    consteval bool is_array_type(info);

    consteval bool is_pointer_type(info);

    consteval bool is_lvalue_reference_type(info);

    consteval bool is_rvalue_reference_type(info);

    consteval bool is_member_object_pointer_type(info);

    consteval bool is_member_function_pointer_type(info);

    consteval bool is_enum_type(info);

    consteval bool is_union_type(info);

    consteval bool is_class_type(info);

    consteval bool is_function_type(info);

    consteval bool is_reflection_type(info);

    consteval bool is_reference_type(info);

    consteval bool is_arithmetic_type(info);

    consteval bool is_fundamental_type(info);

    consteval bool is_object_type(info);

    consteval bool is_scalar_type(info);

    consteval bool is_compound_type(info);

    consteval bool is_member_pointer_type(info);

    consteval bool is_const_type(info);

    consteval bool is_volatile_type(info);

    consteval bool is_trivially_copyable_type(info);

    consteval bool is_standard_layout_type(info);

    consteval bool is_empty_type(info);

    consteval bool is_polymorphic_type(info);

    consteval bool is_abstract_type(info);

    consteval bool is_final_type(info);

    consteval bool is_aggregate_type(info);

    consteval bool is_signed_type(info);

    consteval bool is_unsigned_type(info);

    consteval bool is_bounded_array_type(info);

    consteval bool is_unbounded_array_type(info);

    consteval bool is_scoped_enum_type(info);

    consteval info remove_const(info);

    consteval info remove_volatile(info);

    consteval info remove_cv(info);

    consteval info add_const(info);

    consteval info add_volatile(info);

    consteval info add_cv(info);

    consteval info remove_reference(info);

    consteval info add_lvalue_reference(info);

    consteval info add_rvalue_reference(info);

    consteval info make_signed(info);

    consteval info make_unsigned(info);

    consteval info remove_extent(info);

    consteval info remove_all_extents(info);

    consteval info remove_pointer(info);

    consteval info add_pointer(info);

    consteval info decay(info);

    consteval info underlying_type(info);

    consteval std::size_t tuple_size(info);

    consteval info tuple_element(std::size_t, info);

    /* N5046 [meta.reflection.traits] additional type-property predicates,
       type-relation predicates, rank/extent, unwrap_reference and
       unwrap_ref_decay, and the variant queries.  The constructible,
       assignable, and destructible predicates below are the non-variadic
       forms; the variadic is_constructible_type family appears earlier. */
    consteval bool is_structural_type(info);

    consteval bool is_default_constructible_type(info);
    consteval bool is_copy_constructible_type(info);
    consteval bool is_move_constructible_type(info);

    consteval bool is_assignable_type(info, info);
    consteval bool is_copy_assignable_type(info);
    consteval bool is_move_assignable_type(info);

    consteval bool is_destructible_type(info);

    consteval bool is_trivially_default_constructible_type(info);
    consteval bool is_trivially_copy_constructible_type(info);
    consteval bool is_trivially_move_constructible_type(info);

    consteval bool is_trivially_assignable_type(info, info);
    consteval bool is_trivially_copy_assignable_type(info);
    consteval bool is_trivially_move_assignable_type(info);
    consteval bool is_trivially_destructible_type(info);

    consteval bool is_nothrow_default_constructible_type(info);
    consteval bool is_nothrow_copy_constructible_type(info);
    consteval bool is_nothrow_move_constructible_type(info);

    consteval bool is_nothrow_assignable_type(info, info);
    consteval bool is_nothrow_copy_assignable_type(info);
    consteval bool is_nothrow_move_assignable_type(info);
    consteval bool is_nothrow_destructible_type(info);

    consteval bool is_implicit_lifetime_type(info);

    consteval std::strong_ordering type_order(info, info);

    consteval bool is_swappable_type(info);
    consteval bool is_nothrow_swappable_type(info);
    consteval bool is_swappable_with_type(info, info);
    consteval bool is_nothrow_swappable_with_type(info, info);

    consteval bool has_virtual_destructor(info);
    consteval bool has_unique_object_representations(info);

    consteval bool reference_constructs_from_temporary(info, info);
    consteval bool reference_converts_from_temporary(info, info);

    consteval std::size_t rank(info);
    consteval std::size_t extent(info, unsigned = 0);

    consteval bool is_base_of_type(info, info);
    consteval bool is_virtual_base_of_type(info, info);
    consteval bool is_convertible_type(info, info);
    consteval bool is_nothrow_convertible_type(info, info);
    consteval bool is_layout_compatible_type(info, info);
    consteval bool is_pointer_interconvertible_base_of_type(info, info);

    consteval info unwrap_reference(info);
    consteval info unwrap_ref_decay(info);

    consteval std::size_t variant_size(info);
    consteval info variant_alternative(std::size_t, info);

    /* Alternatives to P1306 expansion statements.
       Example usage:
          expand_over([] consteval {
                        return nonstatic_data_members_of(
                                            ^^S, access_context::unchecked());
                      },
                      []<std::meta::info r> {
                        printf("%s\n", identifier_of(r).data());
                      });
       and
          [:expand(nonstatic_data_members_of(^^S,
                                             access_context::unchecked())):] >>
          []<auto r> {
            printf("%s\n", identifier_of(r).data());
          };
    */
    namespace __impl {
      template<typename F, auto ... vals>
      constexpr void expander(F f) {
        (f.template operator()<vals>(), ...);
      }

      template<typename F, typename R>
      consteval std::meta::info substitute_expander(R make_range) {
        auto vals = make_range();
        std::vector<info> args{ ^^F };
        for (auto val : vals) {
          args.push_back(std::meta::reflect_constant(val));
        }
        return substitute(^^expander, args);
      }
    }  // namespace __impl

    template<typename F, typename R>
    constexpr void expand_over(R make_range, F body = {}) {
      [:__impl::substitute_expander<F>(make_range):](body);
    }

    namespace __impl {
      template<auto ... vals>
      struct replicator_type {
        template<typename F>
          constexpr void operator>>(F body) const {
            (body.template operator()<vals>(), ...);
          }
      };
      template<auto ... vals>
      replicator_type<vals...> replicator = {};
    }  // namespace __impl

    template<typename R>
    consteval auto const expand(R range) {
      std::vector<std::meta::info> args;
      for (auto r: range) args.push_back(reflect_constant(r));
      return substitute(^^__impl::replicator, args);
    }
  }  /* namespace meta */

  consteval bool is_string_literal(const char*);
  consteval bool is_string_literal(const char8_t*);
  consteval bool is_string_literal(const char16_t*);
  consteval bool is_string_literal(const char32_t*);
  consteval bool is_string_literal(const wchar_t*);

  template<std::ranges::input_range __R>
  consteval const std::ranges::range_value_t<__R>*
  define_static_string(__R&& __r) {
    auto __str = std::meta::reflect_constant_string(__r);
    return std::meta::extract<const std::ranges::range_value_t<__R>*>(__str);
  }

  namespace __detail {
    /* A range whose ranges::size is a constant expression, so that
       define_static_array can preserve a static span extent.  The natural
       detection -- a requires-expression that uses the expression's own
       parameter in a constant expression -- is not accepted by EDG (FIXME),
       so the statically-sized forms are detected structurally instead:
       bounded arrays and tuple-size ranges (std::array, fixed-extent
       std::span). */
    template<typename __R>
    concept __statically_sized
      = std::is_bounded_array_v<std::remove_cvref_t<__R>>
        || requires { std::tuple_size<std::remove_cvref_t<__R>>::value; };

    /* The static size of a __statically_sized range, taken from the type so
       that it is a constant expression. */
    template<typename __R,
             bool = std::is_bounded_array_v<std::remove_cvref_t<__R>>>
    struct __static_size {
      static constexpr std::size_t value =
                            std::tuple_size_v<std::remove_cvref_t<__R>>;
    };
    template<typename __R>
    struct __static_size<__R, true> {
      static constexpr std::size_t value =
                            std::extent_v<std::remove_cvref_t<__R>>;
    };
  }  /* namespace __detail */

  template<std::ranges::input_range __R>
  consteval auto define_static_array(__R&& __r) {
    using __T = std::ranges::range_value_t<__R>;
    auto __array = std::meta::reflect_constant_array(__r);
    auto __type = std::meta::type_of(__array);
    if constexpr (__detail::__statically_sized<__R>) {
      constexpr std::size_t __extent = __detail::__static_size<__R>::value;
      if constexpr (__extent)
        return std::span<const __T, __extent>(
                                  std::meta::extract<const __T*>(__array),
                                  std::meta::extent(__type, 0U));
      else
        return std::span<const __T, 0>();
    } else {
      if (std::meta::is_array_type(__type))
        return std::span<const __T>(std::meta::extract<const __T*>(__array),
                                    std::meta::extent(__type, 0U));
      else
        return std::span<const __T>();
    }
  }

  template<class __T>
  consteval const std::remove_cvref_t<__T>* define_static_object(__T&& __t) {
    using __U = std::remove_cvref_t<__T>;
    if constexpr (std::meta::is_class_type(^^__U) ||
                  std::meta::is_union_type(^^__U)) {
      auto __cst = std::meta::reflect_constant(std::forward<__T>(__t));
      return std::addressof(std::meta::extract<const __U&>(__cst));
    } else if constexpr (std::meta::is_array_type(^^__U)) {
      auto __cst = std::meta::reflect_constant_array(std::forward<__T>(__t));
      return std::addressof(std::meta::extract<const __U&>(__cst));
    } else {
      return std::define_static_array(
                            std::span(std::addressof(__t), 1)).data();
    }
  }
}


#endif  /* ifndef __META_STDH */

