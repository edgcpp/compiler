# CI-only (linux-gcc-variants): build-time choices no published configuration
# makes, for code coverage.  Most of them should leave test output unchanged.
# --- IL file format and IL contents (source-analysis tooling)
ALTERNATE_IL_FILE_FORMAT=0
IL_FILE_SUFFIX=".edgil"
LARGE_IL_FILE_SUPPORT=1
RECORD_MACROS_IN_IL=1
ALL_TEMPLATE_INFO_IN_IL=0
MAINTAIN_CLASS_MEMBER_LIST=1
PARENS_IN_IL=0
GENERATE_SOURCE_SEQUENCE_LISTS=1
ALLOW_SOURCE_SEQUENCE_LISTS_WITH_IL_LOWERING=1
RECORD_HIDDEN_NAMES_IN_IL=1
ALLOW_HIDDEN_NAMES_IN_IL_WITH_IL_LOWERING=1
# --- C back end lowering variant (cpfe only)
LOWERING_NORMALIZES_BOOLEAN_CONTROLLING_EXPRESSIONS=DO_IL_LOWERING
# --- extensions
GNU_NAKED_ATTRIBUTE_ALLOWED=1
NUM_BITS_FOR_NAMED_ADDRESS_SPACE=4
# --- memory manager variant: fixed-address mmap, copy-mode module reads, multi-file cpfe-cp
USE_FIXED_ADDRESS_FOR_MMAP=USE_MMAP_FOR_MEMORY_REGIONS
FIXED_ADDRESS_FOR_MMAP=0x25000000
USE_MMAP_FOR_MODULES=0
COMPILE_MULTIPLE_SOURCE_FILES=BACK_END_IS_CP_GEN_BE
# --- 128-bit host integers with fixed point on
INTEGER_VALUE_REPR_IS_A_HOST_INTEGER=1
TYPE_FOR_AN_INTEGER_VALUE=__uint128_t
TYPE_FOR_A_SIGNED_INTEGER_VALUE=__int128_t
HOST_ALIGNMENT_REQUIRED=16
BITS_IN_AN_INTEGER_VALUE=128
TYPE_FOR_A_FIXED_POINT_VALUE=__uint128_t
MAX_SIZEOF_LARGEST_FIXED_POINT=16
TYPE_FOR_TARG_ALIGNMENT=uint32_t
ALLOW_HOST_FP_TOO_SMALL_FOR_LARGEST_FIXED_POINT_TYPE=1
MAX_INTEGER_VALUE=((__int128_t)(~(__uint128_t)0>>1))
MIN_INTEGER_VALUE=(-MAX_INTEGER_VALUE-1)
MAX_UNSIGNED_INTEGER_VALUE=(~(__uint128_t)0)
# --- host floating point: long double (instead of __float128)
USE_LONG_DOUBLE_FOR_HOST_FP_VALUE=1
USE_FLOAT128_FOR_HOST_FP_VALUE=0
USE_QUADMATH_LIBRARY=0
FLOAT128_ENABLING_POSSIBLE=0
