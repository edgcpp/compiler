# Import the base EDG configuration
import <support/platform/common/base>

# Common MacOS Variables
USE_EDG_NAMESPACE=1
GNU_EXTENSIONS_ALLOWED=1
GNU_VECTOR_TYPES_ALLOWED=1
GNU_INIT_PRIORITY_ATTRIBUTE_ALLOWED=1
GNU_VISIBILITY_ATTRIBUTE_ALLOWED=1
COROUTINE_ENABLING_POSSIBLE=1
C99_IL_EXTENSIONS_SUPPORTED=1
IA64_ABI=1

TARG_MINIMUM_PACK_ALIGNMENT=1
TARG_MAXIMUM_PACK_ALIGNMENT=32768
TYPE_FOR_TARG_ALIGNMENT=unsigned short

# The jump buffer type on MacOS is always an integer.
TARG_JMP_BUF_ELEMENT_INT_KIND=((an_integer_kind)ik_int)
