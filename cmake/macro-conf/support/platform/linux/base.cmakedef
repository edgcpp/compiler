# Import the base EDG configuration
import <support/platform/common/base>

# Common Linux Variables
__ANSIC__=1
TARG_JMP_BUF_ELEMENTS_ARE_FLOAT=0
TARG_SETJMP_FUNC="_setjmp"

# Allow embedded C.
EMBEDDED_C_ALLOWED=1
DEFAULT_EMBEDDED_C_ENABLED=0

# Allow fixed point.
FIXED_POINT_ALLOWED=1

# wint_t has a different signedness from wchar_t with both 32-bit and 64-bit
# Linux.
TARG_WINT_T_INT_KIND=((an_integer_kind)ik_unsigned_int)

MAKE_ALL_FUNCTIONS_UNPROTOTYPED=0
DESIGNATED_INITIALIZER_ENABLING_POSSIBLE=1
RUNTIME_USES_NAMESPACES=1
BUILTIN_VA_LIST_OVERRIDE_TYPE_NAME="__gnuc_va_list"
DEFAULT_PASS_STDARG_REFERENCES_TO_GENERATED_CODE=1
TARG_EXTERNAL_NAMES_GET_UNDERSCORE_ADDED=0
IGNORE_CARRIAGE_RETURN_IN_SOURCE=1
GNU_EXTENSIONS_ALLOWED=1
GNU_FUNCTION_MULTIVERSIONING=1
GNU_INIT_PRIORITY_ATTRIBUTE_ALLOWED=1
GNU_VISIBILITY_ATTRIBUTE_ALLOWED=1
RECORD_RAW_ASM_OPERAND_DESCRIPTIONS=0
DEFAULT_GNU_COMPATIBILITY=0

# Configure bitfield allocation to match GCC
TARG_BIT_FIELD_CONTAINER_SIZE=(-1)
ALLOW_NON_INT_BIT_FIELD_BASE_TYPE_IN_GENERATED_C=1
TARG_PLAIN_INT_BIT_FIELD_IS_UNSIGNED=0
TARG_NONNEGATIVE_ENUM_BIT_FIELD_IS_UNSIGNED=1

LONG_LONG_ALLOWED=1
# FIXME: We may want to change this.
INTEGER_VALUE_REPR_IS_A_HOST_INTEGER=0
TYPE_FOR_AN_INTEGER_VALUE=unsigned long long
TYPE_FOR_A_SIGNED_INTEGER_VALUE=long long
FP_LONG_DOUBLE_IS_80BIT_EXTENDED=1
LINKER_CAN_DISCARD_DUPLICATE_DEFINITIONS=1

USE_HOST_FP_CONVERSION_ROUTINES=0
INSTANTIATE_EXTERN_INLINE=0
TYPE_FOR_TARG_ALIGNMENT=unsigned short
TARG_MAXIMUM_PACK_ALIGNMENT=32768
ALLOW_CPPCLI_WITH_LOWERING
EDG_TEST_VERSION
IA64_ABI=1
HANDLE_VIRTUAL_BASES_IN_COMPLETE_CTOR_DTORS=1
HANDLE_VIRTUAL_BASES_IN_SUBOBJECT_CTOR_DTORS=1
GNU_VECTOR_TYPES_ALLOWED=1
RISCV_VECTOR_BUILTINS_ENABLED=1
ASSUME_THIS_CANNOT_BE_NULL_IN_CONDITIONAL_OPERATORS=0
TYPE_FOR_A_FIXED_POINT_VALUE=an_integer_value
UNICODE_SOURCE_SUPPORTED=1
FREE_MEMORY_REGIONS_EARLY=1
KEEP_OBJECT_LIFETIME_INFO_IN_LOWERED_IL_WHEN_EH_ENABLED=1
COROUTINE_ENABLING_POSSIBLE=1
ONLY_MANGLE_TYPES_NEEDED_FOR_EXTERNAL_NAMES=0
CPPCLI_PORTABLE_ASSEMBLY_PATH="@CMAKE_SOURCE_DIR@/ms_assemblies"

# Tie the GNU ABI version to the GNU version in the IA-64 test version.
TIE_DEFAULT_GNU_ABI_VERSION_TO_GNU_VERSION=1
MIN_GNU_VERSION=30200

# GNU Header Compatibility
FLOAT128_ENABLING_POSSIBLE=1
USE_FLOAT128_FOR_HOST_FP_VALUE=1
THREAD_LOCAL_STORAGE_SPECIFIER_ALLOWED=1
