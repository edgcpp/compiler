import argparse
import contextlib
import io
import os
import re
import sys
import tempfile

import edgcppgen
import edgifc
import edgutil

from enum import IntEnum

def print_warn(message: str) -> None:
  edgutil.eprint(f"WARNING: {message}")

class ChangeClassification(IntEnum):
  NONE           = 1
  INTERPRETATION = 2
  LAYOUT         = 3

def merge_classification(old_classification, new_classification):
  if new_classification > old_classification:
    return new_classification
  return old_classification

class ChangeDetector:
  def __init__(self, old_registry, new_registry):
    self.old_registry = old_registry
    self.new_registry = new_registry

    self._type_changes = {}

  def _get_change_classification(self, type_name):
    if type_name not in self._type_changes:
      self._type_changes[type_name] = self._compute_type_changes(type_name)
    return self._type_changes[type_name]

  def _have_tacit_fields_changed(self, old_fields, new_fields):
    '''Check for changes in the "tacit fields" of the node. This includes
    only interpretation changes. Return True if any interpretation changes are
    found, False otherwise.
    '''
    new_field_count = len(new_fields)
    if len(old_fields) != new_field_count:
      return True

    # Sort by name as there's no layout order to preserve (name matches and
    # return values are what matter).
    old_fields = sorted(old_fields, key = lambda f: f.name())
    new_fields = sorted(new_fields, key = lambda f: f.name())

    for i in range(new_field_count):
      old_field = old_fields[i]
      new_field = new_fields[i]

      old_field_name = old_field.name()
      new_field_name = new_field.name()

      if old_field_name != new_field_name:
        # We have the same number of tacit fields but one has been replaced.
        return True

      old_field_type_name = old_field.type_name()
      new_field_type_name = new_field.type_name()

      if old_field_type_name != new_field_type_name:
        # The result types no longer match.
        return True

      # Proxies are not compared as they're part of accessor generation not
      # part of the conceptual "type", and all versions are walked for accessor
      # generation.

    return False

  def _compute_field_changes(self, old_fields, new_fields):
    '''Check for changes in the "true fields" of the node. This includes both
    interpretation and layout changes.
    '''
    change = ChangeClassification.NONE

    new_field_count = len(new_fields)
    if len(old_fields) != new_field_count:
      return ChangeClassification.LAYOUT

    for i in range(new_field_count):
      old_field = old_fields[i]
      new_field = new_fields[i]

      old_field_name = old_field.name()
      new_field_name = new_field.name()

      try:
        if old_field_name != new_field_name:
          change = merge_classification(
            change,
            ChangeClassification.INTERPRETATION
          )

        old_field_type_name = old_field.type_name()
        new_field_type_name = new_field.type_name()

        try:
          if old_field_type_name == new_field_type_name:
            # The fields have the same type, check to see if that type
            # changed.
            field_change = self._get_change_classification(new_field_type_name)
            if field_change == ChangeClassification.LAYOUT:
              return ChangeClassification.LAYOUT
            change = merge_classification(change, field_change)
          else:
            old_field_type = self.old_registry.get_type(old_field_type_name)
            new_field_type = self.new_registry.get_type(new_field_type_name)

            # If the fields are equivalently sized, this is a change in
            # interpretation only, the layout is the same.
            if old_field_type.size() != new_field_type.size():
              return ChangeClassification.LAYOUT

            change = merge_classification(
              change,
              ChangeClassification.INTERPRETATION
            )
        except Exception as e:
          e.add_note(
            f"while comparing old field type \"{old_field_type_name}\" "
            f"and new field type \"{new_field_type_name}\""
          )
          raise
      except Exception as e:
        e.add_note(
          f"while comparing old field \"{old_field_name}\" "
          f"with new field \"{new_field_name}\""
        )
        raise

    return change

  def _compute_node_changes(self, old_type, new_type):
    '''Nodes are more complicated to detect changes than other types. As
    they're effectively byte arrays with typed fields, the change detector
    needs to look for the "most serious" change (a layout change) within the
    field information.
    '''
    old_fields = old_type.fields()
    new_fields = new_type.fields()

    change = self._compute_field_changes(old_fields, new_fields)

    # If there hasn't been any change, check for changes to the interpretation
    # resulting from changes in tacit fields.
    if change == ChangeClassification.NONE:
      old_tacit_fields = old_type.tacit_fields()
      new_tacit_fields = new_type.tacit_fields()

      if self._have_tacit_fields_changed(
          old_tacit_fields,
          new_tacit_fields
      ):
        return ChangeClassification.INTERPRETATION

    return change

  def _compute_simple_sort_changes(self, type_name):
    old_reg = self.old_registry.get_simple_sort_registration_by_type(type_name)
    new_reg = self.new_registry.get_simple_sort_registration_by_type(type_name)

    if old_reg != new_reg:
      return ChangeClassification.INTERPRETATION
    return ChangeClassification.NONE

  def _compute_index_sort_changes(self, type_name):
    old_reg = self.old_registry.get_index_sort_registration_by_type(type_name)
    new_reg = self.new_registry.get_index_sort_registration_by_type(type_name)

    old_sort_type_name = old_reg.sort_type_name
    new_sort_type_name = new_reg.sort_type_name

    assert old_sort_type_name == new_sort_type_name

    sort_classification = self._get_change_classification(old_sort_type_name)
    if sort_classification != ChangeClassification.NONE:
      return sort_classification

    if old_reg.bitshift != new_reg.bitshift:
      return ChangeClassification.INTERPRETATION

    if old_reg.non_null != new_reg.non_null:
      return ChangeClassification.INTERPRETATION

    return ChangeClassification.NONE

  def _compute_bitfield_changes(self, type_name):
    old_reg = self.old_registry.get_bitfield_registration_by_type(type_name)
    new_reg = self.new_registry.get_bitfield_registration_by_type(type_name)

    if old_reg != new_reg:
      return ChangeClassification.INTERPRETATION
    return ChangeClassification.NONE

  def _compute_value_category_changes(self, type_name):
    old_reg = self.old_registry.get_value_category_registration_by_type(
      type_name
    )
    new_reg = self.new_registry.get_value_category_registration_by_type(
      type_name
    )

    if old_reg.bitmask != new_reg.bitmask:
      return ChangeClassification.INTERPRETATION
    if old_reg.bitshift != new_reg.bitshift:
      return ChangeClassification.INTERPRETATION

    # The discriminating sort cannot change.
    assert old_reg.discriminating_sort == new_reg.discriminating_sort
    sort_type_name = f"{old_reg.discriminating_sort}Sort"
    sort_change = self._get_change_classification(sort_type_name)
    if sort_change != ChangeClassification.NONE:
      return ChangeClassification.INTERPRETATION

    old_resolved_categories = old_reg.resolved_category_dict
    for sort_label, (type_name, _) in new_reg.resolved_category_dict.items():
      # The sort must always map to the same type.
      assert old_resolved_categories[sort_label][0] == type_name
      # Check for interpretation changes in the represented value.
      subsort_change = self._get_change_classification(type_name)
      if subsort_change != ChangeClassification.NONE:
        return ChangeClassification.INTERPRETATION
    return ChangeClassification.NONE

  def _compute_node_offset_changes(self, type_name):
    old_reg = self.old_registry.get_node_offset_registration_by_type(type_name)
    new_reg = self.new_registry.get_node_offset_registration_by_type(type_name)

    if old_reg.non_null != new_reg.non_null:
      return ChangeClassification.INTERPRETATION
    return ChangeClassification.NONE

  def _compute_type_changes(self, type_name):
    '''This method shouldn't be called directly, prefer
    _get_change_classification (which caches results).
    '''
    if not self.old_registry.has_type(type_name):
      return ChangeClassification.LAYOUT

    if not self.new_registry.has_type(type_name):
      return ChangeClassification.LAYOUT

    old_type = self.old_registry.get_type(type_name)
    new_type = self.new_registry.get_type(type_name)

    if old_type.size() != new_type.size():
      return ChangeClassification.LAYOUT

    old_type_role = self.old_registry.get_type_role(type_name)
    new_type_role = self.old_registry.get_type_role(type_name)

    assert old_type_role == new_type_role

    if edgifc.is_node_role(new_type_role):
      return self._compute_node_changes(old_type, new_type)
    if new_type_role == edgifc.IFCRegistryTypeRole.SIMPLE_SORT:
      return self._compute_simple_sort_changes(type_name)
    if new_type_role == edgifc.IFCRegistryTypeRole.INDEX_SORT:
      return self._compute_index_sort_changes(type_name)
    if new_type_role == edgifc.IFCRegistryTypeRole.BITFIELD:
      return self._compute_bitfield_changes(type_name)
    if new_type_role == edgifc.IFCRegistryTypeRole.VALUE_CATEGORY:
      return self._compute_value_category_changes(type_name)
    # These roles are all represented as unintelligible byte/numeric values.
    # There's not really a "change" to detect in their interpretation because
    # the value's interpretation is unknown.
    if (new_type_role == edgifc.IFCRegistryTypeRole.RAW_BYTES or
        new_type_role == edgifc.IFCRegistryTypeRole.RAW_NUMERIC or
        new_type_role == edgifc.IFCRegistryTypeRole.FOREIGN_INDEX):
      return ChangeClassification.NONE

    if new_type_role == edgifc.IFCRegistryTypeRole.NODE_OFFSET:
      return self._compute_node_offset_changes(type_name)

    # String table offsets are a special case of an index which are simply
    # references into the string table; there's nothing that can change here.
    if new_type_role == edgifc.IFCRegistryTypeRole.STRING_TABLE_OFFSET:
      return ChangeClassification.NONE

    print_warn(f"The type named {type_name} has an unknown role.")
    return ChangeClassification.NONE

  def _compute_all_type_changes(self):
    for type_name in self.new_registry.get_all_type_names():
      self._get_change_classification(type_name)

  def walk(self):
    self._compute_all_type_changes()

  def _get_list_of_changed(self, changed_map):
    changed_list = []
    for type_name, classification in changed_map.items():
      if classification != ChangeClassification.NONE:
        changed_list.append((type_name, classification))
    return changed_list

  def get_changed_type_names(self):
    return self._get_list_of_changed(self._type_changes)

class RevisionInfo:
  def __init__(self):
    self._revision_mapping = {}
    self._layout_revision_mapping = {}
    self._role_to_types = {}
    for role in edgifc.IFCRegistryTypeRole:
      self._role_to_types[role] = []
    self._type_to_role = {}

  def get_type_versions(self, type_name):
    return self._revision_mapping[type_name]

  def get_type_layout_versions(self, type_name):
    return self._layout_revision_mapping[type_name]

  def get_type_role(self, type_name):
    return self._type_to_role[type_name]

  def get_revision_at_version(self, type_name, target_version):
    best_match = None
    for version in self._revision_mapping[type_name]:
      if version <= target_version:
        best_match = version
    return best_match

  def get_types_by_role(self, role):
    return self._role_to_types[role]

  def is_type_initialized(self, type_name):
    return type_name in self._revision_mapping

  def init_type_recording(self, type_name, version, role):
    self._revision_mapping[type_name] = [version]
    self._layout_revision_mapping[type_name] = [version]
    self._role_to_types[role].append(type_name)
    self._type_to_role[type_name] = role

  def record_type_update(self, type_name, version, classification):
    self._revision_mapping[type_name].append(version)
    if classification == ChangeClassification.LAYOUT:
      self._layout_revision_mapping[type_name].append(version)

INITIAL_VERSION = edgifc.SUPPORTED_VERSIONS[0]

def generate_revision_information(version_to_registry):
  prev_version = INITIAL_VERSION
  prev_registry = version_to_registry[INITIAL_VERSION]

  revision_info = RevisionInfo()
  for type_name in prev_registry.get_all_type_names():
    role = prev_registry.get_type_role(type_name)
    revision_info.init_type_recording(type_name, INITIAL_VERSION, role)

  for version in edgifc.SUPPORTED_VERSIONS[1:]:
    registry = version_to_registry[version]

    try:
      change_detector = ChangeDetector(prev_registry, registry)
      change_detector.walk()

      changed_type_names = change_detector.get_changed_type_names()
      for type_name, classification in changed_type_names:
        if revision_info.is_type_initialized(type_name):
          revision_info.record_type_update(type_name, version, classification)
        else:
          role = registry.get_type_role(type_name)
          revision_info.init_type_recording(type_name, version, role)
    except Exception as e:
      e.add_note(
        f"while comparing registry version {prev_version} "
        f"with version {version}"
      )
      raise

    prev_version = version
    prev_registry = registry

  return revision_info

def is_numericly_represented_role(role):
  if role == edgifc.IFCRegistryTypeRole.BITFIELD:
    return True
  if role == edgifc.IFCRegistryTypeRole.RAW_NUMERIC:
    return True
  if role == edgifc.IFCRegistryTypeRole.FOREIGN_INDEX:
    return True
  if role == edgifc.IFCRegistryTypeRole.STRING_TABLE_OFFSET:
    return True
  return False

def is_byte_copied_field_role(role):
  '''Return TRUE if the given role represents a type that is expected to be
  copied from its storage as part of a node into a (possibly larger) byte
  buffer, in the same order.

  Otherwise, assume the type is byte buffer.
  '''
  if edgifc.is_node_role(role):
    return True
  if role == edgifc.IFCRegistryTypeRole.RAW_BYTES:
    return True
  return False

class AggregateTypeInfoCache:
  def __init__(self, version_to_registry, revision_info):
    self._sort_type_name_to_values = self._aggregate_sort_values(
      version_to_registry,
      revision_info
    )
    self._type_name_to_partition = self._aggregate_type_partitions(
      version_to_registry,
      revision_info
    )
    self._partition_to_type_name = {
      value: key for key, value in self._type_name_to_partition.items()
    }
    self._index_type_to_partition_info = self._aggregate_index_partition_info(
      version_to_registry,
      revision_info
    )
    self._index_types_with_partitions = sorted(
      self._index_type_to_partition_info.keys()
    )
    self._node_offset_type_to_partition_info = (
      self._aggregate_node_offset_partition_info(
        version_to_registry,
        revision_info
      )
    )
    self._node_offset_types_with_partitions = sorted(
      self._node_offset_type_to_partition_info.keys()
    )
    self._reference_types_with_partitions = sorted(
      [
        *self._index_types_with_partitions,
        *self._node_offset_types_with_partitions
      ]
    )
    self._node_type_name_to_field_info = self._aggregate_field_info(
      version_to_registry,
      revision_info
    )
    self._field_name_to_node_type_names = (
      self._aggregate_field_name_to_node_types(
        self._node_type_name_to_field_info
      )
    )
    self._field_name_to_type_names = self._aggregate_field_name_to_types(
      self._field_name_to_node_type_names,
      self._node_type_name_to_field_info
    )
    self._type_to_largest_size = self._aggregate_type_size_info(
      version_to_registry,
      revision_info
    )
    self._largest_index_type_size = self._aggregate_largest_index_type_size(
      self._type_to_largest_size,
      revision_info
    )
    self._bitfield_type_to_queries = self._aggregate_bitfield_queries(
      version_to_registry,
      revision_info
    )
    self._category_info = self._aggregate_category_info(
      version_to_registry,
      revision_info
    )

  def _aggregate_sort_values(self, version_to_registry, revision_info):
    simple_sort_type_names = revision_info.get_types_by_role(
      edgifc.IFCRegistryTypeRole.SIMPLE_SORT
    )
    index_sort_type_names = revision_info.get_types_by_role(
      edgifc.IFCRegistryTypeRole.INDEX_SORT
    )

    sort_type_name_to_values = {}
    sort_type_names = [
      *simple_sort_type_names,
      *index_sort_type_names,
    ]
    for sort_type_name in sort_type_names:
      sort_type_values = set()
      for version in revision_info.get_type_versions(sort_type_name):
        registry = version_to_registry[version]
        sort_dict = registry.get_sort_dict_by_type(sort_type_name)
        sort_type_values.update(sort_dict.values())

      sort_type_values = list(sort_type_values)
      sort_type_values.sort()
      sort_type_name_to_values[sort_type_name] = sort_type_values

    return sort_type_name_to_values

  def _aggregate_type_partitions(self, version_to_registry, revision_info):
    partition_node_type_names = revision_info.get_types_by_role(
      edgifc.IFCRegistryTypeRole.PARTITION_NODE
    )

    type_name_to_partition = {}
    for partition_node_type_name in partition_node_type_names:
      for version in revision_info.get_type_versions(partition_node_type_name):
        registry = version_to_registry[version]
        partition = registry.get_partition_for_type_name(
          partition_node_type_name
        )
        if partition_node_type_name in type_name_to_partition:
          assert type_name_to_partition[partition_node_type_name] == partition
        type_name_to_partition[partition_node_type_name] = partition

    return type_name_to_partition

  def _aggregate_index_partition_info(self, version_to_registry,
                                      revision_info):
    index_type_to_partitions = {}

    # Map index sorts (like "Decl"'s) values to their corresponding partition
    # type and name pair (e.g., "DeclScope" -> "DeclScope", "decl.scope").
    index_sort_type_names = revision_info.get_types_by_role(
      edgifc.IFCRegistryTypeRole.INDEX_SORT
    )
    for sort_type_name in index_sort_type_names:
      sort_value_to_partition = {}
      for version in revision_info.get_type_versions(sort_type_name):
        registry = version_to_registry[version]
        sort_dict = registry.get_sort_dict_by_type(sort_type_name)
        for sort_encoded_value, sort_value in sort_dict.items():
          if not registry.has_partition_for_type_name(sort_value):
            if sort_encoded_value != 0:
              print_warn(
                f"The index sort {sort_type_name} in version {version} "
                f"specifies value {sort_value} which has no corresponding "
                'partition.'
              )
            continue
          partition = registry.get_partition_for_type_name(sort_value)
          if sort_value in sort_value_to_partition:
            assert sort_value_to_partition[sort_value] == partition
          else:
            sort_value_to_partition[sort_value] = partition

      # Only add sorts that have associated partitions.
      if len(sort_value_to_partition) == 0:
        continue

      type_name_partition_list = {}
      for type_name, partition in sorted(sort_value_to_partition.items()):
        type_name_partition_list[type_name] = partition
      index_type_to_partitions[sort_type_name] = type_name_partition_list

    return index_type_to_partitions

  def _aggregate_node_offset_partition_info(self, version_to_registry,
                                            revision_info):
    offset_type_to_partition = {}

    # Map offsets (like "FormSpec") to their corresponding partition type and
    # name pair (e.g., "FormSpec", "form.spec").
    offset_type_names = revision_info.get_types_by_role(
      edgifc.IFCRegistryTypeRole.NODE_OFFSET
    )
    for offset_type_name in offset_type_names:
      backing_type = None
      backing_partition = None
      for version in revision_info.get_type_versions(offset_type_name):
        registry = version_to_registry[version]
        version_backing_type = (
          registry.get_node_offset_backing_type_name_by_type(
            offset_type_name
          )
        )
        if not registry.has_partition_for_type_name(version_backing_type):
          print_warn(
            f"The offset {offset_type_name} in version {version} specifies "
            f"value {backing_type} which has no corresponding partition."
          )
          continue
        version_backing_partition = registry.get_partition_for_type_name(
          version_backing_type
        )
        if backing_type != None:
          assert version_backing_type == backing_type
          assert version_backing_partition == backing_partition
        else:
          backing_type = version_backing_type
          backing_partition = version_backing_partition

      # Only add offsets that have associated partitions.
      if backing_type == None:
        continue

      offset_type_to_partition[offset_type_name] = (
        backing_type,
        backing_partition
      )

    return offset_type_to_partition

  def _aggregate_field_info(self, version_to_registry, revision_info):
    basic_node_type_names = revision_info.get_types_by_role(
      edgifc.IFCRegistryTypeRole.BASIC_NODE
    )
    header_node_type_names = revision_info.get_types_by_role(
      edgifc.IFCRegistryTypeRole.HEADER_NODE
    )
    partition_node_type_names = revision_info.get_types_by_role(
      edgifc.IFCRegistryTypeRole.PARTITION_NODE
    )

    node_type_names = [
      *basic_node_type_names,
      *header_node_type_names,
      *partition_node_type_names
    ]

    node_type_name_to_field_info = {}
    for node_type_name in node_type_names:
      field_name_to_info = {}

      # Do a pass with all supported versions to get a complete picture of the
      # field information for every version that we might be trying to access
      # the field from.
      for version in edgifc.SUPPORTED_VERSIONS:
        registry = version_to_registry[version]

        # If the registry doesn't have the type at all in this version, mark
        # no fields as present.
        if not registry.has_type(node_type_name):
          continue

        type_info = registry.get_type(node_type_name)

        # Collect the fields by name -> (field, tacit_field)
        fields_for_version = {}
        for field in type_info.fields():
          fields_for_version[field.name()] = (field, None)

        for tacit_field in type_info.tacit_fields():
          tacit_field_name = tacit_field.name()
          if tacit_field_name in fields_for_version:
            field = fields_for_version[tacit_field_name][0]
            fields_for_version[tacit_field_name] = (field, tacit_field)
          else:
            fields_for_version[tacit_field_name] = (None, tacit_field)

        for field_name, (field, tacit_field) in fields_for_version.items():
          if field_name not in field_name_to_info:
            field_name_to_info[field_name] = AccessorFieldInfo()

          acc_field_info = field_name_to_info[field_name]
          if tacit_field != None:
            acc_field_info.add_tacit_version(
              tacit_field,
              version,
              shadowed_field = field
            )
          elif field != None:
            acc_field_info.add_version(field, version)

      # Populate the field information
      field_names_list = list(field_name_to_info.keys())
      field_names_list.sort()
      node_type_name_to_field_info[node_type_name] = (
        field_name_to_info, field_names_list
      )

    return node_type_name_to_field_info

  def _aggregate_field_name_to_node_types(self, node_type_name_to_field_info):
    # Aggregate the mapping from field name to a list of type names that
    # have that field.
    field_name_to_node_types = {}
    for node_type_name, field_name_map in node_type_name_to_field_info.items():
      for field_name in field_name_map[1]:
        if field_name not in field_name_to_node_types:
          field_name_to_node_types[field_name] = list()
        field_name_to_node_types[field_name].append(node_type_name)

    # Sort the mapping's lists of type names.
    for node_type_names in field_name_to_node_types.values():
      node_type_names.sort()

    # Convert the mapping to a sorted list of tuples.
    field_name_to_node_types_list = list(field_name_to_node_types.items())
    field_name_to_node_types_list.sort(key = lambda x: x[0])
    return field_name_to_node_types_list

  def _aggregate_field_name_to_types(self, field_name_to_node_type_names,
                                     node_type_name_to_field_info):
    field_name_to_type_names = {}
    for field_name, node_type_names in field_name_to_node_type_names:
      field_return_types = set()
      for node_type_name in node_type_names:
        node_type_info = node_type_name_to_field_info[node_type_name]
        node_field_info = node_type_info[0][field_name]
        return_type_name = node_field_info.get_type_name()
        field_return_types.add(return_type_name)

      field_return_types_list = list(field_return_types)
      field_return_types_list.sort()
      field_name_to_type_names[field_name] = field_return_types_list
    return field_name_to_type_names

  def _aggregate_type_size_info(self, version_to_registry, revision_info):
    raw_byte_type_names = revision_info.get_types_by_role(
      edgifc.IFCRegistryTypeRole.RAW_BYTES
    )
    raw_numeric_type_names = revision_info.get_types_by_role(
      edgifc.IFCRegistryTypeRole.RAW_NUMERIC
    )
    bitfield_type_names = revision_info.get_types_by_role(
      edgifc.IFCRegistryTypeRole.BITFIELD
    )
    index_type_names = revision_info.get_types_by_role(
      edgifc.IFCRegistryTypeRole.INDEX_SORT
    )
    foreign_index_type_names = revision_info.get_types_by_role(
      edgifc.IFCRegistryTypeRole.FOREIGN_INDEX
    )
    node_offset_type_names = revision_info.get_types_by_role(
      edgifc.IFCRegistryTypeRole.NODE_OFFSET
    )
    string_table_offset_type_names = revision_info.get_types_by_role(
      edgifc.IFCRegistryTypeRole.STRING_TABLE_OFFSET
    )
    basic_node_type_names = revision_info.get_types_by_role(
      edgifc.IFCRegistryTypeRole.BASIC_NODE
    )
    header_node_type_names = revision_info.get_types_by_role(
      edgifc.IFCRegistryTypeRole.HEADER_NODE
    )
    partition_node_type_names = revision_info.get_types_by_role(
      edgifc.IFCRegistryTypeRole.PARTITION_NODE
    )

    # Aggregate all types where we're caching type size info (the only reason
    # everything isn't here, is that we don't actually use the largest type
    # size on every role, so it would be wasteful to calculate).
    all_max_sized_cached_types = [
      *raw_byte_type_names,
      *raw_numeric_type_names,
      *bitfield_type_names,
      *index_type_names,
      *foreign_index_type_names,
      *node_offset_type_names,
      *string_table_offset_type_names,
      *basic_node_type_names,
      *header_node_type_names,
      *partition_node_type_names
    ]

    type_to_largest_size = {}
    for type_name in all_max_sized_cached_types:
      largest_type_size = 0
      for version in revision_info.get_type_layout_versions(type_name):
        registry = version_to_registry[version]
        type_size = registry.get_type(type_name).size()
        if type_size > largest_type_size:
          largest_type_size = type_size
      type_to_largest_size[type_name] = largest_type_size

    return type_to_largest_size

  def _aggregate_largest_index_type_size(self, type_to_largest_size,
                                         revision_info):
    largest_index_type_size = 0
    index_sort_types = revision_info.get_types_by_role(
      edgifc.IFCRegistryTypeRole.INDEX_SORT
    )
    for type_name in index_sort_types:
      type_size = type_to_largest_size[type_name]
      if type_size > largest_index_type_size:
        largest_index_type_size = type_size

    return largest_index_type_size

  def _aggregate_bitfield_queries(self, version_to_registry, revision_info):
    bitfield_type_names = revision_info.get_types_by_role(
      edgifc.IFCRegistryTypeRole.BITFIELD
    )

    bitfield_type_to_queries = {}
    for type_name in bitfield_type_names:
      unique_names = set()
      for version in revision_info.get_type_versions(type_name):
        registry = version_to_registry[version]

        # Merge the unique names.
        sort_dict = registry.get_bitfield_registration_by_type(type_name)
        unique_names.update(sort_dict.values())

      unique_names = list(unique_names)
      unique_names.sort()

      bitfield_type_to_queries[type_name] = unique_names

    return bitfield_type_to_queries

  def _aggregate_category_info(self, version_to_registry, revision_info):
    value_category_types = revision_info.get_types_by_role(
      edgifc.IFCRegistryTypeRole.VALUE_CATEGORY
    )

    category_info = {}
    for type_name in value_category_types:
      sort_for_type = None
      sort_label_to_type = {}

      for type_version in revision_info.get_type_versions(type_name):
        registry = version_to_registry[type_version]
        reg = registry.get_value_category_registration_by_type(type_name)

        new_sort_for_type = reg.discriminating_sort
        assert (sort_for_type is None or sort_for_type == new_sort_for_type)
        sort_for_type = new_sort_for_type

        category_items = reg.resolved_category_dict.items()
        for sort_label, (interp_type_name, _) in category_items:
          if sort_label not in sort_label_to_type:
            sort_label_to_type[sort_label] = interp_type_name
          else:
            assert sort_label_to_type[sort_label] == interp_type_name

      assert sort_for_type is not None
      category_info[type_name] = (sort_for_type, sort_label_to_type)

    return category_info

  def get_all_sort_values(self, sort_type_name):
    return self._sort_type_name_to_values[sort_type_name]

  def get_all_partition_index_types(self):
    return self._index_types_with_partitions

  def get_all_partition_offset_types(self):
    return self._offset_types_with_partitions

  def get_all_partition_reference_types(self):
    return self._reference_types_with_partitions

  def get_partition_for_type_name(self, node_type_name):
    return self._type_name_to_partition[node_type_name]

  def get_type_name_for_partition(self, partition_id):
    return self._partition_to_type_name[partition_id]

  def get_type_partitions_for_index_type(self, index_type_name):
    return self._index_type_to_partition_info[index_type_name]

  def has_any_partition_info_for_index(self, index_type_name):
    return index_type_name in self._index_type_to_partition_info

  def get_type_partition_for_node_offset_type(self, offset_type_name):
    return self._node_offset_type_to_partition_info[offset_type_name]

  def is_type_referenced(self, node_type_name, ref_type_name):
    if ref_type_name in self._index_type_to_partition_info:
      partition_info = self._index_type_to_partition_info[ref_type_name]
      if node_type_name in partition_info:
        return True
    if ref_type_name in self._node_offset_type_to_partition_info:
      a_node_type_name, _ = (
        self._node_offset_type_to_partition_info[ref_type_name]
      )
      if node_type_name == a_node_type_name:
        return True
    return False

  def get_all_field_names(self, node_type_name):
    _, field_name_list = self._node_type_name_to_field_info[node_type_name]
    return field_name_list

  def has_any_field_named(self, node_type_name, field_name):
    try:
      node_field_info, _ = self._node_type_name_to_field_info[node_type_name]
      return field_name in node_field_info
    except KeyError:
      # FIXME: Eventually this should be unnecessary/removed, for now our sorts
      # are incomplete.
      return False

  def get_field_info(self, node_type_name, field_name):
    node_field_info, _ = self._node_type_name_to_field_info[node_type_name]
    return node_field_info[field_name]

  def get_field_type(self, node_type_name, field_name):
    return self.get_field_info(node_type_name, field_name).get_type_name()

  def get_fields_for_all_nodes(self):
    '''Return all field names and the respective node types said fields appear
    in.'''
    return self._field_name_to_node_type_names

  def get_types_of_field(self, field_name):
    '''Return all types a given field name has across all nodes.'''
    return self._field_name_to_type_names[field_name]

  def get_largest_type_size(self, type_name):
    return self._type_to_largest_size[type_name]

  def get_largest_index_type_size(self):
    return self._largest_index_type_size

  def get_bitfield_queries(self, bitfield_type_name):
    return self._bitfield_type_to_queries[bitfield_type_name]

  def get_sort_for_category_type(self, type_name):
    return self._category_info[type_name][0]

  def get_category_case_type_name(self, type_name, sort_label):
    return self._category_info[type_name][1][sort_label]

class CPPVersionBranchWriter:
  def __init__(self, *, always_write_branches = False, file_ref = 'file',
               **fwd_kw_args):
    self._versioned_branches = []
    self._always_write_branches = always_write_branches
    self._file_ref = file_ref
    self._fwd_kw_args = fwd_kw_args

  def add_branch(self, version, branch):
    self._versioned_branches.append((version, branch))

  def requires_block_in_switch(self):
    return False

  def num_branches(self):
    return len(self._versioned_branches)

  def write(self, output_stream, **fwd_kw_args):
    backing_writer = edgcppgen.BranchWriter(**self._fwd_kw_args)

    # Sort in order from oldest to newest version (as this is the order that
    # will be most frequently encountered as input). Then, reverse the list
    # (relatively cheap compared to a reversing a potentially fully ordered
    # list via sorting).
    def get_branch_version(branch):
      return branch[0]
    self._versioned_branches.sort(key = get_branch_version)

    for version, branch in reversed(self._versioned_branches):
      backing_writer.add_branch(
        f"is_at_least({self._file_ref}, {version.major}, {version.minor})",
        branch
      )

    if not self._always_write_branches and len(self._versioned_branches) > 0:
      backing_writer.make_final_case_else()
    backing_writer.write(output_stream, **fwd_kw_args)

class AccessorFieldInfo:
  def __init__(self):
    self._field_type_name = None
    self._versions = []
    self._versions_set = set()
    self._missing_versions = []
    self._version_to_shadowed_field = {}

    self._tacit_versions = set()

  def _add_version(self, version):
    self._versions.append(version)
    self._versions_set.add(version)

  def _add_field_type_name(self, field_type_name, version):
    if self._field_type_name == field_type_name:
      return

    if self._field_type_name is None:
      self._field_type_name = field_type_name
      return

    err_msg = (
      f"Version {version.major}.{version.minor} tried to change the field "
      f"type from: {self._field_type_name} to: {field_type_name}"
    )
    assert False, err_msg

  def add_version(self, field, version):
    self._add_field_type_name(field.type_name(), version)
    self._add_version(version)

  def add_tacit_version(self, tacit_field, version, *, shadowed_field):
    self._add_field_type_name(tacit_field.type_name(), version)
    self._add_version(version)
    self._tacit_versions.add(version)
    if shadowed_field != None:
      self._version_to_shadowed_field[version] = shadowed_field.type_name()

  def get_type_name(self):
    return self._field_type_name

  def is_shadowed_at_version(self, version):
    return version in self._version_to_shadowed_field

  def get_shadowed_type_name_at_version(self, version):
    return self._version_to_shadowed_field[version]

  def is_direct_access(self, version):
    assert self.is_present_at_version(version)
    return version not in self._tacit_versions

  def get_mutator_type_at_version(self, version):
    if self.is_shadowed_at_version(version):
      return self.get_shadowed_type_name_at_version(version)
    return self.get_type_name()

  def is_writable(self, version):
    if self.is_direct_access(version):
      return True
    if self.is_shadowed_at_version(version):
      return True
    return False

  def get_versions_present(self):
    return self._versions

  def is_present_at_version(self, version):
    return version in self._versions_set

