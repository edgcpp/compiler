IFC_BYTE_BUFFER_DECL='''
struct an_ifc_module_file;
struct an_ifc_validation_trace;

/*
This is the base class for most IFC entries; it holds a pointer to the file
the entry came from.  This is represented as a base class to allow easier API
design.
*/
struct an_ifc_module_entry {
  an_ifc_module_entry(an_ifc_module_file *file_val)
    : file(file_val)
    {}

  inline an_ifc_module_file *get_file() const
    { return this->file; }

  an_ifc_module_file *file;
                        /* The module file associated with the underlying IFC
                           byte buffer. */
};  /* an_ifc_module_entry */

enum a_byte_buffer_kind {
  bbk_none,             /* The byte buffer is uninitialized. */
  bbk_local,            /* The byte buffer is stored in the Byte_buffer_entry
                           object itself (used during non-MMAP based IFC
                           reading). */
  bbk_direct_ptr,       /* The byte buffer is accessible by dereferencing
                           a pointer stored in the Byte_buffer_entry object
                           (used during MMAP based IFC reading). */
  bbk_indirect_ptr      /* The byte buffer can be retrieved by dereferencing
                           a pointer to get the current array start and then
                           adding the associated offset (used during IFC
                           writing). */
};

/*
An encapsulation which represents an offset into a byte buffer where the
underlying byte buffer might be reallocated (and thus moved to a different
starting address).
*/
struct a_byte_buffer_indirect_ptr {
  a_byte_buffer_indirect_ptr(a_byte        **start_val,
                             size_t        byte_offset_val)
    : start(start_val), byte_offset(byte_offset_val)
    {}

  a_byte        **start;
                        /* An indirect pointer to the start of the byte
                           buffer. */
  size_t        byte_offset;
                        /* The offset into the buffer for this element. */
};  /* a_byte_buffer_indirect_ptr */

/*
An encapsulated representation of an IFC byte buffer.  This encapsulation
abstracts away the exact location of the underlying byte buffer storage.
*/
template<typename an_ifc_Storage_type>
struct Byte_buffer_entry : public an_ifc_module_entry {
  Byte_buffer_entry()
    : an_ifc_module_entry(NULL), kind(bbk_none)
    {}

  Byte_buffer_entry(an_ifc_module_file *mod_val)
    : an_ifc_module_entry(mod_val), kind(bbk_local), storage{}
    {}

  Byte_buffer_entry(an_ifc_module_file        *mod_val,
                     const an_ifc_Storage_type &storage_ref)
    : an_ifc_module_entry(mod_val), kind(bbk_local), storage{}
    { memcpy(&this->storage, &storage_ref, sizeof(an_ifc_Storage_type)); }

  inline Byte_buffer_entry(an_ifc_module_file        *mod_val,
                            const an_ifc_Storage_type *storage_ptr_val);

  Byte_buffer_entry(an_ifc_module_file *mod_val,
                     a_byte             **buffer_start,
                     size_t             byte_offset)
    : an_ifc_module_entry(mod_val), kind(bbk_indirect_ptr),
      storage_indirect_ptr(buffer_start, byte_offset)
    {}

  inline const an_ifc_Storage_type *get_storage() const;
private:
  a_byte_buffer_kind
                kind;   /* The origin of the bytes. */
#ifdef UNION_AS_STRUCT
/* FIXME: Workaround for union-as-struct build issue. */
#undef union
#endif /* ifdef UNION_AS_STRUCT */
  union {
    /* When kind == bbk_none: no variant fields. */
    /* When kind == bbk_local: */
    an_ifc_Storage_type
                storage;
                        /* The underlying IFC byte buffer (stored locally). */
    /* When kind == bbk_direct_ptr: */
    const an_ifc_Storage_type
                *storage_ptr;
                        /* A pointer to the underlying IFC byte buffer. */
    /* When kind == bbk_indirect_ptr: */
    a_byte_buffer_indirect_ptr
                storage_indirect_ptr;
                        /* An indirect pointer to the underlying byte
                           buffer. */
#ifdef UNION_AS_STRUCT
#define union struct
#endif /* ifdef UNION_AS_STRUCT */
  };
};  /* Byte_buffer_entry */

template<typename an_ifc_Storage_type>
extern size_t get_byte_buffer_size(an_ifc_module_file *file);

extern a_boolean is_for_read(an_ifc_module_file *file);

template<typename an_ifc_Storage_type>
Byte_buffer_entry<an_ifc_Storage_type>::Byte_buffer_entry(
                                    an_ifc_module_file        *mod_val,
                                    const an_ifc_Storage_type *storage_ptr_val)
/*
Given a module file and a pointer to associated storage this constructor
creates a direct pointer reference in file read modes and a memory copy in file
write modes (to prevent issues that would otherwise occur if the bytes are
relocated due to a reallocation of the underlying buffer).
*/
  : an_ifc_module_entry(mod_val)
{
  if (is_for_read(mod_val)) {
    this->kind = bbk_direct_ptr;
    this->storage_ptr = storage_ptr_val;
  } else {
    size_t storage_len = get_byte_buffer_size<an_ifc_Storage_type>(mod_val);

    this->kind = bbk_local;
    memcpy(&this->storage, storage_ptr_val, storage_len);
  }  /* if */
}  /* Byte_buffer_entry::Byte_buffer_entry */


template<typename an_ifc_Storage_type>
inline const an_ifc_Storage_type*
Byte_buffer_entry<an_ifc_Storage_type>::get_storage() const
/*
This function provides access to the underlying IFC node storage by returning
a pointer to the associated IFC byte buffer (regardless of where the byte
buffer actually resides in memory).
*/
{
  /* Set an initial value to prevent warnings about an uninitialized read in
     some configurations. */
  const an_ifc_Storage_type *result = NULL;

  switch (this->kind) {
    case bbk_none:
      /* This is a read from an "uninitialized" forward declaration that's
         being accessed. */
      unexpected_condition();
    case bbk_local:
      result = &this->storage;
      break;
    case bbk_direct_ptr:
      result = this->storage_ptr;
      break;
    case bbk_indirect_ptr:
      { a_byte **start = this->storage_indirect_ptr.start;
        size_t byte_offset = this->storage_indirect_ptr.byte_offset;

        result = (const an_ifc_Storage_type*)((*start) + byte_offset);
      }
      break;
    default_is_unexpected();
  }  /* switch */
  return result;
}  /* get_storage */


/*
Convert the given value to the given type.  In checked modes additionally
ensure the conversion was not lossy.
*/
#define checked_ifc_byte_cast(value, from_type, to_type)                \\
  (check_assertion(value == from_type(to_type(value))), (to_type)value)

/*
An encapsulated representation of an IFC numeric value.
*/
template<typename an_ifc_Storage_type>
struct Numeric_entry : public an_ifc_module_entry {
  Numeric_entry()
    : an_ifc_module_entry(NULL), value{}
    {}

  template<typename a_Type>
  Numeric_entry(an_ifc_module_file *mod_val,
                a_Type             value_ref)
    : an_ifc_module_entry(mod_val),
      value{checked_ifc_byte_cast(value_ref, a_Type, an_ifc_Storage_type)}
    {}

  an_ifc_Storage_type
                value;  /* The raw bit value obtained from the module.
                           Represented as the largest common underlying
                           type. */
};  /* Numeric_entry */

/*
An encapsulated representation of an IFC numeric value that supports implicit
conversion.
*/
template<typename an_ifc_Storage_type>
struct Implicit_numeric_entry : public an_ifc_module_entry {
  Implicit_numeric_entry()
    : an_ifc_module_entry(NULL), value{}
    {}

  template<typename a_Type>
  Implicit_numeric_entry(an_ifc_module_file *mod_val,
                         a_Type             value_ref)
    : an_ifc_module_entry(mod_val),
      value{checked_ifc_byte_cast(value_ref, a_Type, an_ifc_Storage_type)}
    {}

  an_ifc_Storage_type
                value;  /* The raw bit value obtained from the module.
                           Represented as the largest common underlying
                           type. */

  inline operator an_ifc_Storage_type() const
    { return this->value; }
};  /* Implicit_numeric_entry */


/*
An encapsulated representation of an IFC index value.
*/
template<typename an_ifc_Sort_type, typename a_Native_size_type>
struct Index_entry : public an_ifc_module_entry {
  Index_entry()
    : an_ifc_module_entry(NULL), sort{}, value{}
    {}

  template<typename a_Type>
  Index_entry(an_ifc_module_file *mod_val,
              an_ifc_Sort_type   sort_val,
              a_Type             value_val)
    : an_ifc_module_entry(mod_val), sort{sort_val},
      value{checked_ifc_byte_cast(value_val, a_Type, a_Native_size_type)}
    {}

  an_ifc_Sort_type
                sort;   /* The associated sort value for this index. */
  a_Native_size_type
                value;  /* The index value into the associated partition of
                           "sort" for this index.  Represented as the largest
                           common underlying type. */
};  /* Index_entry */


/*
An encapsulated representation of an IFC node offset value.
*/
template<typename an_ifc_Node_type, typename a_Native_size_type>
struct Offset_entry : public an_ifc_module_entry {
  using node_type = an_ifc_Node_type;
  Offset_entry()
    : an_ifc_module_entry(NULL), value{}
    {}

  template<typename a_Type>
  Offset_entry(an_ifc_module_file *mod_val,
               a_Type             value_val)
    : an_ifc_module_entry(mod_val),
      value{checked_ifc_byte_cast(value_val, a_Type, a_Native_size_type)}
    {}

  a_Native_size_type
                value;  /* The index value into the associated partition for
                           this offset.  Represented as the largest common
                           underlying type. */
};  /* Offset_entry */
'''.strip()


UNIVERSAL_NAME_PREFIX = 'an_ifc_'

PARTITION_ID_SANITIZATION_REGEX = re.compile('[\\.-]')

SCOPED_ENUM_PREFIX = 'ifc_'

class CPPFieldStageBuilderStage:
  def __init__(self, stage_builder, idx, result_type_name,
               result_type_cpp_name):
    self.idx = idx
    self.result_type_name = result_type_name
    self.result_type_cpp_name = result_type_cpp_name
    self.gen_branch_fns = []
    self._is_data_used = False
    self._stage_builder = stage_builder
    self._extra_var_raw_names = set()
    self._extra_vars = []
    self._extra_vars_raw_names = []
    self._equality_key_additions = []

  def _get_stages_array_idx(self):
    return self.idx

  def has_previous_stage(self):
    return self._get_stages_array_idx() > 0

  def get_previous_stage(self):
    return self._stage_builder._stages[self._get_stages_array_idx() - 1]

  def has_next_stage(self):
    current_final_stage_idx = len(self._stage_builder._stages) - 1
    return self.idx < current_final_stage_idx

  def get_next_stage(self):
    return self._stage_builder._stages[self._get_stages_array_idx() + 1]

  def mark_data_used(self):
    # Mark this stage and all previous stages as having their data used.
    stage = self
    while stage is not None and not stage._is_data_used:
      stage._is_data_used = True
      stage = (
        stage.get_previous_stage() if stage.has_previous_stage() else None
      )

  def is_data_used(self):
    return self._is_data_used

  def should_be_generated(self):
    return not self._stage_builder.is_validated() or self.is_data_used()

  def get_result_ref(self):
    prefix = self._stage_builder._stage_prefix
    if len(prefix) > 0:
      return f"{prefix}_{self.idx}"
    return f"stage_{self.idx}"

  def has_extra_var_ref(self, raw_var_name):
    return raw_var_name in self._extra_var_raw_names

  def get_extra_var_ref(self, raw_var_name):
    assert self.has_extra_var_ref(raw_var_name)
    return f"{self.get_result_ref()}_{raw_var_name}"

  def get_extra_var_ref_latest(self, raw_var_name, default_value):
    # If this stage has the extra var, great, return it!
    if self.has_extra_var_ref(raw_var_name):
      return self.get_extra_var_ref(raw_var_name)
    # Otherwise, loop backwards to find the first stage that has this extra
    # var.
    stage = self
    while stage.has_previous_stage():
      stage = stage.get_previous_stage()
      if stage.has_extra_var_ref(raw_var_name):
        return stage.get_extra_var_ref(raw_var_name)
    # Finally, if all else fails, return the default value.
    return default_value

  def get_trace_ref(self):
    trace = self.get_extra_var_ref_latest('trace', 'parent')
    if trace == 'parent':
      return trace
    return f"&{trace}"

  def add_extra_var(self, var_type, raw_var_name, var_init):
    self._extra_var_raw_names.add(raw_var_name)
    self._extra_vars.append(
      (var_type, self.get_extra_var_ref(raw_var_name), var_init)
    )
    self._extra_vars_raw_names.append(
      (var_type, raw_var_name, var_init)
    )

  def get_extra_vars(self):
    return self._extra_vars

  def get_extra_vars_with_raw_names(self):
    return self._extra_vars_raw_names

  def add_to_quality_key(self, value):
    self._equality_key_additions.append(value)

  def get_equality_key_additions(self):
    return self._equality_key_additions

class CPPFieldStageBuilder:
  def __init__(self, input_ref, with_validation, stage_prefix = '',
               inherited_state = {}):
    self._input_ref = input_ref
    self._with_validation = with_validation
    self._stage_prefix = stage_prefix
    self._state = dict(inherited_state)
    self._stages = []

  def add_stage(self, result_type_name, result_type_cpp_name):
    new_stage = CPPFieldStageBuilderStage(
      self,
      len(self._stages),
      result_type_name,
      result_type_cpp_name
    )
    self._stages.append(new_stage)
    return new_stage

  def is_validated(self):
    return self._with_validation

  def get_last_stage(self):
    return self._stages[-1]

  def get_state(self):
    return self._state

  def build_void(self):
    variables = []
    stage_logic = []

    last_idx = len(self._stages) - 1
    for idx, stage in enumerate(self._stages):
      if not stage.should_be_generated():
        break

      variables.append(
        (stage.result_type_cpp_name, stage.get_result_ref(), None)
      )
      for var_type, var_name, var_init in stage.get_extra_vars():
        variables.append((var_type, var_name, var_init))
      for gen_branch_fn in stage.gen_branch_fns:
        stage_logic.extend(gen_branch_fn())

    # Merge the variable block with the stage logic.
    full_branch = []
    if len(variables) > 0:
      full_branch.append(edgcppgen.VariableBlockWriter(variables))
    full_branch.extend(stage_logic)
    return full_branch

  def _build_final_assignment(self, result_ref, result_type_cpp_name):
    last_stage = self._stages[-1]
    expected_type = result_type_cpp_name
    received_type = last_stage.result_type_cpp_name

    def make_err_msg():
      error_msg = f"Expected: {expected_type}, Received: {received_type}"
      for stage_idx, stage in enumerate(self._stages):
        error_msg += f"\n stage {stage_idx} - {stage.result_type_cpp_name}"
      return error_msg
    assert expected_type == received_type, make_err_msg()

    return f"{result_ref} = {last_stage.get_result_ref()};"

  def build(self, final_result_ref, final_result_type_cpp_name):
    branch = self.build_void()
    final_assignment = self._build_final_assignment(
      final_result_ref,
      final_result_type_cpp_name
    )
    branch.append(final_assignment)
    return branch

  def build_equality_key(self, *, expensive_mode):
    # Expensive mode is somewhat of a hack, in expensive mode, the entire
    # stage builder is "built" in void form, written to an in memory string
    # buffer/file, and then read back as the "key".
    #
    # This effectively allows "exact match" comparisons when comparing the
    # "key", but as one might assume, is slower.
    if expensive_mode:
      string_stream = io.StringIO('')
      edgcppgen.write_stmt_seq(self.build_void(), string_stream)
      string_stream.seek(0)
      return string_stream.read()
    else:
      key = []
      # Capture the input reference
      key.append(self._input_ref)
      for idx, stage in enumerate(self._stages):
        # Capture the explicitly added extra key values.
        for value in stage.get_equality_key_additions():
          key.append(value)
        # Capture the stage result type information.
        key.append(stage.result_type_cpp_name)
        # Capture the extra variables types and names.
        for var_type, var_name, var_init in stage.get_extra_vars():
          key.append(var_type)
          key.append(var_name)
      return key

class BasicSplitOutputStream:
  def __init__(self, streams):
    self._streams = streams

  def write(self, *fw_args):
    for stream in self._streams:
      stream.write(*fw_args)

class SplitOutputStream:
  def __init__(self, role_to_stream):
    self._role_to_stream = role_to_stream

  def get_type(self):
    return self._role_to_stream['type']

  def get_decl(self):
    return self._role_to_stream['decl']

  def get_def(self):
    return self._role_to_stream['def']

  def get_acc_def(self):
    return self._role_to_stream['acc_def']

  def get_dbg_def(self):
    return self._role_to_stream['dbg_def']

  def get_mut_def(self):
    return self._role_to_stream['mut_def']

  def get_val_def(self):
    return self._role_to_stream['val_def']

  def get_all_def(self):
    return BasicSplitOutputStream([
      self._role_to_stream['def'],
      self._role_to_stream['acc_def'],
      self._role_to_stream['dbg_def'],
      self._role_to_stream['mut_def'],
      self._role_to_stream['val_def']
    ])

  def get_tmpl_inst(self):
    return self._role_to_stream['tmpl_inst']

  def get_tmpl_spec(self):
    return self._role_to_stream['tmpl_spec']

  def write(self, *fw_args):
    BasicSplitOutputStream(self._role_to_stream.values()).write(*fw_args)

class CPPCodeGen:
  def __init__(self, version_to_registry, revision_info, *,
               use_expensive_branch_dedup = False):
    self.version_to_registry = version_to_registry
    self.revision_info = revision_info
    self.agg_type_info = AggregateTypeInfoCache(
      version_to_registry,
      revision_info
    )
    self._visitor_implicit_dereference = {
      # Implicit dereferencing on the DeclIndex.
      'Decl': {
        # Implicitly dereference DeclReference via the get_ifc_index function.
        'DeclReference': 'get_ifc_index'
      }
    }
    self._value_visitors = [
      # Add a visitor over the Decl index for get_ifc_access returning
      # an_ifc_access_sort with no conversions.
      (
        'Decl',
        'access',
        'an_ifc_access_sort',
        {}
      ),
      # Add a visitor over the Decl index for get_ifc_home_scope returning
      # an_ifc_decl_index with no conversions.
      (
        'Decl',
        'home_scope',
        'an_ifc_decl_index',
        {}
      ),
      # Add a visitor over the Decl index for get_ifc_locus returning
      # an_ifc_source_location with no conversions.
      (
        'Decl',
        'locus',
        'an_ifc_source_location',
        {}
      ),
      # Add a visitor over the Decl index for get_ifc_name returning
      # an_ifc_name_index with a potential conversion from a an_ifc_text_offset
      # to an_ifc_name_index.
      (
        'Decl',
        'name',
        'an_ifc_name_index',
        {
          'conversions': {
            'an_ifc_text_offset': IFCTextOffsetToNameIndex()
          }
        }
      ),
      # Add a visitor over the Decl index for get_ifc_specifiers returning
      # an_ifc_basic_specifiers_bitfield with no conversions.
      (
        'Decl',
        'specifiers',
        'an_ifc_basic_specifiers_bitfield',
        {}
      ),
      # Add a visitor over the Expr index for get_ifc_locus returning
      # an_ifc_source_location with no conversions.
      (
        'Expr',
        'locus',
        'an_ifc_source_location',
        {}
      ),
      # Add a visitor over the Form index for get_ifc_locus returning
      # an_ifc_source_location with no conversions.
      (
        'Form',
        'locus',
        'an_ifc_source_location',
        {}
      ),
      # Add a visitor over the Macro index for get_ifc_locus returning
      # an_ifc_source_location with no conversions.
      (
        'Macro',
        'locus',
        'an_ifc_source_location',
        {}
      ),
      # Add a visitor over the Stmt index for get_ifc_locus returning
      # an_ifc_source_location with no conversions.
      (
        'Stmt',
        'locus',
        'an_ifc_source_location',
        {}
      ),
      # Add a visitor over the Syntax index for get_ifc_locus returning
      # an_ifc_source_location with no conversions.
      (
        'Syntax',
        'locus',
        'an_ifc_source_location',
        {}
      )
    ]
    self._use_expensive_branch_dedup = use_expensive_branch_dedup
    self._universal_name_cache = {}

  def _get_universal_name(self, type_name):
    # Cache the universal name as this gets called enough this can save us
    # several hundred milliseconds.
    if type_name not in self._universal_name_cache:
      name = f"an_ifc_{edgcppgen.to_snake_case(type_name)}"
      self._universal_name_cache[type_name] = name
    return self._universal_name_cache[type_name]

  def _get_versioned_name(self, type_name, version):
    # Nodes use their storage representation as their versioned
    # representation.
    if edgifc.is_node_role(self.revision_info.get_type_role(type_name)):
      return self._get_universal_opt_storage_name(type_name)

    universal_name = self._get_universal_name(type_name)
    return f"{universal_name}_{version.major}_{version.minor}"

  def _get_encoded_type_name(self, type_name):
    return f"Encoded{type_name}"

  def _get_universal_encoded_name(self, type_name):
    return self._get_universal_name(self._get_encoded_type_name(type_name))

  def _get_universal_storage_name(self, type_name):
    role = self.revision_info.get_type_role(type_name)
    universal_name = self._get_universal_name(type_name)
    if (edgifc.is_node_role(role) or
        is_numericly_represented_role(role) or
        role == edgifc.IFCRegistryTypeRole.RAW_BYTES):
      return f"{universal_name}_storage"
    return universal_name

  def _get_universal_opt_storage_name(self, type_name):
    role = self.revision_info.get_type_role(type_name)
    universal_name = self._get_universal_name(type_name)
    if (edgifc.is_node_role(role) or
        is_numericly_represented_role(role) or
        role == edgifc.IFCRegistryTypeRole.RAW_BYTES):
      return f"{universal_name}_bytes"
    return universal_name

  def _get_sort_type_name(self, type_name):
    role = self.revision_info.get_type_role(type_name)
    if role == edgifc.IFCRegistryTypeRole.INDEX_SORT:
      return type_name.replace('Index', 'Sort')
    if role == edgifc.IFCRegistryTypeRole.VALUE_CATEGORY:
      sort_name = self.agg_type_info.get_sort_for_category_type(type_name)
      return f"{sort_name}Sort"
    return type_name

  def _get_universal_sort_name(self, type_name):
    sort_name = self._get_sort_type_name(type_name)
    return self._get_universal_name(sort_name)

  def _get_versioned_sort_name(self, type_name, version):
    sort_type_name = self._get_sort_type_name(type_name)

    # Index type's use an implicit sort name, to get the correct version we
    # need to reverse back to the index type, and get the index type's version.
    type_for_versioning = sort_type_name
    role = self.revision_info.get_type_role(type_name)
    if role == edgifc.IFCRegistryTypeRole.INDEX_SORT:
      type_for_versioning = type_name

    sort_type_version = self.revision_info.get_revision_at_version(
      type_for_versioning,
      version
    )

    universal_name = self._get_universal_name(sort_type_name)
    version_postfix = f"_{sort_type_version.major}_{sort_type_version.minor}"
    return f"{universal_name}{version_postfix}"

  def _get_enumerator_prefix_no_ifc(self, type_name):
    universal_sort_name = self._get_universal_sort_name(type_name)
    # Drop the universal prefix (i.e., "an_ifc_")
    universal_sort_name = universal_sort_name[len(UNIVERSAL_NAME_PREFIX):]

    # Collect the characters following underscores to form the prefix
    prefix = ''
    was_underscore = True
    for char in universal_sort_name:
      if char == '_':
        was_underscore = True
        continue
      if was_underscore:
        prefix += char
        was_underscore = False
    prefix += '_'
    return prefix

  def _get_universal_sort_prefix(self, type_name):
    return f"ifc_{self._get_enumerator_prefix_no_ifc(type_name)}"

  def _get_versioned_sort_prefix(self, type_name, version):
    enumerator_prefix = self._get_enumerator_prefix_no_ifc(type_name)
    return f"ifc_{version.major}_{version.minor}_{enumerator_prefix}"

  def _get_native_index_name(self, foreign_index_type_name):
    return foreign_index_type_name.replace('ForeignIndex', 'Index')

  def _get_universal_enumerator(self, type_name, raw_enumerator_name):
    sort_prefix = self._get_universal_sort_prefix(type_name)
    transformed_name = edgcppgen.to_snake_case(raw_enumerator_name)
    return f"{sort_prefix}{transformed_name}"

  def _get_versioned_enumerator(self, type_name, raw_enumerator_name, version):
    sort_prefix = self._get_versioned_sort_prefix(type_name, version)
    transformed_name = edgcppgen.to_snake_case(raw_enumerator_name)
    return f"{sort_prefix}{transformed_name}"

  def _get_cpp_field_metadata_type(self, field_name):
    return f"an_ifc_{field_name}_metadata"

  def _write_is_supported_check(self, split_output_stream):
    function_name = 'is_supported_ifc_version'
    function_decl_args = [
      function_name,
      'a_boolean',
      [
        ('an_ifc_version', 'major_version'),
        ('an_ifc_version', 'minor_version')
      ]
    ]

    decl_output_stream = split_output_stream.get_decl()
    decl_output_stream.write('\n')
    edgcppgen.write_function_decl(
      *function_decl_args,
      decl_output_stream,
      specifiers = ['extern'],
      terminator = ');'
    )

    def_output_stream = split_output_stream.get_def()
    def_output_stream.write('\n\n')
    edgcppgen.write_function_decl(
      *function_decl_args,
      def_output_stream,
      specifiers = []
    )
    edgcppgen.write_comment(
      f"""
      Given a major and minor IFC version number, return TRUE if
      the version is supported, otherwise return FALSE.
      """,
      def_output_stream,
      large_block = True
    )
    def_output_stream.write('{\n')

    edgcppgen.write_variable_block(
      [
        ('a_boolean', 'result', 'FALSE')
      ],
      def_output_stream
    )

    major_to_minor = {}
    for version in reversed(edgifc.SUPPORTED_VERSIONS):
      if version.major not in major_to_minor:
        major_to_minor[version.major] = []
      major_to_minor[version.major].append(version.minor)

    major_writer = edgcppgen.SwitchWriter('major_version')
    for major_version, minor_versions in major_to_minor.items():
      minor_writer = edgcppgen.SwitchWriter('minor_version')
      minor_writer.add_cases(
        minor_versions,
        ['result = TRUE;']
      )
      minor_writer.add_default_case([])
      major_writer.add_case(
        major_version,
        [minor_writer]
      )
    major_writer.add_default_case([])
    major_writer.write(def_output_stream)
    def_output_stream.write('  return result;\n')
    edgcppgen.write_function_def_end(function_name, def_output_stream)

  def _write_buffer_get_size_template(self, output_stream):
    output_stream.write('\n\n')
    edgcppgen.write_function_template_decl(
      [
        ('typename', 'an_ifc_Storage_type')
      ],
      'get_ifc_buffer_size',
      'size_t',
      [
        ('an_ifc_module_file*', 'file')
      ],
      output_stream,
      specifiers = ['extern'],
      terminator = ') DELETED_FN_DEF'
    )

  def _write_byte_buffer_type(self, split_output_stream):
    type_output_stream = split_output_stream.get_type()

    type_output_stream.write('\n')
    type_output_stream.write(IFC_BYTE_BUFFER_DECL)
    type_output_stream.write('\n')

  def _write_numeric_storage_type(self, type_name, output_stream):
    '''Write the storage type for a numeric value that's represented via
    a (possibly widened) host type.
    '''
    largest_type_size = self.agg_type_info.get_largest_type_size(type_name)

    storage_name = self._get_universal_storage_name(type_name)
    output_stream.write(f"using {storage_name} = ");
    output_stream.write(edgcppgen.size_to_uint(largest_type_size))
    output_stream.write(';\n');

  def _write_universal_numeric_type(self, type_name, output_stream, *,
                                    allow_implicit_conversion = False):
    '''Write the abstracting structure type for a numeric value that's
    represented via a (possibly widened) host type.
    '''
    universal_name = self._get_universal_name(type_name)
    storage_name = self._get_universal_storage_name(type_name)
    base_type_name = (
      'Implicit_numeric_entry' if allow_implicit_conversion
      else 'Numeric_entry'
    )

    edgcppgen.write_splitable(
      [
        f"struct {universal_name} :",
        f" {base_type_name}<",
        f"{storage_name}> {{"
      ],
      output_stream
    )
    edgcppgen.write_right_split(
      '  using storage_type =',
      f"{storage_name};",
      output_stream
    )
    output_stream.write(
      f"  using base_type = {base_type_name}<storage_type>;\n",
    )
    output_stream.write(f"  using base_type::{base_type_name};\n")
    output_stream.write(f"}};  /* {universal_name} */\n")

  def _write_raw_numeric_revision(self, type_name, version, output_stream):
    registry = self.version_to_registry[version]

    versioned_name = self._get_versioned_name(type_name, version)
    type_size = registry.get_type(type_name).size()
    output_stream.write(f"enum {versioned_name} : ");
    output_stream.write(edgcppgen.size_to_uint(type_size))
    output_stream.write(';\n');

  def _write_raw_numeric(self, type_name, split_output_stream, *,
                         allow_implicit_conversion = True):
    output_stream = split_output_stream.get_type()

    output_stream.write('\n\n')

    type_versions = self.revision_info.get_type_versions(type_name)
    for version in type_versions:
      self._write_raw_numeric_revision(type_name, version, output_stream)
    self._write_numeric_storage_type(type_name, output_stream)
    output_stream.write('\n\n')

    edgcppgen.write_comment(
      f"""
      The universal representation for an IFC {type_name}.
      """,
      output_stream,
      large_block = True
    )
    self._write_universal_numeric_type(
      type_name,
      output_stream,
      allow_implicit_conversion = allow_implicit_conversion
    )

  def _write_universal_byte_buffer_type(self, type_name, type_output_stream):
    largest_type_size = self.agg_type_info.get_largest_type_size(type_name)

    universal_name = self._get_universal_name(type_name)

    type_output_stream.write(f"enum {universal_name}_part : uint8_t {{}};\n")
    storage_name = self._get_universal_storage_name(type_name)
    edgcppgen.write_right_split(
      f"using {storage_name} =",
      f"{universal_name}_part[{largest_type_size}];",
      type_output_stream
    )
    type_output_stream.write('#if USE_MMAP_FOR_MODULES\n')
    opt_storage_name = self._get_universal_opt_storage_name(type_name)
    edgcppgen.write_right_split(
      f"using {opt_storage_name} =",
      f"const {storage_name}*;",
      type_output_stream
    )
    type_output_stream.write('#else /* !USE_MMAP_FOR_MODULES */\n')
    edgcppgen.write_right_split(
      f"using {opt_storage_name} =",
      f"{storage_name};",
      type_output_stream
    )
    type_output_stream.write('#endif /* USE_MMAP_FOR_MODULES */\n')
    edgcppgen.write_comment(
      f"""
      The universal representation of an IFC {type_name} node.

      %BREAK%

      The representation is declared as a derived struct of Byte_buffer_entry
      rather than simply an alias of the instantiation to improve the debugger
      experience.
      """,
      type_output_stream,
      large_block = True
    )
    edgcppgen.write_splitable(
      [
        f"struct {universal_name} :",
        ' Byte_buffer_entry<'
        f"{storage_name}> {{"
      ],
      type_output_stream
    )
    edgcppgen.write_right_split(
      '  using storage_type =',
      f"{storage_name};",
      type_output_stream
    )
    type_output_stream.write(
      '  using base_type = Byte_buffer_entry<storage_type>;\n',
    )
    type_output_stream.write('  using base_type::Byte_buffer_entry;\n')
    type_output_stream.write(f"}};  /* {universal_name} */\n")

  def _write_universal_byte_buffer_functions(self, type_name,
                                             split_output_stream):
    decl_output_stream = split_output_stream.get_decl()

    storage_name = self._get_universal_storage_name(type_name)

    template_decl_args = [
      [],
      f"get_ifc_buffer_size<{storage_name}>",
      'size_t',
      [
        ('an_ifc_module_file*', 'file')
      ]
    ]
    decl_output_stream.write('\n\n')
    edgcppgen.write_function_template_decl(
      *template_decl_args,
      decl_output_stream,
      specifiers = [],
      terminator = ');'
    )

    def_output_stream = split_output_stream.get_def()
    edgcppgen.write_function_template_decl(
      *template_decl_args,
      def_output_stream,
      specifiers = []
    )
    edgcppgen.write_comment(
      f"""
      Given the associated module file, return the number of bytes required for
      an IFC {type_name} node.
      """,
      def_output_stream,
      large_block = True
    )
    def_output_stream.write('{\n')

    edgcppgen.write_variable_block(
      [
        ('size_t', 'result', None)
      ],
      def_output_stream
    )

    writer = CPPVersionBranchWriter()
    type_versions = self.revision_info.get_type_versions(type_name)
    prev_type_size = 0
    for type_version in type_versions:
      registry = self.version_to_registry[type_version]
      type_size = registry.get_type(type_name).size()

      if type_size == prev_type_size:
        continue

      writer.add_branch(
        type_version,
        [
          f"result = {type_size};"
        ]
      )
      prev_type_size = type_size
    writer.write(def_output_stream)

    def_output_stream.write(
      f"  return result;\n"
    )
    edgcppgen.write_function_def_end('get_ifc_buffer_size', def_output_stream)

  def _write_universal_byte_buffer_instantiations(self, type_name,
                                                  split_output_stream):
    inst_output_stream = split_output_stream.get_tmpl_inst()
    node_storage_type = self._get_universal_storage_name(type_name)

    edgcppgen.FunctionCallExprWriter(
      'INST_NODE_DECL',
      [
        node_storage_type
      ],
      terminator = ')\n'
    ).write(inst_output_stream)

  def _write_universal_byte_buffer(self, type_name, split_output_stream):
    type_output_stream = split_output_stream.get_type()
    self._write_universal_byte_buffer_type(type_name, type_output_stream)

    decl_output_stream = split_output_stream.get_decl()
    decl_output_stream.write('\n')

    def_output_stream = split_output_stream.get_def()
    def_output_stream.write('\n\n')
    self._write_universal_byte_buffer_functions(type_name, split_output_stream)

    self._write_universal_byte_buffer_instantiations(
      type_name,
      split_output_stream
    )

  def _write_raw_byte(self, type_name, split_output_stream):
    output_stream = split_output_stream.get_type()

    type_versions = self.revision_info.get_type_versions(type_name)
    output_stream.write('\n\n/*\n')
    table_rows = []
    for version in type_versions:
      registry = self.version_to_registry[version]
      type_info = registry.get_type(type_name)
      type_size = type_info.size()

      table_rows.append(
        (f"{version.major}.{version.minor}", str(type_info.size()))
      )
    edgcppgen.write_table(
      ('Version', 'Size'),
      table_rows,
      output_stream
    )
    output_stream.write('*/\n')

    self._write_universal_byte_buffer(type_name, split_output_stream)

  def _write_sort_revision(self, type_name, version, output_stream):
    registry = self.version_to_registry[version]

    versioned_name = self._get_versioned_sort_name(type_name, version)
    sort_size = registry.get_type(type_name).size()
    sort_size_type = edgcppgen.size_to_uint(sort_size)

    enumerators = []
    sort_dict = registry.get_sort_dict_by_type(type_name)
    for value, name in sort_dict.items():
      formatted_enumerator = self._get_versioned_enumerator(
        type_name,
        name,
        version
      )
      enumerators.append((formatted_enumerator, value))

    edgcppgen.write_enumeration(
      versioned_name,
      enumerators,
      output_stream,
      size_type = sort_size_type
    )

  def _write_universal_sort(self, type_name, output_stream):
    sort_name = self._get_universal_sort_name(type_name)

    enumerators = []
    for name in self.agg_type_info.get_all_sort_values(type_name):
      formatted_enumerator = self._get_universal_enumerator(type_name, name)
      enumerators.append((formatted_enumerator, None))

    edgcppgen.write_enumeration(
      sort_name,
      enumerators,
      output_stream
    )

  def _write_universal_sort_to_str(self, type_name, split_output_stream):
    sort_name = self._get_sort_type_name(type_name)
    universal_sort_name = self._get_universal_sort_name(type_name)

    function_name = 'str_for'
    function_decl_args = [
      function_name,
      'a_const_char*',
      [
        (universal_sort_name, 'universal')
      ]
    ]

    decl_output_stream = split_output_stream.get_decl()
    edgcppgen.write_function_decl(
      *function_decl_args,
      decl_output_stream,
      specifiers = ['extern'],
      terminator = ');'
    )

    def_output_stream = split_output_stream.get_def()
    edgcppgen.write_function_decl(
      *function_decl_args,
      def_output_stream,
      specifiers = []
    )
    edgcppgen.write_comment(
      f"""
      Given the universal representation of {sort_name}, return the textual
      name in the form of a c-string.
      """,
      def_output_stream,
      large_block = True
    )
    def_output_stream.write('{\n')
    edgcppgen.write_variable_block(
      [
        ('a_const_char*', 'result', None)
      ],
      def_output_stream
    )

    switch_writer = edgcppgen.SwitchWriter('universal')

    for name in self.agg_type_info.get_all_sort_values(type_name):
      universal_enumerator = self._get_universal_enumerator(type_name, name)

      switch_writer.add_case(
        universal_enumerator,
        [
          edgcppgen.SplittableLine(
            'result =',
            f"\"{sort_name}::{name}\";"
          )
        ]
      )

    switch_writer.add_default_case(
      [
        edgcppgen.FunctionCallExprWriter(
          'unexpected_condition_str',
          [
            f"\"Invalid value for a {sort_name}.\""
          ]
        )
      ]
    )

    switch_writer.write(def_output_stream)
    def_output_stream.write('  return result;\n')
    edgcppgen.write_function_def_end(function_name, def_output_stream)

  def _write_universal_sort_reencoding(self, type_name, type_versions,
                                       split_output_stream):
    universal_type_name = self._get_universal_name(type_name)
    encoded_type_name = self._get_encoded_type_name(type_name)
    universal_encoded_type_name = self._get_universal_name(encoded_type_name)
    universal_encoded_storage_type_name = self._get_universal_storage_name(
      encoded_type_name
    )

    function_name = 'to_encoded'
    function_decl_args = [
      function_name,
      universal_encoded_type_name,
      [
        ('an_ifc_module_file*', 'file'),
        (universal_type_name, 'universal')
      ]
    ]
    decl_output_stream = split_output_stream.get_decl()
    edgcppgen.write_function_decl(
      *function_decl_args,
      decl_output_stream,
      specifiers = ['extern'],
      terminator = ');'
    )

    def_output_stream = split_output_stream.get_def()
    edgcppgen.write_function_decl(
      *function_decl_args,
      def_output_stream,
      specifiers = []
    )
    edgcppgen.write_comment(
      f"""
      Given the universal representation of {type_name} and the destination
      module, return a reencoded sort value.
      """,
      def_output_stream,
      large_block = True
    )
    def_output_stream.write('{\n')

    sort_type_name = self._get_sort_type_name(type_name)
    encoded_sort_type_name = self._get_universal_encoded_name(sort_type_name)

    edgcppgen.write_right_split(
      "  using ue_ty =",
      f"{universal_encoded_storage_type_name};",
      def_output_stream
    )

    edgcppgen.write_variable_block(
      [
        (universal_encoded_storage_type_name, 'result', None)
      ],
      def_output_stream
    )

    writer = CPPVersionBranchWriter()

    for type_version in type_versions:
      switch_writer = edgcppgen.SwitchWriter('universal')

      registry = self.version_to_registry[type_version]
      sort_dict = registry.get_sort_dict_by_type(type_name)
      for raw_enumerator in sort_dict.values():
        versioned_enumerator = self._get_versioned_enumerator(
          type_name,
          raw_enumerator,
          type_version
        )
        universal_enumerator = self._get_universal_enumerator(
          type_name,
          raw_enumerator
        )
        switch_writer.add_case(
          universal_enumerator,
          [
            edgcppgen.SplittableLine(
              'result =',
              f"(ue_ty){versioned_enumerator};"
            )
          ]
        )

      switch_writer.add_default_case(
        [
          edgcppgen.FunctionCallExprWriter(
            'unexpected_condition_str',
            [
              f"\"Invalid value for a {type_name}.\""
            ]
          )
        ]
      )

      writer.add_branch(
        type_version,
        [
          switch_writer
        ]
      )

    writer.write(def_output_stream)

    edgcppgen.FunctionCallExprWriter(
      f"  return {universal_encoded_type_name}",
      [
        'file',
        'result'
      ],
      terminator = '};\n'
    ).write(def_output_stream)
    edgcppgen.write_function_def_end(function_name, def_output_stream)

  def _write_is_known_sort(self, type_name, version, split_output_stream):
    sort_name = self._get_sort_type_name(type_name)
    versioned_sort_name = self._get_versioned_sort_name(type_name, version)

    function_name = 'is_known_sort'
    function_decl_args = [
      function_name,
      'a_boolean',
      [
        (versioned_sort_name, 'versioned')
      ]
    ]

    decl_output_stream = split_output_stream.get_decl()
    edgcppgen.write_function_decl(
      *function_decl_args,
      decl_output_stream,
      specifiers = ['extern'],
      terminator = ');'
    )

    def_output_stream = split_output_stream.get_val_def()
    edgcppgen.write_function_decl(
      *function_decl_args,
      def_output_stream,
      specifiers = []
    )
    edgcppgen.write_comment(
      f"""
      Given the versioned representation of {sort_name}, return TRUE if
      the value represents a valid sort value; otherwise, return FALSE.
      """,
      def_output_stream,
      large_block = True
    )
    def_output_stream.write('{\n')

    edgcppgen.write_variable_block(
      [
        ('a_boolean', 'result', 'FALSE')
      ],
      def_output_stream
    )

    switch_writer = edgcppgen.SwitchWriter('versioned')

    registry = self.version_to_registry[version]
    sort_dict = registry.get_sort_dict_by_type(type_name)

    enumerators = []
    for raw_enumerator in sort_dict.values():
      versioned_enumerator = self._get_versioned_enumerator(
        type_name,
        raw_enumerator,
        version
      )

      enumerators.append(versioned_enumerator)

    switch_writer.add_cases(enumerators, ['result = TRUE;'])
    switch_writer.add_default_case([])
    switch_writer.write(def_output_stream)
    def_output_stream.write('  return result;\n')
    edgcppgen.write_function_def_end(function_name, def_output_stream)

  def _write_sort_validation(self, type_name, version, split_output_stream):
    sort_name = self._get_sort_type_name(type_name)
    versioned_sort_name = self._get_versioned_sort_name(type_name, version)

    function_name = 'validate_sort'
    function_decl_args = [
      function_name,
      'a_boolean',
      [
        ('an_ifc_module_file*', 'file'),
        (versioned_sort_name, 'versioned'),
        ('const an_ifc_validation_trace*', 'parent')
      ]
    ]

    decl_output_stream = split_output_stream.get_decl()
    edgcppgen.write_function_decl(
      *function_decl_args,
      decl_output_stream,
      specifiers = ['extern'],
      terminator = ');'
    )

    def_output_stream = split_output_stream.get_val_def()
    edgcppgen.write_function_decl(
      *function_decl_args,
      def_output_stream,
      specifiers = []
    )
    edgcppgen.write_comment(
      f"""
      Given the versioned representation of {sort_name}, return TRUE if
      the value represents a valid sort value; otherwise, return FALSE.
      """,
      def_output_stream,
      large_block = True
    )
    def_output_stream.write('{\n')

    edgcppgen.write_variable_block(
      [
        ('a_boolean', 'result', 'TRUE')
      ],
      def_output_stream
    )

    writer = edgcppgen.BranchWriter()
    writer.add_branch(
      f"!is_known_sort(versioned)",
      ['invalid_sort(file, parent);', 'result = FALSE;']
    )
    writer.write(def_output_stream)

    def_output_stream.write('  return result;\n')
    edgcppgen.write_function_def_end(function_name, def_output_stream)

  def _write_sort_conversion(self, type_name, version, split_output_stream):
    sort_name = self._get_sort_type_name(type_name)
    universal_sort_name = self._get_universal_sort_name(type_name)
    versioned_sort_name = self._get_versioned_sort_name(type_name, version)

    function_name = 'to_universal_sort'
    function_decl_args = [
      function_name,
      universal_sort_name,
      [
        (versioned_sort_name, 'versioned')
      ]
    ]

    decl_output_stream = split_output_stream.get_decl()
    edgcppgen.write_function_decl(
      *function_decl_args,
      decl_output_stream,
      specifiers = ['extern'],
      terminator = ');'
    )

    def_output_stream = split_output_stream.get_def()
    edgcppgen.write_function_decl(
      *function_decl_args,
      def_output_stream,
      specifiers = []
    )
    edgcppgen.write_comment(
      f"""
      Given the versioned representation of {sort_name}, return the
      corresponding universal representation.
      """,
      def_output_stream,
      large_block = True
    )
    def_output_stream.write('{\n')
    edgcppgen.write_variable_block(
      [
        (universal_sort_name, 'result', None)
      ],
      def_output_stream
    )

    switch_writer = edgcppgen.SwitchWriter('versioned')

    registry = self.version_to_registry[version]
    sort_dict = registry.get_sort_dict_by_type(type_name)
    for raw_enumerator in sort_dict.values():
      versioned_enumerator = self._get_versioned_enumerator(
        type_name,
        raw_enumerator,
        version
      )
      universal_enumerator = self._get_universal_enumerator(
        type_name,
        raw_enumerator
      )
      switch_writer.add_case(
        versioned_enumerator,
        [
          f"result = {universal_enumerator};"
        ]
      )

    switch_writer.add_default_case(
      [
        edgcppgen.FunctionCallExprWriter(
          'unexpected_condition_str',
          [
            f"\"Invalid value for a {type_name}.\""
          ]
        )
      ]
    )

    switch_writer.write(def_output_stream)
    def_output_stream.write('  return result;\n')
    edgcppgen.write_function_def_end(function_name, def_output_stream)

  def _write_generic_sort(self, type_name, split_output_stream):
    type_output_stream = split_output_stream.get_type()
    decl_output_stream = split_output_stream.get_decl()
    def_output_stream = split_output_stream.get_def()

    type_versions = self.revision_info.get_type_versions(type_name)
    for version in type_versions:
      type_output_stream.write('\n\n')
      self._write_sort_revision(type_name, version, type_output_stream)

    type_output_stream.write('\n\n')
    self._write_universal_sort(type_name, type_output_stream)

    intro_block = (
      f"""
      Functions for interacting with IFC {self._get_sort_type_name(type_name)}
      sorts.
      """
    )
    def_output_stream.write('\n\n')
    edgcppgen.write_comment(
      intro_block,
      def_output_stream,
      large_block = True
    )
    decl_output_stream = split_output_stream.get_decl()
    decl_output_stream.write('\n')
    edgcppgen.write_comment(
      intro_block,
      decl_output_stream,
      large_block = True
    )

    decl_output_stream.write('\n')
    def_output_stream.write('\n\n')

    self._write_universal_sort_to_str(type_name, split_output_stream)

    decl_output_stream.write('\n')
    def_output_stream.write('\n\n')

    self._write_universal_sort_reencoding(
      type_name,
      type_versions,
      split_output_stream
    )

    for version in type_versions:
      decl_output_stream.write('\n')
      split_output_stream.get_val_def().write('\n\n')
      self._write_is_known_sort(type_name, version, split_output_stream)
      decl_output_stream.write('\n')
      split_output_stream.get_val_def().write('\n\n')
      self._write_sort_validation(type_name, version, split_output_stream)
      decl_output_stream.write('\n')
      def_output_stream.write('\n\n')
      self._write_sort_conversion(type_name, version, split_output_stream)

  def _write_simple_sort(self, type_name, split_output_stream):
    self._write_generic_sort(type_name, split_output_stream)

  def _get_index_name(self, type_name):
    '''Return the raw index name associated with the index-like type name
    (e.g., "DeclIndex" -> "Decl").'''
    type_role = self.revision_info.get_type_role(type_name)
    if type_role == edgifc.IFCRegistryTypeRole.INDEX_SORT:
      return type_name[:-5]
    if type_role == edgifc.IFCRegistryTypeRole.NODE_OFFSET:
      return type_name[:-8]

    assert False, f"Unsupported role: {type_role}"

  def _get_bare_name(self, type_name):
    '''Return the bare name associated with the given entity in snake case
    (e.g., "DeclIndex" -> "decl").'''
    type_role = self.revision_info.get_type_role(type_name)
    if type_role == edgifc.IFCRegistryTypeRole.INDEX_SORT:
      return edgcppgen.to_snake_case(type_name[:-5])
    if type_role == edgifc.IFCRegistryTypeRole.NODE_OFFSET:
      return edgcppgen.to_snake_case(type_name[:-8])
    if type_role == edgifc.IFCRegistryTypeRole.VALUE_CATEGORY:
      return edgcppgen.to_snake_case(type_name[:-8])

    assert False, f"Unsupported role: {type_role}"

  def _get_tagged_sort_decode_function_name(self, type_name):
    bare_name = self._get_bare_name(type_name)
    return f"{bare_name}_sort"

  def _get_tagged_value_decode_function_name(self, type_name):
    bare_name = self._get_bare_name(type_name)
    return f"{bare_name}_value"

  def _write_tagged_sort_decode(self, type_name, version, split_output_stream):
    function_name = self._get_tagged_sort_decode_function_name(type_name)

    versioned_index_name = self._get_versioned_name(type_name, version)
    versioned_sort_name = self._get_versioned_sort_name(type_name, version)

    function_decl_args = [
      function_name,
      versioned_sort_name,
      [
        (versioned_index_name, 'versioned')
      ]
    ]

    decl_output_stream = split_output_stream.get_decl()
    edgcppgen.write_function_decl(
      *function_decl_args,
      decl_output_stream,
      specifiers = ['extern'],
      terminator = ');'
    )

    def_output_stream = split_output_stream.get_def()
    edgcppgen.write_function_decl(
      *function_decl_args,
      def_output_stream,
      specifiers = []
    )
    sort_name = self._get_sort_type_name(type_name)
    edgcppgen.write_comment(
      f"""
      Given the versioned representation of {type_name}, return the extracted
      versioned representation of {sort_name}.
      """,
      def_output_stream,
      large_block = True
    )
    def_output_stream.write('{\n')
    # Format the bitmask.
    registry = self.version_to_registry[version]
    bitmask = hex(registry.get_tagged_bitmask_by_type(type_name))
    # Compute the underlying type
    registry = self.version_to_registry[version]
    type_info = registry.get_type(type_name)
    underlying_type = edgcppgen.size_to_uint(type_info.size())
    edgcppgen.write_right_split(
      f"  return ({versioned_sort_name})({bitmask} &",
      f"({underlying_type})versioned);\n",
      def_output_stream
    )
    edgcppgen.write_function_def_end(function_name, def_output_stream)

  def _write_tagged_value_decode(self, type_name, version,
                                 split_output_stream):
    registry = self.version_to_registry[version]

    type_size = registry.get_type(type_name).size()
    native_size_type = edgcppgen.size_to_uint(type_size)

    versioned_type_name = self._get_versioned_name(type_name, version)

    function_name = self._get_tagged_value_decode_function_name(type_name)
    function_decl_args = [
      function_name,
      native_size_type,
      [
        (versioned_type_name, 'versioned')
      ]
    ]

    decl_output_stream = split_output_stream.get_decl()
    edgcppgen.write_function_decl(
      *function_decl_args,
      decl_output_stream,
      specifiers = ['extern'],
      terminator = ');'
    )

    def_output_stream = split_output_stream.get_def()
    edgcppgen.write_function_decl(
      *function_decl_args,
      def_output_stream,
      specifiers = []
    )
    edgcppgen.write_comment(
      f"""
      Given the versioned representation of {type_name}, return the extracted
      value.
      """,
      def_output_stream,
      large_block = True
    )
    def_output_stream.write('{\n')
    bitshift = registry.get_tagged_bitshift_by_type(type_name)
    def_output_stream.write(f"  return versioned >> {bitshift};\n")
    edgcppgen.write_function_def_end(function_name, def_output_stream)

  def _write_tagged_decode(self, type_name, version, split_output_stream):
    # Generate the _sort function
    self._write_tagged_sort_decode(
      type_name,
      version,
      split_output_stream
    )

    split_output_stream.get_decl().write('\n')
    split_output_stream.get_def().write('\n\n')

    # Generate the _value function
    self._write_tagged_value_decode(
      type_name,
      version,
      split_output_stream
    )

  def _write_universal_index_type(self, type_name, output_stream):
    edgcppgen.write_comment(
      f"""
      The universal representation for an IFC {type_name}.
      """,
      output_stream,
      large_block = True
    )
    universal_name = self._get_universal_name(type_name)
    universal_sort_name = self._get_universal_sort_name(type_name)
    largest_type_size = self.agg_type_info.get_largest_type_size(type_name)
    native_size_type = edgcppgen.size_to_uint(largest_type_size)
    edgcppgen.write_splitable(
      [
        f"struct {universal_name} :",
        ' Index_entry<',
        f"{universal_sort_name}, {native_size_type}> {{"
      ],
      output_stream
    )
    edgcppgen.write_right_split(
      '  using sort_type =',
      f"{universal_sort_name};",
      output_stream
    )
    edgcppgen.write_right_split(
      '  using native_size_type =',
      f"{native_size_type};",
      output_stream
    )
    output_stream.write(
      '  using base_type = Index_entry<sort_type, native_size_type>;\n',
    )
    output_stream.write('  using base_type::Index_entry;\n')
    output_stream.write(f"}};  /* {universal_name} */\n")

  def _write_universal_index_type_operators(self, type_name, output_stream):
    universal_name = self._get_universal_name(type_name)

    edgcppgen.write_operator_decl(
      '==',
      'a_boolean',
      [
        (f"const {universal_name}&", 'lhs'),
        (f"const {universal_name}&", 'rhs')
      ],
      output_stream
    )
    edgcppgen.write_comment(
      f"""
      Compare two instances of this {type_name} (lhs and rhs). If the two
      instances are equivalent, return TRUE; otherwise return FALSE.
      """,
      output_stream,
      large_block = True
    )
    output_stream.write('{\n')
    edgcppgen.write_variable_block(
      [
        ('a_boolean', 'result', 'TRUE')
      ],
      output_stream
    )
    edgcppgen.write_comment(
      f"""
      Check members that are more likely to be unique first. This allows
      the logic to short circuit in common negative cases.
      """,
      output_stream,
      indent = '  '
    )
    branch_writer = edgcppgen.BranchWriter()
    branch_writer.add_branch('lhs.value != rhs.value', ['result = FALSE;'])
    branch_writer.add_branch('lhs.sort != rhs.sort', ['result = FALSE;'])
    branch_writer.add_branch('lhs.file != rhs.file', ['result = FALSE;'])
    branch_writer.write(output_stream)
    output_stream.write('  return result;\n')
    edgcppgen.write_operator_def_end('==', output_stream)

    output_stream.write('\n\n')

    edgcppgen.write_operator_decl(
      '!=',
      'a_boolean',
      [
        (f"const {universal_name}&", 'lhs'),
        (f"const {universal_name}&", 'rhs')
      ],
      output_stream
    )
    edgcppgen.write_comment(
      f"""
      Compare two instances of this {type_name} (lhs and rhs). If the two
      instances are equivalent, return FALSE; otherwise return TRUE.
      """,
      output_stream,
      large_block = True
    )
    output_stream.write('{\n')
    output_stream.write('  return !(lhs == rhs);\n')
    edgcppgen.write_operator_def_end('!=', output_stream)

  def _write_universal_index(self, type_name, split_output_stream):
    type_output_stream = split_output_stream.get_type()

    self._write_universal_index_type(type_name, type_output_stream)

    type_output_stream.write('\n\n')

    self._write_universal_index_type_operators(type_name, type_output_stream)

  def _write_index_type(self, type_name, version, output_stream):
    versioned_name = self._get_versioned_name(type_name, version)

    registry = self.version_to_registry[version]
    type_size = registry.get_type(type_name).size()
    native_size_type = edgcppgen.size_to_uint(type_size)

    output_stream.write(f"enum {versioned_name} : {native_size_type} {{}};\n")

  def _write_index_validation(self, type_name, version, split_output_stream):
    versioned_type_name = self._get_versioned_name(type_name, version)

    function_name = 'validate_index'
    function_decl_args = [
      function_name,
      'a_boolean',
      [
        ('an_ifc_module_file*', 'file'),
        (versioned_type_name, 'versioned'),
        ('const an_ifc_validation_trace*', 'parent')
      ]
    ]
    decl_output_stream = split_output_stream.get_decl()
    edgcppgen.write_function_decl(
      *function_decl_args,
      decl_output_stream,
      specifiers = ['extern'],
      terminator = ');'
    )

    def_output_stream = split_output_stream.get_val_def()
    edgcppgen.write_function_decl(
      *function_decl_args,
      def_output_stream,
      specifiers = []
    )
    edgcppgen.write_comment(
      f"""
      Given the versioned representation of {type_name} and the associated
      module file, return TRUE if the value represents a valid node position;
      otherwise, return FALSE.
      """,
      def_output_stream,
      large_block = True
    )
    def_output_stream.write('{\n')

    versioned_sort_name = self._get_versioned_sort_name(type_name, version)
    index_name = self._get_bare_name(type_name)

    edgcppgen.write_variable_block(
      [
        ('a_boolean', 'result', 'TRUE'),
        (versioned_sort_name, 'sort', f"{index_name}_sort(versioned)")
      ],
      def_output_stream
    )

    writer = edgcppgen.BranchWriter()
    writer.add_branch(
      f"!is_known_sort(sort)",
      ['invalid_partition(file, parent);', 'result = FALSE;']
    )

    if self.agg_type_info.has_any_partition_info_for_index(type_name):
      universal_sort_name = self._get_universal_sort_name(type_name)
      partition_vars = edgcppgen.VariableBlockWriter(
        [
          (universal_sort_name, 'univ_sort', 'to_universal_sort(sort)')
        ]
      )

      largest_type_size = self.agg_type_info.get_largest_type_size(type_name)
      underlying_value_type = edgcppgen.size_to_uint(largest_type_size)

      partition_validation_vars = edgcppgen.VariableBlockWriter(
        [
          ('an_ifc_partition_kind', 'kind', 'to_partition_kind(univ_sort)'),
          (underlying_value_type, 'value', f"{index_name}_value(versioned)")
        ]
      )

      element_presence_check_writer = edgcppgen.BranchWriter()
      element_presence_check_writer.add_branch(
        '!validate_element_exists(file, kind, value, parent)',
        ['result = FALSE;']
      )

      partition_check_branch_writer = edgcppgen.BranchWriter()
      partition_check_branch_writer.add_branch(
        'has_partition_kind(univ_sort)',
        [
          partition_validation_vars,
          element_presence_check_writer
        ]
      )

      universal_type_name = self._get_universal_name(type_name)
      partition_conversion_vars = edgcppgen.VariableBlockWriter(
        [
          (
            universal_type_name,
            'univ_idx',
            'to_universal_index(file, versioned)'
          )
        ]
      )

      partition_conversion_check_branch_writer = edgcppgen.BranchWriter()

      # FIXME: Replace this with more generalized logic
      sort_type_name = self._get_sort_type_name(type_name)
      if sort_type_name == 'NameSort':
        partition_conversion_check_branch_writer.add_branch(
          'univ_idx.sort == ifc_ns_text_offset',
          []
        )
      elif sort_type_name == 'ExprSort':
        partition_conversion_check_branch_writer.add_branch(
          'univ_idx.sort == ifc_es_expr_vendor_extension',
          []
        )
      elif sort_type_name == 'TypeSort':
        partition_conversion_check_branch_writer.add_branch(
          'univ_idx.sort == ifc_ts_type_vendor_extension',
          []
        )

      partition_conversion_check_branch_writer.add_branch(
        '!is_null_index(univ_idx)',
        [
          edgcppgen.FunctionCallExprWriter(
            'unknown_partition_conversion',
            [
              'file',
              'str_for(univ_sort)',
              'univ_idx.value',
              'parent'
            ]
          ),
          'result = FALSE;'
        ]
      )

      partition_check_branch_writer.add_fallback(
        [
          partition_conversion_vars,
          partition_conversion_check_branch_writer
        ]
      )

      writer.add_fallback([partition_vars, partition_check_branch_writer])
    writer.write(def_output_stream)
    def_output_stream.write(
      f"  return result;\n"
    )
    edgcppgen.write_function_def_end(function_name, def_output_stream)

  def _write_index_conversion(self, type_name, version, split_output_stream):
    universal_type_name = self._get_universal_name(type_name)
    universal_sort_name = self._get_universal_sort_name(type_name)
    versioned_type_name = self._get_versioned_name(type_name, version)

    function_name = f"to_universal_index"
    function_decl_args = [
      function_name,
      universal_type_name,
      [
        ('an_ifc_module_file*', 'file'),
        (versioned_type_name, 'versioned')
      ]
    ]
    decl_output_stream = split_output_stream.get_decl()
    edgcppgen.write_function_decl(
      *function_decl_args,
      decl_output_stream,
      specifiers = ['extern'],
      terminator = ');'
    )

    def_output_stream = split_output_stream.get_def()
    edgcppgen.write_function_decl(
      *function_decl_args,
      def_output_stream,
      specifiers = []
    )
    edgcppgen.write_comment(
      f"""
      Given the versioned representation of {type_name} and the associated
      module, return the corresponding universal representation.
      """,
      def_output_stream,
      large_block = True
    )
    def_output_stream.write('{\n')
    index_name = self._get_bare_name(type_name)

    registry = self.version_to_registry[version]

    type_size = registry.get_type(type_name).size()
    native_size_type = edgcppgen.size_to_uint(type_size)

    edgcppgen.write_variable_block(
      [
        (
          universal_sort_name,
          'sort',
          f"to_universal_sort({index_name}_sort(versioned))"
        ),
        (
          native_size_type,
          'index',
          f"{index_name}_value(versioned)"
        )
      ],
      def_output_stream
    )
    def_output_stream.write(
      f"  return {universal_type_name}{{file, sort, index}};\n"
    )
    edgcppgen.write_function_def_end(function_name, def_output_stream)

  def _write_universal_index_type_reencoding(self, type_name, type_versions,
                                             split_output_stream):
    universal_type_name = self._get_universal_name(type_name)
    universal_encoded_type_name = self._get_universal_encoded_name(type_name)

    function_name = 'to_encoded'
    function_decl_args = [
      function_name,
      universal_encoded_type_name,
      [
        ('an_ifc_module_file*', 'file'),
        (universal_type_name, 'universal')
      ]
    ]
    decl_output_stream = split_output_stream.get_decl()
    edgcppgen.write_function_decl(
      *function_decl_args,
      decl_output_stream,
      specifiers = ['extern'],
      terminator = ');'
    )

    def_output_stream = split_output_stream.get_def()
    edgcppgen.write_function_decl(
      *function_decl_args,
      def_output_stream,
      specifiers = []
    )
    edgcppgen.write_comment(
      f"""
      Given the universal representation of {type_name} and the destination
      module file, return a reencoded index value.
      """,
      def_output_stream,
      large_block = True
    )
    def_output_stream.write('{\n')

    sort_type_name = self._get_sort_type_name(type_name)
    encoded_sort_type_name = self._get_universal_encoded_name(sort_type_name)

    edgcppgen.write_variable_block(
      [
        (
          universal_encoded_type_name,
          'result',
          '{file, universal.value}'
        )
      ],
      def_output_stream
    )

    branch_writer = edgcppgen.BranchWriter()
    branch_writer.add_branch(
      'universal.file == NULL',
      ['result.value = 0;']
    )

    encoding_vars =edgcppgen.VariableBlockWriter(
      [
        (
          encoded_sort_type_name,
          'encoded_sort',
          'to_encoded(file, universal.sort)'
        )
      ]
    )

    encoding_writer = CPPVersionBranchWriter()

    last_bitshift = None
    for type_version in type_versions:
      registry = self.version_to_registry[type_version]

      index_reg = registry.get_index_sort_registration_by_type(type_name)
      if index_reg.bitshift == last_bitshift:
        continue
      last_bitshift = index_reg.bitshift

      encoding_writer.add_branch(
        type_version,
        [
          f"result.value <<= {index_reg.bitshift};",
          "result.value |= encoded_sort;"
        ]
      )

    branch_writer.add_fallback([encoding_vars, encoding_writer])
    branch_writer.write(def_output_stream)

    def_output_stream.write(
      f"  return result;\n"
    )
    edgcppgen.write_function_def_end(function_name, def_output_stream)

  def _write_universal_index_type_null_check(self, type_name,
                                             split_output_stream):
    universal_type_name = self._get_universal_name(type_name)

    function_name = f"is_null_index"
    function_decl_args = [
      function_name,
      'a_boolean',
      [
        (universal_type_name, 'universal')
      ]
    ]
    decl_output_stream = split_output_stream.get_decl()
    edgcppgen.write_function_decl(
      *function_decl_args,
      decl_output_stream,
      specifiers = ['extern'],
      terminator = ');'
    )

    def_output_stream = split_output_stream.get_def()
    edgcppgen.write_function_decl(
      *function_decl_args,
      def_output_stream,
      specifiers = []
    )
    edgcppgen.write_comment(
      f"""
      Given the universal representation of {type_name}, return TRUE if the
      given index is considered a null index; otherwise, return FALSE.
      """,
      def_output_stream,
      large_block = True
    )
    def_output_stream.write('{\n')

    edgcppgen.write_variable_block(
      [
        ('a_boolean', 'result', 'FALSE'),
        ('an_ifc_module_file*', 'file', 'universal.file')
      ],
      def_output_stream
    )

    writer = edgcppgen.BranchWriter()
    writer.add_branch(
      'file == NULL',
      ['result = TRUE;']
    )

    version_writer = CPPVersionBranchWriter()
    type_versions = self.revision_info.get_type_versions(type_name)
    last_was_non_null = None
    for type_version in type_versions:
      registry = self.version_to_registry[type_version]
      index_reg = registry.get_index_sort_registration_by_type(type_name)

      if last_was_non_null == index_reg.non_null:
        continue
      last_was_non_null = index_reg.non_null

      if index_reg.non_null:
        comment_writer = edgcppgen.CommentWriter(
          f"""
          Never null by encoding.
          """
        )

        version_writer.add_branch(
          type_version,
          [comment_writer, 'result = FALSE;']
        )
      else:
        to_encoded_call = edgcppgen.FunctionCallExprWriter(
          'result = 0 == to_encoded',
          [
            'file',
            'universal'
          ]
        )
        version_writer.add_branch(type_version, [to_encoded_call])

    writer.add_fallback([version_writer])
    writer.write(def_output_stream)

    def_output_stream.write(
      f"  return result;\n"
    )
    edgcppgen.write_function_def_end(function_name, def_output_stream)

  def _write_index_instantiations(self, type_name, split_output_stream):
    if not self.agg_type_info.has_any_partition_info_for_index(type_name):
      return

    inst_output_stream = split_output_stream.get_tmpl_inst()

    inst_output_stream.write('\n\n')

    edgcppgen.write_comment(
      f"""
      Explicit instantiations of functions for {type_name}.
      """,
      inst_output_stream,
      large_block = True
    )

    universal_type_name = self._get_universal_name(type_name)
    edgcppgen.FunctionCallExprWriter(
      'INST_PARTITION_ALL',
      [
        universal_type_name
      ],
      terminator = ')\n'
    ).write(inst_output_stream)

  def _write_index_sort(self, type_name, split_output_stream):
    type_output_stream = split_output_stream.get_type()
    decl_output_stream = split_output_stream.get_decl()
    def_output_stream = split_output_stream.get_def()

    type_versions = self.revision_info.get_type_versions(type_name)
    type_output_stream.write('\n\n')
    for version in type_versions:
      self._write_index_type(type_name, version, type_output_stream)

    type_output_stream.write('\n\n')
    self._write_universal_index(type_name, split_output_stream)

    intro_block = (
      f"""
      Functions for interacting with IFC {type_name} indexes.
      """
    )
    def_output_stream.write('\n\n')
    edgcppgen.write_comment(
      intro_block,
      def_output_stream,
      large_block = True
    )
    decl_output_stream = split_output_stream.get_decl()
    decl_output_stream.write('\n')
    edgcppgen.write_comment(
      intro_block,
      decl_output_stream,
      large_block = True
    )

    for version in type_versions:
      decl_output_stream.write('\n')
      def_output_stream.write('\n\n')
      self._write_tagged_decode(type_name, version, split_output_stream)
      decl_output_stream.write('\n')
      split_output_stream.get_val_def().write('\n\n')
      self._write_index_validation(type_name, version, split_output_stream)
      decl_output_stream.write('\n')
      def_output_stream.write('\n\n')
      self._write_index_conversion(type_name, version, split_output_stream)

    decl_output_stream.write('\n')
    def_output_stream.write('\n\n')

    self._write_universal_index_type_reencoding(
      type_name,
      type_versions,
      split_output_stream
    )

    decl_output_stream.write('\n')
    def_output_stream.write('\n\n')

    self._write_universal_index_type_null_check(
      type_name,
      split_output_stream
    )

    self._write_index_instantiations(type_name, split_output_stream)

  def _write_index_alias_type(self, split_output_stream):
    type_output_stream = split_output_stream.get_type()
    type_output_stream.write('\n\n')

    edgcppgen.write_comment(
      f"""
      A type representing the largest possible index size for any index.
      """,
      type_output_stream,
      large_block = True
    )

    underlying_type_name = edgcppgen.size_to_uint(
      self.agg_type_info.get_largest_index_type_size()
    )
    type_output_stream.write(
      f"using an_ifc_index_type = {underlying_type_name};",
    )

  def _write_node_offset_type(self, type_name, version, output_stream):
    versioned_name = self._get_versioned_name(type_name, version)

    registry = self.version_to_registry[version]
    type_size = registry.get_type(type_name).size()
    native_size_type = edgcppgen.size_to_uint(type_size)

    output_stream.write(f"enum {versioned_name} : {native_size_type} {{}};\n")

  def _write_universal_node_offset_type(self, type_name, output_stream):
    edgcppgen.write_comment(
      f"""
      The universal representation for an IFC {type_name}.
      """,
      output_stream,
      large_block = True
    )
    universal_name = self._get_universal_name(type_name)
    node_type_name, _ = (
      self.agg_type_info.get_type_partition_for_node_offset_type(type_name)
    )
    universal_node_type_name = self._get_universal_name(node_type_name)
    largest_type_size = self.agg_type_info.get_largest_type_size(type_name)
    native_size_type = edgcppgen.size_to_uint(largest_type_size)
    edgcppgen.write_splitable(
      [
        f"struct {universal_name} :",
        ' Offset_entry<',
        f"{universal_node_type_name}, {native_size_type}> {{"
      ],
      output_stream
    )
    edgcppgen.write_right_split(
      '  using node_type =',
      f"{universal_node_type_name};\n",
      output_stream
    )
    edgcppgen.write_right_split(
      '  using native_size_type =',
      f"{native_size_type};",
      output_stream
    )
    output_stream.write(
      '  using base_type = Offset_entry<node_type, native_size_type>;\n',
    )
    output_stream.write('  using base_type::Offset_entry;\n')
    output_stream.write(f"}};  /* {universal_name} */\n")

  def _write_universal_node_offset_type_operators(self, type_name,
                                                  output_stream):
    universal_name = self._get_universal_name(type_name)

    edgcppgen.write_operator_decl(
      '==',
      'a_boolean',
      [
        (f"const {universal_name}&", 'lhs'),
        (f"const {universal_name}&", 'rhs')
      ],
      output_stream
    )
    edgcppgen.write_comment(
      f"""
      Compare two instances of this {type_name} (lhs and rhs). If the two
      instances are equivalent, return TRUE; otherwise return FALSE.
      """,
      output_stream,
      large_block = True
    )
    output_stream.write('{\n')
    edgcppgen.write_variable_block(
      [
        ('a_boolean', 'result', 'TRUE')
      ],
      output_stream
    )
    edgcppgen.write_comment(
      f"""
      Check members that are more likely to be unique first. This allows
      the logic to short circuit in common negative cases.
      """,
      output_stream,
      indent = '  '
    )
    branch_writer = edgcppgen.BranchWriter()
    branch_writer.add_branch('lhs.value != rhs.value', ['result = FALSE;'])
    branch_writer.add_branch('lhs.file != rhs.file', ['result = FALSE;'])
    branch_writer.write(output_stream)
    output_stream.write('  return result;\n')
    edgcppgen.write_operator_def_end('==', output_stream)

    output_stream.write('\n\n')

    edgcppgen.write_operator_decl(
      '!=',
      'a_boolean',
      [
        (f"const {universal_name}&", 'lhs'),
        (f"const {universal_name}&", 'rhs')
      ],
      output_stream
    )
    edgcppgen.write_comment(
      f"""
      Compare two instances of this {type_name} (lhs and rhs). If the two
      instances are equivalent, return FALSE; otherwise return TRUE.
      """,
      output_stream,
      large_block = True
    )
    output_stream.write('{\n')
    output_stream.write('  return !(lhs == rhs);\n')
    edgcppgen.write_operator_def_end('!=', output_stream)

  def _write_universal_node_offset(self, type_name, split_output_stream):
    type_output_stream = split_output_stream.get_type()

    self._write_universal_node_offset_type(type_name, type_output_stream)

    type_output_stream.write('\n\n')

    self._write_universal_node_offset_type_operators(
      type_name,
      type_output_stream
    )

  def _write_universal_node_offset_type_reencoding(self, type_name,
                                                   type_versions,
                                                   split_output_stream):
    universal_type_name = self._get_universal_name(type_name)
    universal_encoded_type_name = self._get_universal_encoded_name(type_name)

    function_name = 'to_encoded'
    function_decl_args = [
      function_name,
      universal_encoded_type_name,
      [
        ('an_ifc_module_file*', 'file'),
        (universal_type_name, 'universal')
      ]
    ]
    decl_output_stream = split_output_stream.get_decl()
    edgcppgen.write_function_decl(
      *function_decl_args,
      decl_output_stream,
      specifiers = ['extern'],
      terminator = ');'
    )

    def_output_stream = split_output_stream.get_def()
    edgcppgen.write_function_decl(
      *function_decl_args,
      def_output_stream,
      specifiers = []
    )
    edgcppgen.write_comment(
      f"""
      Given the universal representation of {type_name} and the destination
      module file, return a reencoded index value.
      """,
      def_output_stream,
      large_block = True
    )
    def_output_stream.write('{\n')

    edgcppgen.write_variable_block(
      [
        (
          universal_encoded_type_name,
          'result',
          '{file, universal.value}'
        )
      ],
      def_output_stream
    )

    writer = CPPVersionBranchWriter()

    last_non_null = None
    for type_version in type_versions:
      registry = self.version_to_registry[type_version]

      offset_reg = registry.get_node_offset_registration_by_type(type_name)
      if offset_reg.non_null == last_non_null:
        continue
      last_non_null = offset_reg.non_null

      if offset_reg.non_null:
        comment_writer = edgcppgen.CommentWriter(
          '''
          This offset never contains a null value in its encoded form,
          decrease all values by one.
          '''
        )
        assertion_check = edgcppgen.FunctionCallExprWriter(
          'check_assertion',
          [
            'result.value != 0'
          ]
        )

        writer.add_branch(
          type_version,
          [
            comment_writer,
            assertion_check,
            '--result.value;'
          ]
        )
      else:
        comment_writer = edgcppgen.CommentWriter(
          '''
          This offset contains a null value in its encoded form,
          do not modify its value.
          '''
        )
        writer.add_branch(
          type_version,
          [
            comment_writer
          ]
        )

    writer.write(def_output_stream)

    def_output_stream.write(
      f"  return result;\n"
    )
    edgcppgen.write_function_def_end(function_name, def_output_stream)

  def _write_universal_node_offset_type_null_check(self, type_name,
                                                   split_output_stream):
    universal_type_name = self._get_universal_name(type_name)

    function_name = f"is_null_index"
    function_decl_args = [
      function_name,
      'a_boolean',
      [
        (universal_type_name, 'universal')
      ]
    ]
    decl_output_stream = split_output_stream.get_decl()
    edgcppgen.write_function_decl(
      *function_decl_args,
      decl_output_stream,
      specifiers = ['extern'],
      terminator = ');'
    )

    def_output_stream = split_output_stream.get_def()
    edgcppgen.write_function_decl(
      *function_decl_args,
      def_output_stream,
      specifiers = []
    )
    edgcppgen.write_comment(
      f"""
      Given the universal representation of {type_name}, return TRUE if the
      given offset is considered a null index; otherwise, return FALSE.
      """,
      def_output_stream,
      large_block = True
    )
    def_output_stream.write('{\n')
    def_output_stream.write(
      f"  return universal.value == 0;\n"
    )
    edgcppgen.write_function_def_end(function_name, def_output_stream)

  def _write_node_offset_get_partition_specialization(self, type_name,
                                                      split_output_stream):
    universal_type_name = self._get_universal_name(type_name)
    function_name = f"get_ifc_partition_kind<{universal_type_name}>"
    function_decl_args = [
      [],
      function_name,
      'an_ifc_partition_kind',
      []
    ]
    decl_output_stream = split_output_stream.get_decl()
    edgcppgen.write_function_template_decl(
      *function_decl_args,
      decl_output_stream,
      specifiers = [],
      terminator = ');'
    )

    def_output_stream = split_output_stream.get_def()
    edgcppgen.write_function_template_decl(
      *function_decl_args,
      def_output_stream,
      specifiers = []
    )
    edgcppgen.write_comment(
      f"""
      Return the corresponding partition kind for {type_name}.
      """,
      def_output_stream,
      large_block = True
    )
    def_output_stream.write('{\n')
    node_type_name, _ = (
      self.agg_type_info.get_type_partition_for_node_offset_type(
        type_name
      )
    )
    partition_id = self.agg_type_info.get_partition_for_type_name(
      node_type_name
    )
    partition_enumerator = self._get_partition_enumerator(partition_id)
    def_output_stream.write(f"  return {partition_enumerator};\n")
    edgcppgen.write_function_def_end(
      'get_ifc_partition_kind',
      def_output_stream
    )

  def _write_node_offset_validation(self, type_name, version,
                                    split_output_stream):
    versioned_type_name = self._get_versioned_name(type_name, version)

    function_name = 'validate_offset'
    function_decl_args = [
      function_name,
      'a_boolean',
      [
        ('an_ifc_module_file*', 'file'),
        (versioned_type_name, 'versioned'),
        ('const an_ifc_validation_trace*', 'parent')
      ]
    ]
    decl_output_stream = split_output_stream.get_decl()
    edgcppgen.write_function_decl(
      *function_decl_args,
      decl_output_stream,
      specifiers = ['extern'],
      terminator = ');'
    )

    def_output_stream = split_output_stream.get_val_def()
    edgcppgen.write_function_decl(
      *function_decl_args,
      def_output_stream,
      specifiers = []
    )
    edgcppgen.write_comment(
      f"""
      Given the versioned representation of {type_name} and the associated
      module file, return TRUE if the value represents a valid node position;
      otherwise, return FALSE.
      """,
      def_output_stream,
      large_block = True
    )
    def_output_stream.write('{\n')

    universal_type_name = self._get_universal_name(type_name)

    edgcppgen.write_variable_block(
      [
        ('a_boolean', 'result', 'TRUE'),
        (
          universal_type_name,
          'univ_offset',
          'to_universal_offset(file, versioned)'
        )
      ],
      def_output_stream
    )

    largest_type_size = self.agg_type_info.get_largest_type_size(type_name)
    underlying_value_type = edgcppgen.size_to_uint(largest_type_size)

    partition_validation_vars = edgcppgen.VariableBlockWriter(
      [
        (
          'an_ifc_partition_kind',
          'kind',
          f"get_ifc_partition_kind<{universal_type_name}>()"
        ),
        (underlying_value_type, 'value', 'univ_offset.value - 1')
      ]
    )
    element_presence_check_writer = edgcppgen.BranchWriter()

    element_presence_check_writer.add_branch(
      '!validate_element_exists(file, kind, value, parent)',
      ['result = FALSE;']
    )

    writer = edgcppgen.BranchWriter()
    writer.add_branch(
      '!is_null_index(univ_offset)',
      [partition_validation_vars, element_presence_check_writer]
    )
    writer.write(def_output_stream)
    def_output_stream.write(
      f"  return result;\n"
    )
    edgcppgen.write_function_def_end(function_name, def_output_stream)

  def _write_node_offset_conversion(self, type_name, version,
                                    split_output_stream):
    universal_type_name = self._get_universal_name(type_name)
    universal_sort_name = self._get_universal_sort_name(type_name)
    versioned_type_name = self._get_versioned_name(type_name, version)

    function_name = 'to_universal_offset'
    function_decl_args = [
      function_name,
      universal_type_name,
      [
        ('an_ifc_module_file*', 'file'),
        (versioned_type_name, 'versioned')
      ]
    ]
    decl_output_stream = split_output_stream.get_decl()
    edgcppgen.write_function_decl(
      *function_decl_args,
      decl_output_stream,
      specifiers = ['extern'],
      terminator = ');'
    )

    def_output_stream = split_output_stream.get_def()
    edgcppgen.write_function_decl(
      *function_decl_args,
      def_output_stream,
      specifiers = []
    )
    edgcppgen.write_comment(
      f"""
      Given the versioned representation of {type_name} and the associated
      module, return the corresponding universal representation.
      """,
      def_output_stream,
      large_block = True
    )
    def_output_stream.write('{\n')

    registry = self.version_to_registry[version]

    type_size = registry.get_type(type_name).size()
    native_size_type = edgcppgen.size_to_uint(type_size)

    edgcppgen.write_variable_block(
      [
        (native_size_type, 'index', 'versioned')
      ],
      def_output_stream
    )
    offset_reg = registry.get_node_offset_registration_by_type(type_name)
    if offset_reg.non_null:
      edgcppgen.write_comment(
        '''
        This offset never contains a null value in its encoded form, normalize
        it by increasing all values by one.
        ''',
        def_output_stream,
        indent = '  '
      )
      def_output_stream.write('  index += 1;\n')
    def_output_stream.write(
      f"  return {universal_type_name}{{file, index}};\n"
    )
    edgcppgen.write_function_def_end(function_name, def_output_stream)

  def _write_node_offset_specializations(self, type_name, split_output_stream):
    spec_output_stream = split_output_stream.get_tmpl_spec()

    spec_output_stream.write('\n\n')

    edgcppgen.write_comment(
      f"""
      Explicit specializations of functions for {type_name}.
      """,
      spec_output_stream,
      large_block = True
    )

    universal_type_name = self._get_universal_name(type_name)
    edgcppgen.FunctionCallExprWriter(
      'SPEC_OFFSET_PARTITION_KIND',
      [
        universal_type_name
      ],
      terminator = ')\n'
    ).write(spec_output_stream)
    edgcppgen.FunctionCallExprWriter(
      'SPEC_OFFSET_PARTITION_INDEX',
      [
        universal_type_name
      ],
      terminator = ')\n'
    ).write(spec_output_stream)

  def _write_node_offset_instantiations(self, type_name, split_output_stream):
    inst_output_stream = split_output_stream.get_tmpl_inst()

    inst_output_stream.write('\n\n')

    edgcppgen.write_comment(
      f"""
      Explicit instantiations of functions for {type_name}.
      """,
      inst_output_stream,
      large_block = True
    )

    universal_type_name = self._get_universal_name(type_name)
    edgcppgen.FunctionCallExprWriter(
      'INST_PARTITION_ALL',
      [
        universal_type_name
      ],
      terminator = ')\n'
    ).write(inst_output_stream)

  def _write_node_offset(self, type_name, split_output_stream):
    type_output_stream = split_output_stream.get_type()
    def_output_stream = split_output_stream.get_def()
    decl_output_stream = split_output_stream.get_decl()

    type_versions = self.revision_info.get_type_versions(type_name)
    type_output_stream.write('\n\n')
    for version in type_versions:
      self._write_node_offset_type(type_name, version, type_output_stream)

    type_output_stream.write('\n\n')
    self._write_universal_node_offset(type_name, split_output_stream)

    intro_block = (
      f"""
      Functions for interacting with IFC {type_name} offsets.
      """
    )
    def_output_stream.write('\n\n')
    edgcppgen.write_comment(
      intro_block,
      def_output_stream,
      large_block = True
    )
    decl_output_stream.write('\n')
    edgcppgen.write_comment(
      intro_block,
      decl_output_stream,
      large_block = True
    )

    decl_output_stream.write('\n')
    def_output_stream.write('\n\n')

    self._write_universal_node_offset_type_reencoding(
      type_name,
      type_versions,
      split_output_stream
    )

    decl_output_stream.write('\n')
    def_output_stream.write('\n\n')

    self._write_universal_node_offset_type_null_check(
      type_name,
      split_output_stream
    )

    decl_output_stream.write('\n')
    def_output_stream.write('\n\n')

    self._write_node_offset_get_partition_specialization(
      type_name,
      split_output_stream
    )

    for version in type_versions:
      decl_output_stream.write('\n')
      split_output_stream.get_val_def().write('\n\n')
      self._write_node_offset_validation(
        type_name,
        version,
        split_output_stream
      )
      decl_output_stream.write('\n')
      def_output_stream.write('\n\n')
      self._write_node_offset_conversion(type_name, version,
                                         split_output_stream)

    self._write_node_offset_specializations(type_name, split_output_stream)
    self._write_node_offset_instantiations(type_name, split_output_stream)

  def _write_string_table_offset(self, type_name, split_output_stream):
    self._write_raw_numeric(
      type_name,
      split_output_stream,
      allow_implicit_conversion = True
    )

  def _write_foreign_index_validation(self, type_name, version,
                                      split_output_stream):
    versioned_type_name = self._get_versioned_name(type_name, version)

    function_name = 'validate_index'
    function_decl_args = [
      function_name,
      'a_boolean',
      [
        ('an_ifc_module_file*', 'file'),
        (versioned_type_name, 'versioned'),
        ('const an_ifc_validation_trace*', 'parent')
      ]
    ]
    decl_output_stream = split_output_stream.get_decl()
    edgcppgen.write_function_decl(
      *function_decl_args,
      decl_output_stream,
      specifiers = [],
      terminator = ');'
    )

    def_output_stream = split_output_stream.get_val_def()
    edgcppgen.write_function_decl(
      *function_decl_args,
      def_output_stream,
      specifiers = []
    )
    edgcppgen.write_comment(
      f"""
      Given the versioned representation of {type_name} and the associated
      module file where the indexed value is stored, return TRUE if the index
      value represents a valid index position; otherwise, return FALSE.
      """,
      def_output_stream,
      large_block = True
    )
    def_output_stream.write('{\n')

    edgcppgen.write_variable_block(
      [
        ('a_boolean', 'result', 'TRUE')
      ],
      def_output_stream
    )

    writer = CPPVersionBranchWriter()
    index_type_name = self._get_native_index_name(type_name)
    index_versions = self.revision_info.get_type_versions(index_type_name)
    for index_version in index_versions:
      index_versioned_type_name = self._get_versioned_name(
        index_type_name,
        index_version
      )
      branch_vars = edgcppgen.VariableBlockWriter(
        [
          (
            index_versioned_type_name,
            'versioned_index',
            f"({index_versioned_type_name})versioned"
          )
        ]
      )

      writer.add_branch(
        index_version,
        [
          branch_vars,
          "result = validate_index(file, versioned_index, parent);"
        ]
      )

    writer.write(def_output_stream)
    def_output_stream.write(
      f"  return result;\n"
    )
    edgcppgen.write_function_def_end(function_name, def_output_stream)

  def _write_foreign_index_conversion(self, type_name, version,
                                      split_output_stream):
    index_type_name = self._get_native_index_name(type_name)
    universal_type_name = self._get_universal_name(index_type_name)
    versioned_type_name = self._get_versioned_name(type_name, version)

    function_name = f"to_universal_index"
    function_decl_args = [
      function_name,
      universal_type_name,
      [
        ('an_ifc_module_file*', 'file'),
        (versioned_type_name, 'versioned')
      ]
    ]
    decl_output_stream = split_output_stream.get_decl()
    edgcppgen.write_function_decl(
      *function_decl_args,
      decl_output_stream,
      specifiers = ['extern'],
      terminator = ');'
    )

    def_output_stream = split_output_stream.get_def()
    edgcppgen.write_function_decl(
      *function_decl_args,
      def_output_stream,
      specifiers = []
    )
    edgcppgen.write_comment(
      f"""
      Given the foreign representation of {type_name} and the associated
      module file, return the corresponding universal representation.
      """,
      def_output_stream,
      large_block = True
    )
    def_output_stream.write('{\n')

    edgcppgen.write_variable_block(
      [
        (universal_type_name, 'result', None)
      ],
      def_output_stream
    )

    writer = CPPVersionBranchWriter()
    index_versions = self.revision_info.get_type_versions(index_type_name)
    for index_version in index_versions:
      index_versioned_type_name = self._get_versioned_name(
        index_type_name,
        index_version
      )
      branch_vars = edgcppgen.VariableBlockWriter(
        [
          (
            index_versioned_type_name,
            'versioned_index',
            f"({index_versioned_type_name})versioned"
          )
        ]
      )

      writer.add_branch(
        index_version,
        [
          branch_vars,
          "result = to_universal_index(file, versioned_index);"
        ]
      )

    writer.write(def_output_stream)
    def_output_stream.write(
      f"  return result;\n"
    )
    edgcppgen.write_function_def_end(function_name, def_output_stream)

  def _write_universal_foreign_index_validation(self, type_name, type_versions,
                                                split_output_stream):
    universal_type_name = self._get_universal_name(type_name)

    function_name = 'validate_index'
    function_decl_args = [
      function_name,
      'a_boolean',
      [
        ('an_ifc_module_file*', 'foreign_file'),
        (universal_type_name, 'universal'),
        ('const an_ifc_validation_trace*', 'parent')
      ]
    ]
    decl_output_stream = split_output_stream.get_decl()
    edgcppgen.write_function_decl(
      *function_decl_args,
      decl_output_stream,
      specifiers = ['extern'],
      terminator = ');'
    )

    def_output_stream = split_output_stream.get_val_def()
    edgcppgen.write_function_decl(
      *function_decl_args,
      def_output_stream,
      specifiers = []
    )
    edgcppgen.write_comment(
      f"""
      Given the universal foreign representation of {type_name} and the foreign
      module file (which owns the interpretation of the foreign
      representation), return TRUE if the index value represents a valid
      index position; otherwise, return FALSE.
      """,
      def_output_stream,
      large_block = True
    )
    def_output_stream.write('{\n')

    edgcppgen.write_variable_block(
      [
        ('a_boolean', 'result', 'TRUE')
      ],
      def_output_stream
    )

    writer = CPPVersionBranchWriter(file_ref = 'universal.file')
    for type_version in type_versions:
      versioned_type_name = self._get_versioned_name(type_name, type_version)

      branch_vars = edgcppgen.VariableBlockWriter(
        [
          (
            versioned_type_name,
            'versioned_index',
            f"({versioned_type_name})universal.value"
          )
        ]
      )

      writer.add_branch(
        type_version,
        [
          branch_vars,
          f"result = validate_index(foreign_file, versioned_index, parent);"
        ]
      )

    writer.write(def_output_stream)
    def_output_stream.write(
      f"  return result;\n"
    )
    edgcppgen.write_function_def_end(function_name, def_output_stream)

  def _write_universal_foreign_index_conversion(self, type_name, type_versions,
                                                split_output_stream):
    universal_type_name = self._get_universal_name(type_name)
    index_type_name = self._get_native_index_name(type_name)
    universal_native_type_name = self._get_universal_name(index_type_name)

    function_name = f"to_universal_index"
    function_decl_args = [
      function_name,
      universal_native_type_name,
      [
        ('an_ifc_module_file*', 'foreign_file'),
        (universal_type_name, 'universal')
      ]
    ]
    decl_output_stream = split_output_stream.get_decl()
    edgcppgen.write_function_decl(
      *function_decl_args,
      decl_output_stream,
      specifiers = ['extern'],
      terminator = ');'
    )

    def_output_stream = split_output_stream.get_def()
    edgcppgen.write_function_decl(
      *function_decl_args,
      def_output_stream,
      specifiers = []
    )
    edgcppgen.write_comment(
      f"""
      Given the universal foreign representation of {type_name} and the foreign
      module file (which owns the interpretation of the foreign
      representation), return the corresponding universal representation of the
      index.
      """,
      def_output_stream,
      large_block = True
    )
    def_output_stream.write('{\n')

    edgcppgen.write_variable_block(
      [
        (universal_native_type_name, 'result', None)
      ],
      def_output_stream
    )

    writer = CPPVersionBranchWriter(file_ref = 'universal.file')
    for type_version in type_versions:
      versioned_type_name = self._get_versioned_name(type_name, type_version)

      branch_vars = edgcppgen.VariableBlockWriter(
        [
          (
            versioned_type_name,
            'versioned_index',
            f"({versioned_type_name})universal.value"
          )
        ]
      )

      writer.add_branch(
        type_version,
        [
          branch_vars,
          f"result = to_universal_index(foreign_file, versioned_index);"
        ]
      )

    writer.write(def_output_stream)
    def_output_stream.write('  return result;\n')
    edgcppgen.write_function_def_end(function_name, def_output_stream)

  def _write_foreign_index(self, type_name, split_output_stream):
    self._write_raw_numeric(
      type_name,
      split_output_stream,
      allow_implicit_conversion = False
    )

    def_output_stream = split_output_stream.get_def()

    intro_block = (
      f"""
      Functions for interacting with IFC {type_name} indexes.
      """
    )
    def_output_stream.write('\n\n')
    edgcppgen.write_comment(
      intro_block,
      def_output_stream,
      large_block = True
    )
    decl_output_stream = split_output_stream.get_decl()
    decl_output_stream.write('\n')
    edgcppgen.write_comment(
      intro_block,
      decl_output_stream,
      large_block = True
    )

    type_versions = self.revision_info.get_type_versions(type_name)
    for version in type_versions:
      decl_output_stream.write('\n')
      split_output_stream.get_val_def().write('\n\n')
      self._write_foreign_index_validation(
        type_name,
        version,
        split_output_stream
      )
      decl_output_stream.write('\n')
      def_output_stream.write('\n\n')
      self._write_foreign_index_conversion(
        type_name,
        version,
        split_output_stream
      )

    decl_output_stream.write('\n')
    split_output_stream.get_val_def().write('\n\n')
    self._write_universal_foreign_index_validation(
      type_name,
      type_versions,
      split_output_stream
    )
    decl_output_stream.write('\n')
    def_output_stream.write('\n\n')
    self._write_universal_foreign_index_conversion(
      type_name,
      type_versions,
      split_output_stream
    )

  def _get_bitshift_representation(self, numeric_value):
    if numeric_value == 0:
      return '0'

    original_numeric_value = numeric_value
    # Start at negative one to avoid needing to subtract one from the final
    # count to get the number of shifts
    counter = -1
    while numeric_value > 0:
      numeric_value >>= 1
      counter += 1

    # Check to ensure this wasn't a lossy operation (i.e., make sure this isn't
    # a weird case where the field relies on multiple bits being set).
    if (1 << counter) == original_numeric_value:
      return f"1 << {counter}"

    # Fallback to a hex representation
    return hex(original_numeric_value)

  def _write_bitfield_revision(self, type_name, version, output_stream):
    registry = self.version_to_registry[version]

    versioned_name = self._get_versioned_name(type_name, version)

    enumerators = []
    bitfield_dict = registry.get_bitfield_registration_by_type(type_name)
    for value, name in  bitfield_dict.items():
      formatted_name = self._get_versioned_enumerator(type_name, name, version)
      bitshift_rep_value = self._get_bitshift_representation(value)
      enumerators.append((formatted_name, bitshift_rep_value))

    sort_size = registry.get_type(type_name).size()
    sort_size_type = edgcppgen.size_to_uint(sort_size)
    edgcppgen.write_enumeration(
      versioned_name,
      enumerators,
      output_stream,
      size_type = sort_size_type
    )

  def _get_bitfield_query_name(self, type_name):
    bitfield_universal_name = self._get_universal_name(type_name)
    return f"{bitfield_universal_name}_query"

  def _write_bitfield_query_type(self, type_name, output_stream):
    unique_queries = self.agg_type_info.get_bitfield_queries(type_name)

    query_type_name = self._get_bitfield_query_name(type_name)

    enumerators = []
    counter = 0
    for query in unique_queries:
      formatted_query_name = self._get_universal_enumerator(type_name, query)
      enumerators.append((formatted_query_name, f"1 << {counter}"))
      counter += 1

    edgcppgen.write_enumeration(
      query_type_name,
      enumerators,
      output_stream
    )

  def _write_bitfield_query_operators(self, type_name, output_stream):
    query_name = self._get_bitfield_query_name(type_name)

    edgcppgen.write_operator_decl(
      '|',
      query_name,
      [
        (f"const {query_name}&", 'lhs'),
        (f"const {query_name}&", 'rhs')
      ],
      output_stream,
      specifiers = ['constexpr']
    )
    edgcppgen.write_comment(
      f"""
      Perform a bitor operation on the given arguments.
      """,
      output_stream,
      large_block = True
    )
    output_stream.write('{\n')
    edgcppgen.write_right_split(
      f"  return ({query_name})(",
      '(uint64_t)lhs | (uint64_t)rhs);\n',
      output_stream,
      inline_join = ''
    )
    edgcppgen.write_operator_def_end('|', output_stream)

  def _write_universal_bitfield_type_null_check(self, type_name, type_versions,
                                                split_output_stream):
    universal_type_name = self._get_universal_name(type_name)

    function_name = f"is_null_bitfield"
    function_decl_args = [
      function_name,
      'a_boolean',
      [
        (universal_type_name, 'universal')
      ]
    ]
    decl_output_stream = split_output_stream.get_decl()
    edgcppgen.write_function_decl(
      *function_decl_args,
      decl_output_stream,
      specifiers = ['extern'],
      terminator = ');'
    )

    def_output_stream = split_output_stream.get_def()
    edgcppgen.write_function_decl(
      *function_decl_args,
      def_output_stream,
      specifiers = []
    )
    edgcppgen.write_comment(
      f"""
      Given the universal representation of {type_name}, return TRUE if the
      given bitfield is considered a null index; otherwise, return FALSE.
      """,
      def_output_stream,
      large_block = True
    )
    def_output_stream.write('{\n')

    edgcppgen.write_variable_block(
      [
        ('a_boolean', 'result', 'FALSE')
      ],
      def_output_stream
    )

    writer = edgcppgen.BranchWriter()
    writer.add_branch(
      'universal.file == NULL || universal.value == 0',
      ['result = TRUE;']
    )
    writer.write(def_output_stream)

    def_output_stream.write(
      f"  return result;\n"
    )
    edgcppgen.write_function_def_end(function_name, def_output_stream)

  def _write_bitfield_version_query_conversion(self, type_name, version,
                                               split_output_stream):
    query_type_name = self._get_bitfield_query_name(type_name)

    registry = self.version_to_registry[version]
    bitfield_size = registry.get_type(type_name).size()
    bitfield_size_type = edgcppgen.size_to_uint(bitfield_size)

    function_name = f"to_bitmask_{version.major}_{version.minor}"
    # FIXME: When we move to C++14, this can become constexpr.
    function_decl_args = [
      function_name,
      bitfield_size_type,
      [
        (query_type_name, 'query')
      ]
    ]
    decl_output_stream = split_output_stream.get_decl()
    edgcppgen.write_function_decl(
      *function_decl_args,
      decl_output_stream,
      specifiers = ['extern'],
      terminator = ');'
    )

    def_output_stream = split_output_stream.get_def()
    edgcppgen.write_function_decl(
      *function_decl_args,
      def_output_stream,
      specifiers = []
    )
    edgcppgen.write_comment(
      f"""
      Given the universal representation of a {type_name} bitmask, return the
      corresponding IFC version {version.major}.{version.minor} representation
      of the bitmask.
      """,
      def_output_stream,
      large_block = True
    )
    def_output_stream.write('{\n')

    def_output_stream.write(f"  {bitfield_size_type} result = 0;\n\n")

    registry = self.version_to_registry[version]
    bitfield_dict = registry.get_bitfield_registration_by_type(type_name)
    for enumerator in bitfield_dict.values():
      universal_enumerator = self._get_universal_enumerator(
        type_name,
        enumerator
      )
      def_output_stream.write(f"  if (query & {universal_enumerator}) {{\n")
      versioned_enumerator = self._get_versioned_enumerator(
        type_name,
        enumerator,
        version
      )
      edgcppgen.write_right_split(
        '    result |=',
        f"{versioned_enumerator};",
        def_output_stream
      )
      def_output_stream.write('  }  /* if */\n')

    def_output_stream.write(f"  return result;\n")

    edgcppgen.write_function_def_end(function_name, def_output_stream)

  def _write_bitfield_query_conversion(self, type_name, type_versions,
                                       split_output_stream):
    query_type_name = self._get_bitfield_query_name(type_name)

    largest_type_size = self.agg_type_info.get_largest_type_size(type_name)
    bitfield_size_type = edgcppgen.size_to_uint(largest_type_size)

    function_name = 'to_bitmask'
    # FIXME: When we move to C++14, this can become constexpr.
    function_decl_args = [
      function_name,
      bitfield_size_type,
      [
        ('an_ifc_module_file*', 'file'),
        (query_type_name, 'query')
      ]
    ]
    decl_output_stream = split_output_stream.get_decl()
    edgcppgen.write_function_decl(
      *function_decl_args,
      decl_output_stream,
      specifiers = ['extern'],
      terminator = ');'
    )

    def_output_stream = split_output_stream.get_def()
    edgcppgen.write_function_decl(
      *function_decl_args,
      def_output_stream,
      specifiers = []
    )
    edgcppgen.write_comment(
      f"""
      Given the universal bitmask specified by query, return the corresponding
      matching encoded bits for the given module file.
      """,
      def_output_stream,
      large_block = True
    )
    def_output_stream.write('{\n')

    def_output_stream.write(f"  {bitfield_size_type} result;\n\n")

    writer = CPPVersionBranchWriter()
    for type_version in type_versions:
      registry = self.version_to_registry[type_version]

      to_bitmask_call = edgcppgen.FunctionCallExprWriter(
        f"result = to_bitmask_{type_version.major}_{type_version.minor}",
        [
          'query'
        ]
      )
      writer.add_branch(
        type_version,
        [
          to_bitmask_call
        ]
      )

    writer.write(def_output_stream)
    def_output_stream.write(f"  return result;\n")

    edgcppgen.write_function_def_end(function_name, def_output_stream)

  def _write_bitfield_conversion(self, type_name, split_output_stream):
    universal_name = self._get_universal_name(type_name)
    query_type_name = self._get_bitfield_query_name(type_name)

    function_name = 'test_bitmask'
    function_decl_args = [
      [
        (query_type_name, 'a_Query')
      ],
      function_name,
      'a_boolean',
      [
        (f"const {universal_name}&", 'universal')
      ]
    ]
    decl_output_stream = split_output_stream.get_decl()
    edgcppgen.write_function_template_decl(
      *function_decl_args,
      decl_output_stream
    )
    edgcppgen.write_comment(
      f"""
      Given the universal representation of {type_name}, return TRUE if the
      universal bitmask specified by a_Query matches; otherwise, return FALSE.
      """,
      decl_output_stream,
      large_block = True
    )
    decl_output_stream.write('{\n')

    largest_type_size = self.agg_type_info.get_largest_type_size(type_name)
    bitfield_size_type = edgcppgen.size_to_uint(largest_type_size)

    fn_vars = [
      (
        bitfield_size_type,
        'mask',
        'to_bitmask(universal.get_file(), a_Query)'
      ),
      (
        bitfield_size_type,
        'test_value',
        'universal.value & mask'
      ),
      ('a_boolean', 'result', 'test_value == mask')
    ]
    edgcppgen.write_variable_block(fn_vars, decl_output_stream)

    decl_output_stream.write('  return result;\n')

    edgcppgen.write_function_def_end(function_name, decl_output_stream)

  def _write_bitfield(self, type_name, split_output_stream):
    type_output_stream = split_output_stream.get_type()
    def_output_stream = split_output_stream.get_def()

    type_versions = self.revision_info.get_type_versions(type_name)
    for version in type_versions:
      type_output_stream.write('\n\n')
      self._write_bitfield_revision(type_name, version, type_output_stream)

    type_output_stream.write('\n\n')
    self._write_numeric_storage_type(type_name, type_output_stream)

    type_output_stream.write('\n\n')
    edgcppgen.write_comment(
      f"""
      The universal representation for an IFC {type_name}.
      """,
      type_output_stream,
      large_block = True
    )
    self._write_universal_numeric_type(type_name, type_output_stream)

    type_output_stream.write('\n\n')
    self._write_bitfield_query_type(type_name, type_output_stream)

    intro_block = (
      f"""
      Functions for interacting with IFC {type_name} bitfields.
      """
    )
    def_output_stream.write('\n\n')
    edgcppgen.write_comment(
      intro_block,
      def_output_stream,
      large_block = True
    )
    decl_output_stream = split_output_stream.get_decl()
    decl_output_stream.write('\n')
    edgcppgen.write_comment(
      intro_block,
      decl_output_stream,
      large_block = True
    )

    decl_output_stream.write('\n\n')
    self._write_bitfield_query_operators(type_name, decl_output_stream)
    decl_output_stream.write('\n')

    decl_output_stream.write('\n')
    def_output_stream.write('\n\n')
    self._write_universal_bitfield_type_null_check(
      type_name,
      type_versions,
      split_output_stream
    )

    for version in type_versions:
      decl_output_stream.write('\n')
      def_output_stream.write('\n\n')
      self._write_bitfield_version_query_conversion(
        type_name,
        version,
        split_output_stream
      )

    decl_output_stream.write('\n')
    def_output_stream.write('\n\n')
    self._write_bitfield_query_conversion(
      type_name,
      type_versions,
      split_output_stream
    )

    decl_output_stream.write('\n\n')
    self._write_bitfield_conversion(
      type_name,
      split_output_stream
    )

  def _write_category_type(self, type_name, version, output_stream):
    versioned_name = self._get_versioned_name(type_name, version)

    registry = self.version_to_registry[version]
    type_size = registry.get_type(type_name).size()
    native_size_type = edgcppgen.size_to_uint(type_size)

    output_stream.write(f"enum {versioned_name} : {native_size_type} {{}};\n")

  def _write_universal_value_category(self, type_name, output_stream):
    edgcppgen.write_comment(
      f"""
      The universal representation for an IFC {type_name}.
      """,
      output_stream,
      large_block = True
    )
    universal_name = self._get_universal_name(type_name)
    output_stream.write(f"struct {universal_name} {{\n")

    universal_sort_name = self._get_universal_sort_name(type_name)
    sort_name = self._get_sort_type_name(type_name)
    sort_comment_writer = edgcppgen.CommentWriter(
      f"""
      The associated {sort_name} value for this index, determining which
      union field is active.
      """
    )
    edgcppgen.write_field(
      universal_sort_name,
      'sort',
      output_stream,
      comment_writer = sort_comment_writer
    )

    unioned_field_tups = []
    for sort_label in self.agg_type_info.get_all_sort_values(sort_name):
      case_type_name = self.agg_type_info.get_category_case_type_name(
        type_name,
        sort_label
      )
      universal_case_type_name = self._get_universal_name(case_type_name)
      formatted_enumerator = self._get_universal_enumerator(
        sort_name,
        sort_label
      )
      union_field_comment_writer = edgcppgen.CommentWriter(
        f"""
        The represented universal value when this category sort represents a
        {case_type_name} value.
        """
      )
      unioned_field_tups.append((
        universal_case_type_name,
        edgcppgen.to_snake_case(sort_label),
        formatted_enumerator,
        union_field_comment_writer
      ))

    edgcppgen.write_variant_field(
      'sort',
      unioned_field_tups,
      output_stream,
      type_name = "variant"
    )

    output_stream.write(f"}};  /* {universal_name} */\n")

  def _write_category_validation(self, type_name, version,
                                 split_output_stream):
    versioned_type_name = self._get_versioned_name(type_name, version)

    function_name = 'validate_category'
    function_decl_args = [
      function_name,
      'a_boolean',
      [
        ('an_ifc_module_file*', 'file'),
        (versioned_type_name, 'versioned'),
        ('const an_ifc_validation_trace*', 'parent')
      ]
    ]
    decl_output_stream = split_output_stream.get_decl()
    edgcppgen.write_function_decl(
      *function_decl_args,
      decl_output_stream,
      specifiers = ['extern'],
      terminator = ');'
    )

    def_output_stream = split_output_stream.get_val_def()
    edgcppgen.write_function_decl(
      *function_decl_args,
      def_output_stream,
      specifiers = []
    )
    edgcppgen.write_comment(
      f"""
      Given the versioned representation of {type_name}, return TRUE if the
      value represents a valid categorized sort; otherwise, return FALSE.
      """,
      def_output_stream,
      large_block = True
    )
    def_output_stream.write('{\n')
    bare_name = self._get_bare_name(type_name)

    registry = self.version_to_registry[version]

    type_size = registry.get_type(type_name).size()
    native_size_type = edgcppgen.size_to_uint(type_size)

    versioned_sort_name = self._get_versioned_sort_name(type_name, version)

    switch_writer = edgcppgen.SwitchWriter('sort')
    sort_type_name = self._get_sort_type_name(type_name)
    sort_version = self.revision_info.get_revision_at_version(
      sort_type_name,
      version
    )

    value_validation_written = False

    sort_dict = registry.get_sort_dict_by_type(sort_type_name)
    for sort_label in sorted(sort_dict.values()):
      case_enumerator = self._get_versioned_enumerator(
        sort_type_name,
        sort_label,
        sort_version
      )

      branch = []

      case_type_name = self.agg_type_info.get_category_case_type_name(
        type_name,
        sort_label
      )
      case_type_version = self.revision_info.get_revision_at_version(
        case_type_name,
        version
      )
      case_versioned_type_name = self._get_versioned_name(
        case_type_name,
        case_type_version
      )
      case_universal_type_name = self._get_universal_name(case_type_name)

      # Byte copied roles are not yet supported, nor are sorts derived
      # from index types (which current return None as they "don't exists"
      # from the perspective of the revision system -- they're implicitly
      # created from the index type).
      field_type_role = self.revision_info.get_type_role(case_type_name)
      assert field_type_role is not None
      assert not is_byte_copied_field_role(field_type_role)

      if not self._is_role_validated(field_type_role):
        continue

      value_validation_written = True

      case_var_writer = edgcppgen.VariableBlockWriter(
        [
          (
            case_versioned_type_name,
            'versioned_value',
            f"({case_versioned_type_name})raw_value"
          )
        ]
      )
      branch.append(case_var_writer)

      branch.extend(
        self._get_type_validation(
          'file',
          'versioned_value',
          case_type_name,
          'parent'
        )
      )

      switch_writer.add_case(case_enumerator, branch)

    # Delay writing anything until we know whether this category has subobjects
    # that need validated.
    category_validation_vars = [
      (
        'a_boolean',
        'result',
        'TRUE'
      ),
      (
        versioned_sort_name,
        'sort',
        f"{bare_name}_sort(versioned)"
      )
    ]
    if value_validation_written:
      category_validation_vars.append((
        native_size_type,
        'raw_value',
        f"{bare_name}_value(versioned)"
      ))

    edgcppgen.write_variable_block(category_validation_vars, def_output_stream)

    branch_writer = edgcppgen.BranchWriter()
    branch_writer.add_branch(
      f"!validate_sort(file, sort, parent)",
      ['result = FALSE;', 'goto done;']
    )
    branch_writer.write(def_output_stream)

    if value_validation_written:
      switch_writer.add_default_case([])
      switch_writer.write(def_output_stream)

    def_output_stream.write('done:\n')
    def_output_stream.write('  return result;\n')
    edgcppgen.write_function_def_end(function_name, def_output_stream)

  def _write_category_conversion(self, type_name, version,
                                 split_output_stream):
    universal_type_name = self._get_universal_name(type_name)
    versioned_type_name = self._get_versioned_name(type_name, version)
    universal_sort_name = self._get_universal_sort_name(type_name)
    versioned_sort_name = self._get_versioned_sort_name(type_name, version)

    function_name = f"to_universal_category"
    function_decl_args = [
      function_name,
      universal_type_name,
      [
        ('an_ifc_module_file*', 'file'),
        (versioned_type_name, 'versioned')
      ]
    ]
    decl_output_stream = split_output_stream.get_decl()
    edgcppgen.write_function_decl(
      *function_decl_args,
      decl_output_stream,
      specifiers = ['extern'],
      terminator = ');'
    )

    def_output_stream = split_output_stream.get_def()
    edgcppgen.write_function_decl(
      *function_decl_args,
      def_output_stream,
      specifiers = []
    )
    edgcppgen.write_comment(
      f"""
      Given the versioned representation of {type_name}, return the
      corresponding universal representation.
      """,
      def_output_stream,
      large_block = True
    )
    def_output_stream.write('{\n')
    bare_name = self._get_bare_name(type_name)

    registry = self.version_to_registry[version]

    type_size = registry.get_type(type_name).size()
    native_size_type = edgcppgen.size_to_uint(type_size)

    edgcppgen.write_variable_block(
      [
        (
          versioned_sort_name,
          'versioned_sort',
          f"{bare_name}_sort(versioned)"
        ),
        (
          universal_sort_name,
          'sort',
          'to_universal_sort(versioned_sort)'
        ),
        (
          native_size_type,
          'raw_value',
          f"{bare_name}_value(versioned)"
        ),
        (
          universal_type_name,
          'result',
          '{sort, {}}'
        )
      ],
      def_output_stream
    )

    switch_writer = edgcppgen.SwitchWriter('versioned_sort')
    sort_type_name = self._get_sort_type_name(type_name)
    sort_version = self.revision_info.get_revision_at_version(
      sort_type_name,
      version
    )
    sort_dict = registry.get_sort_dict_by_type(sort_type_name)
    for sort_label in sorted(sort_dict.values()):
      case_enumerator = self._get_versioned_enumerator(
        sort_type_name,
        sort_label,
        sort_version
      )

      branch = []

      case_type_name = self.agg_type_info.get_category_case_type_name(
        type_name,
        sort_label
      )
      case_type_version = self.revision_info.get_revision_at_version(
        case_type_name,
        version
      )
      case_versioned_type_name = self._get_versioned_name(
        case_type_name,
        case_type_version
      )
      case_universal_type_name = self._get_universal_name(case_type_name)

      # Byte copied roles are not yet supported, nor are sorts derived
      # from index types (which current return None as they "don't exists"
      # from the perspective of the revision system -- they're implicitly
      # created from the index type).
      field_type_role = self.revision_info.get_type_role(case_type_name)
      assert field_type_role is not None
      assert not is_byte_copied_field_role(field_type_role)

      case_var_writer = edgcppgen.VariableBlockWriter(
        [
          (
            case_versioned_type_name,
            'versioned_value',
            f"({case_versioned_type_name})raw_value"
          ),
          (
            case_universal_type_name,
            'universal_value',
            None
          )
        ]
      )
      branch.append(case_var_writer)

      branch.extend(
        self._get_to_universal_call(
          'universal_value',
          case_type_name,
          'file',
          'versioned_value'
        )
      )

      member_name = edgcppgen.to_snake_case(sort_label)
      branch.append(f"result.variant.{member_name} = universal_value;")

      switch_writer.add_case(case_enumerator, branch)

    switch_writer.write(def_output_stream)
    def_output_stream.write('  return result;\n')
    edgcppgen.write_function_def_end(function_name, def_output_stream)

  def _write_value_category(self, type_name, split_output_stream):
    type_output_stream = split_output_stream.get_type()

    type_output_stream.write('\n\n')

    type_versions = self.revision_info.get_type_versions(type_name)
    for type_version in type_versions:
      self._write_category_type(type_name, type_version, type_output_stream)

    type_output_stream.write('\n\n')
    self._write_universal_value_category(type_name, type_output_stream)

    intro_block = (
      f"""
      Functions for interacting with IFC {type_name} indexes.
      """
    )
    def_output_stream = split_output_stream.get_def()
    def_output_stream.write('\n\n')
    edgcppgen.write_comment(
      intro_block,
      def_output_stream,
      large_block = True
    )
    decl_output_stream = split_output_stream.get_decl()
    decl_output_stream.write('\n')
    edgcppgen.write_comment(
      intro_block,
      decl_output_stream,
      large_block = True
    )

    for type_version in type_versions:
      decl_output_stream.write('\n')
      def_output_stream.write('\n\n')
      self._write_tagged_decode(type_name, type_version, split_output_stream)
      decl_output_stream.write('\n')
      split_output_stream.get_val_def().write('\n\n')
      self._write_category_validation(
        type_name,
        type_version,
        split_output_stream
      )
      decl_output_stream.write('\n')
      def_output_stream.write('\n\n')
      self._write_category_conversion(
        type_name,
        type_version,
        split_output_stream
      )

  def _get_tacit_field_version_doc(self, field, version):
    if field.proxy().uses_foreign_values():
      return 'ANY'

    field_type_version = self.revision_info.get_revision_at_version(
      field.type_name(), version
    )
    return f"{field_type_version.major}.{field_type_version.minor}"

  def _write_node_table(self, type_name, version, output_stream):
    registry = self.version_to_registry[version]
    type_info = registry.get_type(type_name)

    table_rows = []

    for field in type_info.fields():
      field_type_name = field.type_name()
      field_type_version = self.revision_info.get_revision_at_version(
        field_type_name, version
      )

      field_size = self.version_to_registry[field_type_version].get_type(
        field_type_name
      ).size()

      table_rows.append(
        (
          field.name(),
          field_type_name,
          f"{field_type_version.major}.{field_type_version.minor}",
          str(field_size)
        )
      )

    padding = type_info.padding()
    if padding > 0:
      padding_type = edgcppgen.size_to_byte_arr(padding)
      table_rows.append(('__padding__', padding_type, '', str(padding)))

    if len(type_info.tacit_fields()) > 0:
      table_rows.append(None)
    for field in sorted(type_info.tacit_fields(), key=lambda f: f.name()):
      field_type_name = field.type_name()

      table_rows.append(
        (
          field.name(),
          field_type_name,
          self._get_tacit_field_version_doc(field, version),
          'TF'
        )
      )

    type_size = type_info.size()
    version_string = f"{version.major}.{version.minor}"
    edgcppgen.write_table(
      ('Name', 'Type', 'Version', 'Size'),
      table_rows,
      output_stream,
      title = f"{type_name} - {version_string} ({type_size} bytes)"
    )

  def _get_branch_writer_for_accessor_validity(self, type_name, field_name):
    acc_field_info = self.agg_type_info.get_field_info(type_name, field_name)

    type_versions = acc_field_info.get_versions_present()

    writer = CPPVersionBranchWriter(always_write_branches = True)

    # Track the last value to remove common branches from the generation.
    # Note that values will be written in the reverse order they're added
    # below, as supported versions goes up from the oldest version to the
    # newest. So, the default is the default if all "is_at_least" checks
    # fails is False.
    last_value = False
    for version in edgifc.SUPPORTED_VERSIONS:
      if acc_field_info.is_present_at_version(version):
        if last_value != True:
          writer.add_branch(
            version,
            [
              'result = TRUE;'
            ]
          )
          last_value = True
      else:
        if last_value != False:
          writer.add_branch(
            version,
            [
              'result = FALSE;'
            ]
          )
          last_value = False

    return writer

  def _write_accessor_validity_check(self, type_name, field_name,
                                     split_output_stream):
    universal_type_name = self._get_universal_name(type_name)

    function_name = f"has_ifc_{field_name}"
    function_decl_args = [
      [],
      function_name,
      'a_boolean',
      [
        (f"const {universal_type_name}&", 'universal')
      ]
    ]
    decl_output_stream = split_output_stream.get_decl()
    edgcppgen.write_function_template_decl(
      *function_decl_args,
      decl_output_stream,
      specifiers = [],
      terminator = ');'
    )

    def_output_stream = split_output_stream.get_acc_def()
    edgcppgen.write_function_template_decl(
      *function_decl_args,
      def_output_stream,
      specifiers = []
    )
    edgcppgen.write_comment(
      f"""
      Return TRUE if the given universal representation has the field
      "{field_name}"; otherwise, return FALSE.
      """,
      def_output_stream,
      large_block = True
    )
    def_output_stream.write('{\n')
    edgcppgen.write_variable_block(
      [
        ('an_ifc_module_file*', 'file', 'universal.get_file()'),
        ('a_boolean', 'result', 'FALSE')
      ],
      def_output_stream
    )

    writer = self._get_branch_writer_for_accessor_validity(
      type_name,
      field_name
    )
    writer.write(def_output_stream)
    def_output_stream.write('  return result;\n')
    edgcppgen.write_function_def_end(function_name, def_output_stream)

  def _get_accessor_return_type(self, field_type):
    '''Previously some types were wrapped when returned.

    This function _could_ be deleted, but is preserved in case this becomes the
    reality again.
    '''
    return self._get_universal_name(field_type)

  def _get_field_type_at_revision(self, field_type, version):
    field_version = self.revision_info.get_revision_at_version(
      field_type,
      version
    )
    return self._get_versioned_name(field_type, field_version)

  def _copy_from_field(self, field_storage, node_storage, type_name,
                       type_version, field_name):
    '''Copy the IFC field from node storage to field storage. type name is the
    type of the node. type version is the version of te node. field name is the
    name of the field.
    '''
    registry = self.version_to_registry[type_version]

    node_type_info = registry.get_type(type_name)
    offset = node_type_info.field_offset_of(field_name)

    field = node_type_info.field_named(field_name)
    field_type_name = field.type_name()
    field_type_role = registry.get_type_role(field_type_name)

    size = registry.get_type(field.type_name()).size()
    field_storage_ref = edgcppgen.pointer_to_reference(field_storage)
    if is_byte_copied_field_role(field_type_role):
      opt_storage_type_name = self._get_universal_opt_storage_name(
        field_type_name
      )
      # Use the function call expr writer to format the cast
      assignment_call = edgcppgen.FunctionCallExprWriter(
        f"{field_storage_ref} = ({opt_storage_type_name})",
        [
          f"(*{node_storage}) + {offset}"
        ]
      )
      mmap_branch_writer = edgcppgen.PreProcessorBranchWriter(
        'USE_MMAP_FOR_MODULES',
         [
           edgcppgen.CommentWriter(
             f"""
             Update the universal storage pointer to the start of the field
             ({type_name}::{field_name} - {field_type_name}).
             """
           ),
           assignment_call
         ]
      )
      mmap_branch_writer.add_else(
        [
          edgcppgen.CommentWriter(
            f"""
            Copy the field ({type_name}::{field_name} - {field_type_name}) into
            universal storage.
            """
          ),
          edgcppgen.FunctionCallExprWriter(
            'copy_from_node_field',
            [
              field_storage,
              node_storage,
              f"/*offset=*/{offset}",
              f"/*size=*/{size}"
            ]
          )
        ]
      )

      # The field is copied directly into universal storage.
      return [
        mmap_branch_writer
      ]
    else:
      # The field is copied directly into versioned storage.
      return [
        edgcppgen.CommentWriter(
          f"""
          Copy the field ({type_name}::{field_name} - {field_type_name}) into
          version-specific storage.
          """
        ),
        edgcppgen.FunctionCallExprWriter(
          'static_assert',
          [
            f"sizeof({field_storage_ref}) == {size}",
            f"\"{field_storage_ref} is not properly sized storage!\""
          ]
        ),
        edgcppgen.FunctionCallExprWriter(
          'copy_from_node_field',
          [
            field_storage,
            node_storage,
            f"/*offset=*/{offset}"
          ]
        )
      ]

  def _copy_from_field_as_stage(self, stage_builder, input_ref, node_type_name,
                                node_version, field_name, file_ref, trace_ref,
                                *, prefer_versioned = False,
                                disable_validation = False):
    perform_validation = (
      stage_builder.is_validated() and not disable_validation
    )

    field_info = self.agg_type_info.get_field_info(
      node_type_name,
      field_name
    )

    # Get the field type and its versioned equivalent.
    field_type_name = (
      field_info.get_shadowed_type_name_at_version(node_version)
      if field_info.is_shadowed_at_version(node_version) else
      field_info.get_type_name()
    )

    field_type_role = self.revision_info.get_type_role(field_type_name)
    if is_byte_copied_field_role(field_type_role):
      field_universal_storage_type_name = (
        self._get_universal_opt_storage_name(field_type_name)
      )

      stage = stage_builder.add_stage(
        field_type_name,
        field_universal_storage_type_name
      )
      def gen_to_universal_storage_fn():
        return self._copy_from_field(
          f"&{stage.get_result_ref()}",
          input_ref,
          node_type_name,
          node_version,
          field_name
        )

      stage.gen_branch_fns.append(gen_to_universal_storage_fn)

      if stage_builder.is_validated():
        self._add_field_trace(
          stage,
          node_type_name,
          node_version,
          field_name,
          'parent'
        )

      universal_stage = self._add_to_universal_stage(stage_builder, file_ref)

      if perform_validation:
        self._add_universal_validation(
          universal_stage,
          file_ref,
          stage.get_trace_ref()
        )

      return universal_stage
    else:
      field_versioned_type_name = self._get_field_type_at_revision(
        field_type_name,
        node_version
      )

      stage = stage_builder.add_stage(
        field_type_name,
        field_versioned_type_name
      )
      def gen_to_versioned_fn():
        return self._copy_from_field(
          f"&{stage.get_result_ref()}",
          input_ref,
          node_type_name,
          node_version,
          field_name
        )

      stage.gen_branch_fns.append(gen_to_versioned_fn)

      if perform_validation:
        self._add_field_validation(
          stage,
          node_type_name,
          node_version,
          field_name,
          file_ref,
          trace_ref
        )

      if not prefer_versioned:
        self._add_to_universal_stage(stage_builder, file_ref)

      return stage

  def _get_to_universal_call(self, result_ref, result_type_name, file_ref,
                             input_ref):
    result_type_role = self.revision_info.get_type_role(result_type_name)

    if result_type_role == edgifc.IFCRegistryTypeRole.INDEX_SORT:
      to_universal = edgcppgen.FunctionCallExprWriter(
        f"{result_ref} = to_universal_index",
        [
          file_ref,
          input_ref
        ]
      )
      return [to_universal]
    if result_type_role == edgifc.IFCRegistryTypeRole.SIMPLE_SORT:
      to_universal = edgcppgen.FunctionCallExprWriter(
        f"{result_ref} = to_universal_sort",
        [
          input_ref
        ]
      )
      return [to_universal]
    if result_type_role == edgifc.IFCRegistryTypeRole.VALUE_CATEGORY:
      to_universal = edgcppgen.FunctionCallExprWriter(
        f"{result_ref} = to_universal_category",
        [
          file_ref,
          input_ref
        ]
      )
      return [to_universal]
    if is_numericly_represented_role(result_type_role):
      result_universal_storage_type_name = self._get_universal_storage_name(
        result_type_name
      )
      to_universal = edgcppgen.FunctionCallExprWriter(
        f"{result_ref} = ",
        [
          file_ref,
          f"({result_universal_storage_type_name}){input_ref}"
        ],
        terminator = '};\n'
      )
      return [to_universal]
    if is_byte_copied_field_role(result_type_role):
      to_universal = edgcppgen.FunctionCallExprWriter(
        f"{result_ref} = ",
        [
          file_ref,
          input_ref
        ],
        terminator = '};\n'
      )
      return [to_universal]
    if result_type_role == edgifc.IFCRegistryTypeRole.NODE_OFFSET:
      to_universal = edgcppgen.FunctionCallExprWriter(
        f"{result_ref} = to_universal_offset",
        [
          file_ref,
          input_ref
        ]
      )
      return [to_universal]
    assert False, f"Unhandled conversion to universal for {result_type_role}."

  def _add_to_universal_stage(self, stage_builder, file_ref):
    last_stage = stage_builder.get_last_stage()
    input_ref = last_stage.get_result_ref()

    result_type_name = last_stage.result_type_name
    result_universal_type_name = self._get_universal_name(result_type_name)

    stage = stage_builder.add_stage(
      result_type_name,
      result_universal_type_name
    )

    def gen_branch_fn():
      return self._get_to_universal_call(
        stage.get_result_ref(),
        result_type_name,
        file_ref,
        input_ref
      )
    stage.gen_branch_fns.append(gen_branch_fn)

    return stage

  def _get_field_trace_init(self, field_name, field_offset, parent):
    return f"{{\"{field_name}\", /*offset=*/{field_offset}, {parent}}}"

  def _get_node_trace_init(self, node_type_name, parent):
    return f"{{\"{node_type_name}\", {parent}}}"

  def _add_field_trace(self, stage, node_type_name, node_version,
                       field_name, trace_ref):
    # Get the field offset for this version.
    registry = self.version_to_registry[node_version]
    node_type_info = registry.get_type(node_type_name)

    # Setup some tracing information
    field_offset = node_type_info.field_offset_of(field_name)
    stage.add_extra_var(
      'an_ifc_validation_trace',
      'trace',
      self._get_field_trace_init(field_name, field_offset, trace_ref)
    )

  def _add_field_validation(self, stage, node_type_name, node_version,
                            field_name, file_ref, trace_ref):
    self._add_field_trace(
      stage,
      node_type_name,
      node_version,
      field_name,
      trace_ref
    )

#     # Factor the field name and offset into the
#     new_stage.add_to_unique_key(field_name)
#     new_stage.add_to_unique_key(field_offset)

    def gen_field_validation_fn():
      return self._get_type_validation(
        file_ref,
        stage.get_result_ref(),
        stage.result_type_name,
        f"&{stage.get_extra_var_ref('trace')}"
      )

    stage.gen_branch_fns.append(gen_field_validation_fn)

    # Indicate this logic is required even when the result is void.
    stage.mark_data_used()

  def _add_type_validation(self, stage, file_ref, value_ref, value_trace_ref,
                           value_type_name):
    # If there's not validation for this type, return.
    if not self._has_type_validation(value_type_name):
      return

    def gen_type_validation_fn():
      return self._get_type_validation(
        file_ref,
        value_ref,
        stage.result_type_name,
        value_trace_ref
      )

    stage.gen_branch_fns.append(gen_type_validation_fn)

    # Indicate this logic is required even when the result is void.
    stage.mark_data_used()

  def _add_universal_validation(self, stage, file_ref, trace_ref):
    self._add_type_validation(
      stage,
      file_ref,
      stage.get_result_ref(),
      trace_ref,
      stage.result_type_name
    )

  def _add_validation_condition(self, stage, condition):
    def gen_validation_branch_fn():
      branch_writer = edgcppgen.BranchWriter()
      branch_writer.add_branch(
        condition,
        ['result = FALSE;', 'goto done;']
      )
      return [branch_writer]

    stage.gen_branch_fns.append(gen_validation_branch_fn)

    # Indicate this logic is required even when the result is void.
    stage.mark_data_used()

  def _get_copy_from_field_stage_builder(self, node_type_name, node_version,
                                         field_name, *, with_validation):
    '''This function is called to return a "stage builder" object which, in
    effect, forms a series of calls that ultimately lead to the final resulting
    value for the given field, for the specified version of the node.
    '''
    field_info = self.agg_type_info.get_field_info(
      node_type_name,
      field_name
    )

    stage_builder = CPPFieldStageBuilder('universal', with_validation)
    if field_info.is_direct_access(node_version):
      self._copy_from_field_as_stage(
        stage_builder,
        'universal.get_storage()',
        node_type_name,
        node_version,
        field_name,
        'universal.get_file()',
        'parent'
      )
    else:
      self._translate_tacit_access(
        stage_builder,
        'universal.get_storage()',
        'universal.get_file()',
        node_type_name,
        node_version,
        field_name
      )
    return stage_builder

  def _copy_to_field(self, field_storage, node_storage, type_name,
                     type_version, field_name):
    '''Copy the IFC field from field storage to node storage. type name is the
    type of the node. type version is the version of the node. field name is
    the name of the field.
    '''
    registry = self.version_to_registry[type_version]

    node_type_info = registry.get_type(type_name)
    offset = node_type_info.field_offset_of(field_name)

    field = node_type_info.field_named(field_name)
    field_type_name = field.type_name()
    field_type_role = registry.get_type_role(field_type_name)

    size = registry.get_type(field.type_name()).size()
    field_storage_ref = edgcppgen.pointer_to_reference(field_storage)

    # The field is copied directly from storage using one of two strategies
    # depending on whether it's a universal or versioned field.
    if is_byte_copied_field_role(field_type_role):
      return [
        edgcppgen.CommentWriter(
          f"""
          Copy from universal storage into the field
          ({type_name}::{field_name} - {field_type_name}).
          """
        ),
        edgcppgen.FunctionCallExprWriter(
          'copy_to_node_field',
          [
            field_storage_ref,
            node_storage,
            f"/*offset=*/{offset}",
            f"/*size=*/{size}"
          ]
        )
      ]
    else:
      return [
        edgcppgen.CommentWriter(
          f"""
          Copy from version-specific storage into the field
          ({type_name}::{field_name} - {field_type_name}).
          """
        ),
        edgcppgen.FunctionCallExprWriter(
          'static_assert',
          [
            f"sizeof({field_storage_ref}) == {size}",
            f"\"{field_storage_ref} is not properly sized storage!\""
          ]
        ),
        edgcppgen.FunctionCallExprWriter(
          'copy_to_node_field',
          [
            field_storage,
            node_storage,
            f"/*offset=*/{offset}"
          ]
        )
      ]

  def _serialize_as_stage(self, stage_builder, input_ref, node_type_name,
                          node_version, field_name, file_ref):
    field_info = self.agg_type_info.get_field_info(
      node_type_name,
      field_name
    )

    # Get the field type and its versioned equivalent.
    field_type_name = (
      field_info.get_shadowed_type_name_at_version(node_version)
      if field_info.is_shadowed_at_version(node_version) else
      field_info.get_type_name()
    )

    field_type_role = self.revision_info.get_type_role(field_type_name)
    if is_byte_copied_field_role(field_type_role):
      field_universal_storage_type_name = (
        self._get_universal_storage_name(field_type_name)
      )

      stage = stage_builder.add_stage(
        field_type_name,
        f"{field_universal_storage_type_name}*"
      )
      def gen_from_universal_fn():
        ptr_cast_type = f"{field_universal_storage_type_name}*"
        return [
          edgcppgen.SplittableLine(
            f"{stage.get_result_ref()} =",
            f"({ptr_cast_type})({input_ref}.get_storage());"
          )
        ]

      stage.gen_branch_fns.append(gen_from_universal_fn)
      return stage

    if (field_type_role == edgifc.IFCRegistryTypeRole.INDEX_SORT or
        field_type_role == edgifc.IFCRegistryTypeRole.SIMPLE_SORT or
        field_type_role == edgifc.IFCRegistryTypeRole.NODE_OFFSET):
      # Index sorts and simple sorts have an identical serialization interface.
      # First, convert to the encoded type name.
      encoded_type_name = self._get_encoded_type_name(field_type_name)
      universal_encoded_type_name = self._get_universal_name(encoded_type_name)
      to_encoded_stage = stage_builder.add_stage(
        encoded_type_name,
        universal_encoded_type_name
      )
      def gen_from_universal_fn():
        to_encoded = edgcppgen.FunctionCallExprWriter(
          f"{to_encoded_stage.get_result_ref()} = to_encoded",
          [
            file_ref,
            input_ref
          ]
        )
        return [to_encoded]
      to_encoded_stage.gen_branch_fns.append(gen_from_universal_fn)

      # Then, cast to the versioned type.
      field_versioned_type_name = self._get_field_type_at_revision(
        field_type_name,
        node_version
      )
      to_version_stage = stage_builder.add_stage(
        field_type_name,
        field_versioned_type_name
      )
      def gen_from_encoded_fn():
        result_ref = f"{to_version_stage.get_result_ref()}"
        encoded_ref = f"{to_encoded_stage.get_result_ref()}.value"
        assignment = edgcppgen.SplittableLine(
          f"{result_ref} =",
          f"({field_versioned_type_name}){encoded_ref};"
        )
        return [assignment]
      to_version_stage.gen_branch_fns.append(gen_from_encoded_fn)

      return to_version_stage

    if is_numericly_represented_role(field_type_role):
      field_versioned_type_name = self._get_field_type_at_revision(
        field_type_name,
        node_version
      )
      to_version_stage = stage_builder.add_stage(
        field_type_name,
        field_versioned_type_name
      )
      def gen_from_encoded_fn():
        result_ref = f"{to_version_stage.get_result_ref()}"
        value_ref = f"{input_ref}.value"
        assignment = edgcppgen.SplittableLine(
          f"{result_ref} =",
          f"({field_versioned_type_name}){value_ref};"
        )
        return [assignment]
      to_version_stage.gen_branch_fns.append(gen_from_encoded_fn)

      return to_version_stage

    # Temporary logic to avoid crashing during generation.
    field_versioned_type_name = self._get_field_type_at_revision(
      field_type_name,
      node_version
    )

    stage = stage_builder.add_stage(
      field_type_name,
      field_versioned_type_name
    )
    def gen_from_universal_fn():
      branch_writer = edgcppgen.BranchWriter()
      branch_writer.add_branch(
        'TRUE',
        [
          edgcppgen.FunctionCallExprWriter(
            'unexpected_condition_str',
            [
              f"\"Not yet supported for writing.\""
            ]
          )
        ]
      )
      return [branch_writer]

    stage.gen_branch_fns.append(gen_from_universal_fn)

    return stage
#     assert False, (
#       'Unhandled conversion to versioned representation '
#       f"for {result_type_role}."
#     )


  def _get_copy_to_field_stage_builder(self, node_type_name, node_version,
                                       field_name, file_ref):
    '''This function is called to return a "stage builder" object which, in
    effect, forms a series of calls that ultimately lead to writing the
    the given field, for the specified version of the node.
    '''
    field_info = self.agg_type_info.get_field_info(
      node_type_name,
      field_name
    )

    stage_builder = CPPFieldStageBuilder('value', with_validation = False)
    # Tacit fields are not supported for writing.  If we encounter one,
    # write out an empty stage builder.
    if field_info.is_writable(node_version):
      self._serialize_as_stage(
        stage_builder,
        'value',
        node_type_name,
        node_version,
        field_name,
        file_ref
      )
    return stage_builder

  def _get_field_version_branches(self, node_type_name, field_name,
                                  stage_builder_gen_func):
    '''This function is called to generate pairs containing the node type
    version and a corresponding stage builder.

    The stage builder is provided by the stage_builder_gen_func.
    stage_builder_gen_func should take a node version argument and return a
    CPPFieldStageBuilder.

    Note that stage builders are deduplicated, so if version A and version B
    create logically equivalent stage builders, only version A and its stage
    builder will be yielded.
    '''
    field_info = self.agg_type_info.get_field_info(
      node_type_name,
      field_name
    )

    field_type_name = field_info.get_type_name()

    last_equality_key = None

    for node_version in field_info.get_versions_present():
      try:
        stage_builder = stage_builder_gen_func(node_version)

        # Deduplicate using an "equality key", this is quickly built up from
        # the stage information to compare the stages. This a bit of a
        # heuristic, but should be right in practice (assuming stages add the
        # field_info where relevant to properly encode offsets).
        equality_key = stage_builder.build_equality_key(
          expensive_mode = self._use_expensive_branch_dedup
        )
        if equality_key == last_equality_key:
          continue
        last_equality_key = equality_key

        yield node_version, stage_builder
      except Exception as e:
        e.add_note(f"for field version branch {node_version}")
        raise

  def _is_stage_pure_cpp(self, stage):
    '''A "pure C++" stage is a stage that has no type in edgifc, and only has
    a C++ type name.

    Return True if this stage is such a stage; otherwise, return False.
    '''
    return stage.result_type_name is None

  def _is_stage_universal(self, stage):
    '''Return True if this stage is a stage represented by a universal type;
    otherwise, return False.
    '''
    # Consider pure C++ stages to be universal as an approximation of the right
    # answer.
    if self._is_stage_pure_cpp(stage):
      return True

    universal_type_name = self._get_universal_name(stage.result_type_name)
    return universal_type_name == stage.result_type_cpp_name

  def _is_stage_universal_storage(self, stage):
    '''Return True if this stage is a stage represented by a universal storage
    type; otherwise, return False.
    '''
    # Consider pure C++ stages to not be universal storage as an approximation
    # of the right answer (if this assumption is changed, _is_stage_universal
    # should also be considered as these two functions probably should not
    # return True for the same stage).
    if self._is_stage_pure_cpp(stage):
      return False

    universal_type_name = self._get_universal_opt_storage_name(
      stage.result_type_name
    )
    return universal_type_name == stage.result_type_cpp_name

  #
  # Proxy Translation Code
  #
  # The following is code used to translate edgifc proxies into equivalent
  # C++ logic.
  #
  # In terms of design principals, these proxies should always return a
  # universal stage (see _is_stage_universal) as their final stage. A proxy
  # that makes use of one or more value sources (effectively sub-proxies)
  # should similarly try to stick to the universal API rather than the
  # versioned API.
  #
  # Sticking to these principals keeps the proxy translations more composable.
  # This in turn means an update to the proxy translation code is less likely
  # when existing proxies are used in "new ways" in edgifc.
  #
  # As an example, if a proxy were to return a versioned value (proxy A), and
  # that proxy were to be used as a value source of another proxy (proxy B),
  # proxy B would now need to be written in such a way that it's tied to the
  # representation of proxy A, which is less flexible than accepting a
  # universal value which encodes both a universal value representation, and a
  # module.
  #
  # Additionally, when proxies are translated to C++ there are two versions of
  # them that are translated, a C++ data retrieval version, and a C++ validated
  # data retrieval version. These are used to support get_ifc_X functions and
  # validate functions respectively.
  #

  def _translate_direct_delegate(self, stage_builder, value_input_ref,
                                 mod_input_ref, node_type_name, node_version,
                                 proxy):
    registry = self.version_to_registry[node_version]

    trace_ref = 'parent'
    field_path = proxy.field_path()
    last_path_idx = len(field_path) - 1
    for idx, field_name in enumerate(field_path):
      if idx == last_path_idx:
        self._copy_from_field_as_stage(
          stage_builder,
          value_input_ref,
          node_type_name,
          node_version,
          field_name,
          mod_input_ref,
          trace_ref
        )
        break

      stage = self._copy_from_field_as_stage(
        stage_builder,
        value_input_ref,
        node_type_name,
        node_version,
        field_name,
        mod_input_ref,
        trace_ref,
        prefer_versioned = True
      )

      type_info = registry.get_type(node_type_name)
      field_type_name = type_info.field_named(field_name).type_name()

      if stage_builder.is_validated():
        # Update the trace reference to create "descent."
        trace_ref = stage.get_trace_ref()

      # When there are multiple items in the field path, the "node_type_name"
      # and "value_input_ref" change as the "node" where the "field" changes.
      node_type_name = field_type_name
      value_input_ref = f"{stage.get_result_ref()}.get_storage()"
      mod_input_ref = f"{stage.get_result_ref()}.get_file()"

  def _translate_reusable_result(self, stage_builder, value_input_ref,
                                 mod_input_ref, node_type_name, node_version,
                                 proxy):
    cached_state = stage_builder.get_state()

    key = proxy.key()
    if key not in cached_state:
      self._translate_proxy(
        stage_builder,
        value_input_ref,
        mod_input_ref,
        node_type_name,
        node_version,
        proxy.proxy()
      )
      cached_state[key] = stage_builder.get_last_stage()
    else:
      cached_result_stage = cached_state[key]

      new_stage = stage_builder.add_stage(
        cached_result_stage.result_type_name,
        cached_result_stage.result_type_cpp_name
      )
      def gen_stage_ref_fn():
        new_stage_ref = new_stage.get_result_ref()
        cached_stage_ref = cached_result_stage.get_result_ref()
        return [f"{new_stage_ref} = {cached_stage_ref};"]

      new_stage.gen_branch_fns.append(gen_stage_ref_fn)

  def _translate_encoded_delegate(self, stage_builder, value_input_ref,
                                  mod_input_ref, node_type_name, node_version,
                                  proxy):
    registry = self.version_to_registry[node_version]

    self._translate_proxy(
      stage_builder,
      value_input_ref,
      mod_input_ref,
      node_type_name,
      node_version,
      proxy.value_proxy()
    )

    universal_value_stage = stage_builder.get_last_stage()

    encoded_type_name = proxy.encoded_type_name()
    encoded_universal_type_name = self._get_universal_name(encoded_type_name)

    encoding_stage = stage_builder.add_stage(
      encoded_type_name,
      encoded_universal_type_name
    )

    def gen_encoding_stage_fn():
      comment_writer = edgcppgen.CommentWriter(
        '''
        Use the encoding matching the request, regardless of where we're
        coming from, to get an encoding result that matches the source node
        (and is thus, arguably the least surprising).
        '''
      )

      to_encoding_call = edgcppgen.FunctionCallExprWriter(
        f"{encoding_stage.get_result_ref()} = to_encoded",
        [
          'universal.get_file()',
          universal_value_stage.get_result_ref()
        ]
      )

      return [comment_writer, to_encoding_call]

    encoding_stage.gen_branch_fns.append(gen_encoding_stage_fn)

  def _translate_field_delegate(self, stage_builder, value_input_ref,
                                mod_input_ref, node_type_name, node_version,
                                proxy):
    first = True
    for field_name in proxy.field_path():
      field_type_name = self.agg_type_info.get_field_type(
        node_type_name,
        field_name
      )
      field_universal_type_name = self._get_universal_name(field_type_name)

      stage = stage_builder.add_stage(
        field_type_name,
        field_universal_type_name
      )

      # FIXME: This is a DIRTY hack
      call_args = (
        value_input_ref.replace('.get_storage()', '') if first
        else value_input_ref
      )
      def gen_field_delegate_stage_fn():
        result_ref = stage.get_result_ref()
        return [f"{result_ref} = get_ifc_{field_name}({call_args});"]

      stage.gen_branch_fns.append(gen_field_delegate_stage_fn)

      # When there are multiple items in the field path, the "node_type_name"
      # and "value_input_ref" change as the "node" where the "field" changes.
      node_type_name = field_type_name
      value_input_ref = stage.get_result_ref()
      first = False

  def _translate_remote_delegate(self, stage_builder, value_input_ref,
                                 mod_input_ref, node_type_name, node_version,
                                 proxy):
    registry = self.version_to_registry[node_version]

    self._translate_proxy(
      stage_builder,
      value_input_ref,
      mod_input_ref,
      node_type_name,
      node_version,
      proxy.local_value_proxy()
    )
    field_type_name = f"{proxy.local_value_index_name()}Index"
    local_stage = stage_builder.get_last_stage()
    local_value_ref = local_stage.get_result_ref()

    remote_type_name = proxy.remote_type_name()
    remote_type_info = registry.get_type(remote_type_name)
    remote_type_version = self.revision_info.get_revision_at_version(
      remote_type_name,
      node_version
    )
    remote_universal_type_name = self._get_universal_name(remote_type_name)

    remote_field_name = proxy.remote_field_name()
    remote_field = remote_type_info.field_named(remote_field_name)

    remote_stage = stage_builder.add_stage(
      remote_type_name,
      remote_universal_type_name
    )

    sort_decoded = f"{local_value_ref}.sort"
    required_sort_kind = self._get_universal_enumerator(
      field_type_name,
      remote_type_name
    )

    if stage_builder.is_validated():
      self._add_validation_condition(
        remote_stage,
        f"{sort_decoded} != {required_sort_kind}"
      )

    data_retrieval_comment = ''
    if not stage_builder.is_validated():
      data_retrieval_comment = (
        ' (the type tag should have been prechecked by validation)'
      )

    def gen_remote_load_branch_fn():
      comment_writer = edgcppgen.CommentWriter(
        f"""
        Use the obtained index to retrieve the appropriate instance of
        {remote_type_name}{data_retrieval_comment}. Then, retrieve and return
        the desired value held by the field {remote_field_name}.
        """
      )

      remote_loader = edgcppgen.FunctionCallExprWriter(
        'construct_node_unchecked',
        [
          f"&{remote_stage.get_result_ref()}",
          local_value_ref
        ]
      )

      return [comment_writer, remote_loader]

    remote_stage.gen_branch_fns.append(gen_remote_load_branch_fn)

    # Copy the remote field.
    self._copy_from_field_as_stage(
      stage_builder,
      f"{remote_stage.get_result_ref()}.get_storage()",
      remote_type_name,
      remote_type_version,
      remote_field_name,
      f"{remote_stage.get_result_ref()}.get_file()",
      remote_stage.get_trace_ref()
    )

  def _translate_offset_delegate(self, stage_builder, value_input_ref,
                                 mod_input_ref, node_type_name, node_version,
                                 proxy):
    registry = self.version_to_registry[node_version]

    self._translate_proxy(
      stage_builder,
      value_input_ref,
      mod_input_ref,
      node_type_name,
      node_version,
      proxy.local_value_proxy()
    )
    local_stage = stage_builder.get_last_stage()
    local_value_ref = local_stage.get_result_ref()

    remote_type_name = proxy.remote_type_name()
    remote_type_info = registry.get_type(remote_type_name)
    remote_type_version = self.revision_info.get_revision_at_version(
      remote_type_name,
      node_version
    )
    remote_universal_type_name = self._get_universal_name(remote_type_name)

    remote_field_name = proxy.remote_field_name()
    remote_field = remote_type_info.field_named(remote_field_name)

    remote_stage = stage_builder.add_stage(
      remote_type_name,
      remote_universal_type_name
    )

    def gen_remote_load_branch_fn():
      comment_writer = edgcppgen.CommentWriter(
        f"""
        Use the obtained offset to retrieve the appropriate instance of
        {remote_type_name}. Then, retrieve and return the desired value held by
        the field {remote_field_name}.
        """
      )

      remote_loader = edgcppgen.FunctionCallExprWriter(
        'construct_node_unchecked',
        [
          f"&{remote_stage.get_result_ref()}",
          local_value_ref
        ]
      )

      return [comment_writer, remote_loader]

    remote_stage.gen_branch_fns.append(gen_remote_load_branch_fn)

    # Copy the remote field.
    self._copy_from_field_as_stage(
      stage_builder,
      f"{remote_stage.get_result_ref()}.get_storage()",
      remote_type_name,
      remote_type_version,
      remote_field_name,
      f"{remote_stage.get_result_ref()}.get_file()",
      remote_stage.get_trace_ref()
    )

  def _translate_conditional_delegate(self, stage_builder, value_input_ref,
                                      mod_input_ref, node_type_name,
                                      node_version, proxy):
    self._translate_proxy(
      stage_builder,
      value_input_ref,
      mod_input_ref,
      node_type_name,
      node_version,
      proxy.condition_proxy()
    )
    condition_stage = stage_builder.get_last_stage()
    condition_stage.mark_data_used()

    result_type_name = proxy.result_type_name()
    result_universal_type_name = self._get_universal_name(result_type_name)
    result_stage = stage_builder.add_stage(
      result_type_name,
      result_universal_type_name
    )

    def gen_conditional_fn():
      condition_ref = condition_stage.get_result_ref()
      branch_writer = edgcppgen.BranchWriter()

      # Write the true branch.
      true_branch_stage_builder = CPPFieldStageBuilder(
        value_input_ref,
        stage_builder.is_validated(),
        stage_prefix = result_stage.get_result_ref(),
        inherited_state = stage_builder.get_state()
      )
      self._translate_proxy(
        true_branch_stage_builder,
        value_input_ref,
        mod_input_ref,
        node_type_name,
        node_version,
        proxy.true_value_proxy()
      )
      true_branch = []
      if result_stage.should_be_generated():
        true_branch = true_branch_stage_builder.build(
          result_stage.get_result_ref(),
          result_universal_type_name
        )
      else:
        true_branch = true_branch_stage_builder.build_void()
      branch_writer.add_branch(condition_ref, true_branch)

      # Write the false branch.
      false_branch_stage_builder = CPPFieldStageBuilder(
        value_input_ref,
        stage_builder.is_validated(),
        stage_prefix = result_stage.get_result_ref(),
        inherited_state = stage_builder.get_state()
      )
      self._translate_proxy(
        false_branch_stage_builder,
        value_input_ref,
        mod_input_ref,
        node_type_name,
        node_version,
        proxy.false_value_proxy()
      )
      false_branch = []
      if result_stage.should_be_generated():
        false_branch = false_branch_stage_builder.build(
          result_stage.get_result_ref(),
          result_universal_type_name
        )
      else:
        false_branch = false_branch_stage_builder.build_void()
      if len(false_branch) > 0:
        branch_writer.add_fallback(false_branch)

      return [branch_writer]

    def gen_void_result_conditional():
      # This code is called when the result stage is going to be deleted
      # it adds the conditional logic, with a void result, to the previous
      # stage.
      return [] if result_stage.should_be_generated() else gen_conditional_fn()
    condition_stage.gen_branch_fns.append(gen_void_result_conditional)

    result_stage.gen_branch_fns.append(gen_conditional_fn)

  def _translate_test_sort_match(self, stage_builder, value_input_ref,
                                 mod_input_ref, node_type_name, node_version,
                                 proxy):
    self._translate_proxy(
      stage_builder,
      value_input_ref,
      mod_input_ref,
      node_type_name,
      node_version,
      proxy.test_value_source()
    )

    value_input_ref = stage_builder.get_last_stage().get_result_ref()

    index_name = proxy.index_name()
    index_type_name = f"{index_name}Index"

    boolean_stage = stage_builder.add_stage(None, 'a_boolean')
    boolean_stage_result = boolean_stage.get_result_ref()

    def gen_conditional_fn():
      branch_writer = edgcppgen.BranchWriter()
      for desired_match in sorted(proxy.desired_matches()):
        required_sort = self._get_universal_enumerator(
          index_type_name,
          desired_match
        )

        branch_writer.add_branch(
          f"{value_input_ref}.sort == {required_sort}",
          [f"{boolean_stage_result} = TRUE;"]
        )

      branch_writer.add_fallback([f"{boolean_stage_result} = FALSE;"])
      return [branch_writer]

    boolean_stage.gen_branch_fns.append(gen_conditional_fn)

  def _translate_foreign_delegate(self, stage_builder, value_input_ref,
                                  mod_input_ref, node_type_name, node_version,
                                  proxy):
    registry = self.version_to_registry[node_version]
    type_info = registry.get_type(node_type_name)

    self._translate_proxy(
      stage_builder,
      value_input_ref,
      mod_input_ref,
      node_type_name,
      node_version,
      proxy.module_unit_value_source()
    )
    module_unit_ref = stage_builder.get_last_stage().get_result_ref()

    module_stage = stage_builder.add_stage(
      None,
      'an_ifc_module_file*'
    )

    module_load_args = [
      module_unit_ref
    ]
    if stage_builder.is_validated():
      self._add_validation_condition(
        module_stage,
        f"!check_module({', '.join(module_load_args)})"
      )

    def gen_module_load_call_fn():
      return [
        edgcppgen.FunctionCallExprWriter(
          f"{module_stage.get_result_ref()} = get_module",
          module_load_args
        )
      ]
    module_stage.gen_branch_fns.append(gen_module_load_call_fn)

    self._translate_proxy(
      stage_builder,
      value_input_ref,
      mod_input_ref,
      node_type_name,
      node_version,
      proxy.module_local_value_source()
    )
    module_value_stage = stage_builder.get_last_stage()
    module_foreign_type = module_value_stage.result_type_name
    module_value_ref = module_value_stage.get_result_ref()
    module_value_trace_ref = module_value_stage.get_trace_ref()

    if stage_builder.is_validated():
      # This is a special case where the logic needs handle
      def gen_foreign_index_validation_fn():
        validation_failure_writer = edgcppgen.BranchWriter()
        validation_failure_writer.add_branch(
          edgcppgen.FunctionCallExprWriter(
            '!validate_index',
            [
              module_stage.get_result_ref(),
              module_value_ref,
              module_value_trace_ref
            ],
            terminator = ')) {'
          ),
          ['result = FALSE;', 'goto done;']
        )
        return [validation_failure_writer]

      module_value_stage.gen_branch_fns.append(gen_foreign_index_validation_fn)
      module_value_stage.mark_data_used()

    native_index_type_name = self._get_native_index_name(module_foreign_type)
    native_index_universal_type_name = self._get_universal_name(
      native_index_type_name
    )

    to_universal_stage = stage_builder.add_stage(
      native_index_type_name,
      native_index_universal_type_name
    )

    def gen_to_universal_fn():
      return [
        edgcppgen.FunctionCallExprWriter(
          f"{to_universal_stage.get_result_ref()} = to_universal_index",
          [
            module_stage.get_result_ref(),
            module_value_ref
          ]
        )
      ]
    to_universal_stage.gen_branch_fns.append(gen_to_universal_fn)

  def _translate_visitor_delegate(self, stage_builder, value_input_ref,
                                  mod_input_ref, node_type_name, node_version,
                                  proxy):
    self._translate_proxy(
      stage_builder,
      value_input_ref,
      mod_input_ref,
      node_type_name,
      node_version,
      proxy.value_source()
    )

    visitor_input = stage_builder.get_last_stage().get_result_ref()

    desired_field_name = proxy.desired_field_name()
    desired_field_type_name = proxy.desired_field_type_name()
    desired_field_universal_type_name = self._get_universal_name(
      desired_field_type_name
    )

    index_name = proxy.index_name()
    index_type_name = f"{index_name}Index"
    index_universal_type_name = self._get_universal_name(index_type_name)

    last_stage = stage_builder.get_last_stage()
    if not self._is_stage_universal(last_stage):
      self._add_to_universal_stage(stage_builder, mod_input_ref)

    last_stage = stage_builder.get_last_stage()
    if stage_builder.is_validated():
      self._add_validation_condition(
        last_stage,
        f"!has_ifc_{desired_field_name}({visitor_input})"
      )
      self._add_validation_condition(
        last_stage,
        f"!validate({visitor_input})"
      )

    visitor_stage = stage_builder.add_stage(
      desired_field_type_name,
      desired_field_universal_type_name
    )

    def gen_visitor_call_fn():
      return [
        edgcppgen.FunctionCallExprWriter(
          f"{visitor_stage.get_result_ref()} = get_ifc_{desired_field_name}",
          [
            visitor_input
          ]
        )
      ]
    visitor_stage.gen_branch_fns.append(gen_visitor_call_fn)

  def _translate_composed_category(self, stage_builder, value_input_ref,
                                   mod_input_ref, node_type_name, node_version,
                                   proxy):
    # Validation is disabled and versioned representation is used for the field
    # copies as the composed value will be validated rather than the components
    # (which in the vast majority of cases have no meaning at the field copy
    # level. Thus, validating them here only creates duplicate work for
    # category validation).
    value_stages = []
    for value_field in reversed(proxy.value_fields()):
      value_stage = self._copy_from_field_as_stage(
        stage_builder,
        value_input_ref,
        node_type_name,
        node_version,
        value_field,
        mod_input_ref,
        'parent',
        prefer_versioned = True,
        disable_validation = True
      )
      value_stages.append(value_stage)

    sort_stage = self._copy_from_field_as_stage(
      stage_builder,
      value_input_ref,
      node_type_name,
      node_version,
      proxy.sort_field(),
      mod_input_ref,
      'parent',
      prefer_versioned = True,
      disable_validation = True
    )

    desired_category = proxy.desired_category()
    category_type_name = f"{desired_category}Category"

    registry = self.version_to_registry[node_version]
    category_type_size = registry.get_type(category_type_name).size()
    category_uint_type = edgcppgen.size_to_uint(category_type_size)

    byte_manipulation_stage = stage_builder.add_stage(
      None,
      category_uint_type
    )

    def gen_byte_manipulation_fn():
      byte_branch = []
      comment_writer = edgcppgen.CommentWriter(
        f"""
        Pack the fields ({proxy.sort_field()},
        {', '.join(proxy.value_fields())}) into the {category_type_size * 8}
        bit {category_type_name} representation. Then, decode the bit-encoded
        value using the standard conversion to the universal representation for
        the category.
        """
      )
      byte_branch.append(comment_writer)

      byte_manipulation_result = byte_manipulation_stage.get_result_ref()
      byte_branch.append(
        f"{byte_manipulation_result} = 0;"
      )

      for idx, value_shift in enumerate(reversed(proxy.value_shifts())):
        value_ref = value_stages[idx].get_result_ref()
        byte_branch.extend([
          f"{byte_manipulation_result} |= {value_ref};",
          f"{byte_manipulation_result} <<= {value_shift};",
        ])

      sort_result = sort_stage.get_result_ref()
      byte_branch.append(
        f"{byte_manipulation_result} |= {sort_result};"
      )
      return byte_branch
    byte_manipulation_stage.gen_branch_fns.append(gen_byte_manipulation_fn)

    category_type_version = self.revision_info.get_revision_at_version(
      category_type_name,
      node_version
    )
    category_versioned_type_name = self._get_versioned_name(
      category_type_name,
      category_type_version
    )

    category_stage = stage_builder.add_stage(
      category_type_name,
      category_versioned_type_name
    )

    def gen_category_cast_fn():
      category_result = category_stage.get_result_ref()
      byte_manipulation_result = byte_manipulation_stage.get_result_ref()

      return [
        f"{category_result} = ({category_versioned_type_name})"
        f"{byte_manipulation_result};"
      ]
    category_stage.gen_branch_fns.append(gen_category_cast_fn)

    self._add_to_universal_stage(stage_builder, mod_input_ref)

    if stage_builder.is_validated():
      self._add_universal_validation(
        category_stage,
        mod_input_ref,
        'parent'
      )

  def _translate_proxy(self, stage_builder, value_input_ref, mod_input_ref,
                       node_type_name, node_version, proxy):
    if isinstance(proxy, edgifc.IFCDirectDelegate):
      self._translate_direct_delegate(
        stage_builder,
        value_input_ref,
        mod_input_ref,
        node_type_name,
        node_version,
        proxy
      )
    elif isinstance(proxy, edgifc.IFCFieldDelegate):
      self._translate_field_delegate(
        stage_builder,
        value_input_ref,
        mod_input_ref,
        node_type_name,
        node_version,
        proxy
      )
    elif isinstance(proxy, edgifc.IFCConditionalDelegate):
      self._translate_conditional_delegate(
        stage_builder,
        value_input_ref,
        mod_input_ref,
        node_type_name,
        node_version,
        proxy
      )
    elif isinstance(proxy, edgifc.IFCTestSortMatch):
      self._translate_test_sort_match(
        stage_builder,
        value_input_ref,
        mod_input_ref,
        node_type_name,
        node_version,
        proxy
      )
    elif isinstance(proxy, edgifc.IFCRemoteDelegate):
      self._translate_remote_delegate(
        stage_builder,
        value_input_ref,
        mod_input_ref,
        node_type_name,
        node_version,
        proxy
      )
    elif isinstance(proxy, edgifc.IFCOffsetDelegate):
      self._translate_offset_delegate(
        stage_builder,
        value_input_ref,
        mod_input_ref,
        node_type_name,
        node_version,
        proxy
      )
    elif isinstance(proxy, edgifc.IFCForeignDelegate):
      self._translate_foreign_delegate(
        stage_builder,
        value_input_ref,
        mod_input_ref,
        node_type_name,
        node_version,
        proxy
      )
    elif isinstance(proxy, edgifc.IFCVisitorDelegate):
      self._translate_visitor_delegate(
        stage_builder,
        value_input_ref,
        mod_input_ref,
        node_type_name,
        node_version,
        proxy
      )
    elif isinstance(proxy, edgifc.IFCComposedCategory):
      self._translate_composed_category(
        stage_builder,
        value_input_ref,
        mod_input_ref,
        node_type_name,
        node_version,
        proxy
      )
    elif isinstance(proxy, edgifc.IFCReusableResult):
      self._translate_reusable_result(
        stage_builder,
        value_input_ref,
        mod_input_ref,
        node_type_name,
        node_version,
        proxy
      )
    elif isinstance(proxy, edgifc.IFCEncodedDelegate):
      self._translate_encoded_delegate(
        stage_builder,
        value_input_ref,
        mod_input_ref,
        node_type_name,
        node_version,
        proxy
      )
    else:
      proxy_type_name = type(proxy).__name__
      assert False, f"Unimplemented proxy {proxy_type_name}."

    err_msg = (
      f"Failed to translate proxy {type(proxy).__name__} to a universal type."
    )
    assert self._is_stage_universal(stage_builder.get_last_stage()), err_msg

  def _translate_tacit_access(self, stage_builder, value_input_ref,
                                  mod_input_ref, node_type_name, node_version,
                                  field_name):
    registry = self.version_to_registry[node_version]

    type_info = registry.get_type(node_type_name)
    tacit_field = type_info.tacit_field_named(field_name)

    proxy = tacit_field.proxy()
    self._translate_proxy(
      stage_builder,
      value_input_ref,
      mod_input_ref,
      node_type_name,
      node_version,
      proxy
    )

  def _write_accessor(self, type_name, field_name, split_output_stream):
    try:
      acc_field_info = self.agg_type_info.get_field_info(type_name, field_name)
      field_type = acc_field_info.get_type_name()

      universal_type_name = self._get_universal_name(type_name)
      universal_field_type = self._get_universal_name(field_type)
      return_type = self._get_accessor_return_type(field_type)

      function_name = f"get_ifc_{field_name}"
      function_decl_args = [
        [],
        function_name,
        return_type,
        [
          (f"const {universal_type_name}&", 'universal')
        ]
      ]
      decl_output_stream = split_output_stream.get_decl()
      edgcppgen.write_function_template_decl(
        *function_decl_args,
        decl_output_stream,
        specifiers = [],
        terminator = ');'
      )

      def_output_stream = split_output_stream.get_acc_def()
      edgcppgen.write_function_template_decl(
        *function_decl_args,
         def_output_stream,
        specifiers = []
      )
      edgcppgen.write_comment(
        f"""
        Given the universal representation of {type_name}, return the universal
        representation of the field "{field_name}".
        """,
        def_output_stream,
        large_block = True
      )
      def_output_stream.write('{\n')

      edgcppgen.write_variable_block(
        [
          (universal_field_type, 'result', None)
        ],
        def_output_stream
      )

      edgcppgen.write_comment(
        f"""
        Ensure the {field_name} field exists in the current module version.
        """,
        def_output_stream,
        indent = '  '
      )
      def_output_stream.write(
        f"  check_assertion(has_ifc_{field_name}(universal));\n"
      )

      def get_stage_builder_for_version(node_version):
        return self._get_copy_from_field_stage_builder(
          type_name,
          node_version,
          field_name,
          with_validation = False
        )

      writer = CPPVersionBranchWriter(file_ref = 'universal.get_file()')
      ver_branches = self._get_field_version_branches(
        type_name,
        field_name,
        get_stage_builder_for_version
      )
      for type_version, stage_builder in ver_branches:
        branch = stage_builder.build('result', universal_field_type)
        writer.add_branch(type_version, branch)

      writer.write(def_output_stream)
      def_output_stream.write('  return result;\n')

      edgcppgen.write_function_def_end(function_name, def_output_stream)
    except Exception as e:
      e.add_note(f"while writing {field_name} accessor")
      raise

  def _write_accessors(self, type_name, type_versions, split_output_stream):
    decl_output_stream = split_output_stream.get_decl()
    def_output_stream = split_output_stream.get_acc_def()

    edgcppgen.write_comment(
      f"""
      Functions for reading data from IFC {type_name} nodes.
      """,
      def_output_stream,
      large_block = True
    )

    for field_name in self.agg_type_info.get_all_field_names(type_name):
      decl_output_stream.write('\n')
      def_output_stream.write('\n\n')

      self._write_accessor_validity_check(
        type_name,
        field_name,
        split_output_stream
      )

      decl_output_stream.write('\n')
      def_output_stream.write('\n\n')

      self._write_accessor(
        type_name,
        field_name,
        split_output_stream
      )

  def _write_mutator_variant(self, type_name, field_name, field_type,
                             split_output_stream):
    field_info = self.agg_type_info.get_field_info(type_name, field_name)

    universal_type_name = self._get_universal_name(type_name)
    universal_field_type = self._get_universal_name(field_type)

    function_name = f"set_ifc_{field_name}"
    function_decl_args = [
      [],
      function_name,
      'void',
      [
        (f"{universal_type_name}*", 'universal'),
        (f"const {universal_field_type}&", 'value')
      ]
    ]
    decl_output_stream = split_output_stream.get_decl()
    edgcppgen.write_function_template_decl(
      *function_decl_args,
      decl_output_stream,
      specifiers = [],
      terminator = ');'
    )

    def_output_stream = split_output_stream.get_mut_def()
    edgcppgen.write_function_template_decl(
      *function_decl_args,
       def_output_stream,
      specifiers = []
    )
    edgcppgen.write_comment(
      f"""
      Given the universal representation of {type_name} update the value of
      the field "{field_name}" to the given {field_type} value.
      """,
      def_output_stream,
      large_block = True
    )
    def_output_stream.write('{\n')

    edgcppgen.write_comment(
      f"""
      Ensure the {field_name} field exists in the current module version.
      """,
      def_output_stream,
      indent = '  '
    )
    def_output_stream.write(
      f"  check_assertion(has_ifc_{field_name}(*universal));\n"
    )

    def get_stage_builder_for_version(node_version):
      return self._get_copy_to_field_stage_builder(
        type_name,
        node_version,
        field_name,
        file_ref = 'universal->get_file()'
      )

    writer = CPPVersionBranchWriter(file_ref = 'universal->get_file()')
    ver_branches = self._get_field_version_branches(
      type_name,
      field_name,
      get_stage_builder_for_version
    )
    for type_version, stage_builder in ver_branches:
      field_info = self.agg_type_info.get_field_info(
        type_name,
        field_name
      )

      # Skip any tacit fields, instead writing an error branch.
      if not field_info.is_writable(type_version):
        writer.add_branch(
          type_version,
          [
            edgcppgen.FunctionCallExprWriter(
              'unexpected_condition_str',
              [
                f"\"Tacit fields are not yet supported for writing.\""
              ]
            )
          ]
        )
        continue

      version_field_type = field_info.get_mutator_type_at_version(
        type_version
      )
      if version_field_type != field_type:
        writer.add_branch(
          type_version,
          [
            edgcppgen.FunctionCallExprWriter(
              'unexpected_condition_str',
              [
                f"\"This type is not supported at this version.\""
              ]
            )
          ]
        )
        continue

      branch = stage_builder.build_void()
      last_stage = stage_builder.get_last_stage()
      field_copy = self._copy_to_field(
        f"&{last_stage.get_result_ref()}",
        "universal->get_storage()",
        type_name,
        type_version,
        field_name
      )
      branch.extend(field_copy)
      writer.add_branch(type_version, branch)

    writer.write(def_output_stream)

    edgcppgen.write_function_def_end(function_name, def_output_stream)

  def _write_mutator(self, type_name, field_name, split_output_stream):
    try:
      field_info = self.agg_type_info.get_field_info(
        type_name,
        field_name
      )
      field_type_names = set()
      for node_version in field_info.get_versions_present():
        field_type_name = field_info.get_mutator_type_at_version(node_version)
        field_type_names.add(field_type_name)

      for field_type_name in sorted(field_type_names):
        self._write_mutator_variant(type_name, field_name, field_type_name,
                                    split_output_stream)
    except Exception as e:
      e.add_note(f"while writing {field_name} mutator")
      raise

  def _write_mutators(self, type_name, type_versions, split_output_stream):
    decl_output_stream = split_output_stream.get_decl()
    def_output_stream = split_output_stream.get_mut_def()

    edgcppgen.write_comment(
      f"""
      Functions for writing data to IFC {type_name} nodes.
      """,
      def_output_stream,
      large_block = True
    )

    for field_name in self.agg_type_info.get_all_field_names(type_name):
      field_type_name = self.agg_type_info.get_field_type(
        type_name,
        field_name
      )
      field_type_role = self.revision_info.get_type_role(field_type_name)

      decl_output_stream.write('\n')
      def_output_stream.write('\n\n')

      self._write_mutator(
        type_name,
        field_name,
        split_output_stream
      )

  def _has_type_validation(self, value_type_name):
    field_type_role = self.revision_info.get_type_role(value_type_name)
    return self._is_role_validated(field_type_role)

  def _get_type_validation(self, file_ref, value_ref, value_type_name,
                           trace_ref):
    field_type_role = self.revision_info.get_type_role(value_type_name)

    if field_type_role == edgifc.IFCRegistryTypeRole.INDEX_SORT:
      validation_failure_writer = edgcppgen.BranchWriter()
      validation_failure_writer.add_branch(
        edgcppgen.FunctionCallExprWriter(
          '!validate_index',
          [
            file_ref,
            value_ref,
            trace_ref
          ],
          terminator = ')) {'
        ),
        ['result = FALSE;', 'goto done;']
      )
      return [validation_failure_writer]
    if field_type_role == edgifc.IFCRegistryTypeRole.SIMPLE_SORT:
      validation_failure_writer = edgcppgen.BranchWriter()

      validation_failure_writer.add_branch(
        f"!validate_sort({file_ref}, {value_ref}, {trace_ref})",
        ['result = FALSE;', 'goto done;']
      )
      return [validation_failure_writer]
    if edgifc.is_node_role(field_type_role):
      validation_failure_writer = edgcppgen.BranchWriter()
      validation_failure_writer.add_branch(
        f"!validate({value_ref}, {trace_ref})",
        ['result = FALSE;', 'goto done;']
      )
      return [validation_failure_writer]
    if field_type_role == edgifc.IFCRegistryTypeRole.VALUE_CATEGORY:
      validation_failure_writer = edgcppgen.BranchWriter()

      validation_failure_writer.add_branch(
        edgcppgen.FunctionCallExprWriter(
          '!validate_category',
          [
            file_ref,
            value_ref,
            trace_ref
          ],
          terminator = ')) {'
        ),
        ['result = FALSE;', 'goto done;']
      )
      return [validation_failure_writer]
    if field_type_role == edgifc.IFCRegistryTypeRole.NODE_OFFSET:
      validation_failure_writer = edgcppgen.BranchWriter()
      validation_failure_writer.add_branch(
        edgcppgen.FunctionCallExprWriter(
          '!validate_offset',
          [
            file_ref,
            value_ref,
            trace_ref
          ],
          terminator = ')) {'
        ),
        ['result = FALSE;', 'goto done;']
      )
      return [validation_failure_writer]
    return []

  def _is_role_validated(self, type_role):
    if type_role == edgifc.IFCRegistryTypeRole.SIMPLE_SORT:
      return True
    if type_role == edgifc.IFCRegistryTypeRole.INDEX_SORT:
      return True
    if edgifc.is_node_role(type_role):
      return True
    if type_role == edgifc.IFCRegistryTypeRole.VALUE_CATEGORY:
      return True
    if type_role == edgifc.IFCRegistryTypeRole.NODE_OFFSET:
      return True
    return False

  def _get_field_validation_branch(self, node_type_name, field_name):
    def get_stage_builder_for_version(node_version):
      return self._get_copy_from_field_stage_builder(
        node_type_name,
        node_version,
        field_name,
        with_validation = True
      )

    ver_branches = self._get_field_version_branches(
      node_type_name,
      field_name,
      get_stage_builder_for_version
    )

    writer = CPPVersionBranchWriter(file_ref = 'universal.get_file()')
    for version, stage_builder in ver_branches:
      writer.add_branch(version, stage_builder.build_void())

    return [writer]

  def _write_field_validation(self, node_type_name, field_name, output_stream):
    field_info = self.agg_type_info.get_field_info(
      node_type_name,
      field_name
    )
    field_type_name = field_info.get_type_name()
    field_type_role = self.revision_info.get_type_role(field_type_name)

    if not self._is_role_validated(field_type_role):
      return False

    validation_branch = self._get_field_validation_branch(
      node_type_name,
      field_name
    )

    writer = edgcppgen.BranchWriter()
    writer.add_branch(
      f"has_ifc_{field_name}(universal)",
      validation_branch
    )
    writer.write(output_stream)
    return True

  def _write_validation(self, type_name, type_versions, split_output_stream):
    universal_type_name = self._get_universal_name(type_name)

    function_name = 'validate'
    function_decl_args = [
      [],
      function_name,
      'a_boolean',
      [
        (f"const {universal_type_name}&", 'universal'),
        ('const an_ifc_validation_trace*', 'parent')
      ]
    ]
    decl_output_stream = split_output_stream.get_decl()
    edgcppgen.write_function_template_decl(
      *function_decl_args,
      decl_output_stream,
      specifiers = [],
      terminator = ');'
    )

    def_output_stream = split_output_stream.get_val_def()
    edgcppgen.write_function_template_decl(
      *function_decl_args,
      def_output_stream,
      specifiers = []
    )
    edgcppgen.write_comment(
      f"""
      Given the universal representation of {type_name}, return TRUE if the
      representation is valid; otherwise, return FALSE.
      """,
      def_output_stream,
      large_block = True
    )
    def_output_stream.write('{\n')
    edgcppgen.write_variable_block(
      [
        ('a_boolean', 'result', 'TRUE')
      ],
      def_output_stream
    )

    any_validation_written = False
    for field_name in self.agg_type_info.get_all_field_names(type_name):
      validation_written = self._write_field_validation(
        type_name,
        field_name,
        def_output_stream
      )
      if validation_written:
        any_validation_written = True

    if any_validation_written:
      def_output_stream.write('done:\n')
    def_output_stream.write('  return result;\n')
    edgcppgen.write_function_def_end(function_name, def_output_stream)

  def _add_db_print_cur_indent(self, branch):
    branch.append(edgcppgen.FunctionCallExprWriter(
      'db_print_indent',
      [
        'indent'
      ]
    ))

  def _db_printf(self, format_string, *args):
    return edgcppgen.FunctionCallExprWriter(
      'fprintf',
      [
        'f_debug',
        f"\"{format_string}\"",
        *args
      ]
    )

  def _add_db_printf(self, branch, format_string, *args):
    branch.append(self._db_printf(format_string, *args))

  def _add_db_unimplemented(self, branch, value_label):
    self._add_db_print_cur_indent(branch)
    self._add_db_printf(branch, f"{value_label}: UNIMPLEMENTED\\n")

  def _get_value_debug(self, value_label, value_type_name, value_ref):
    value_type_role = self.revision_info.get_type_role(value_type_name)

    branch = []

    if value_type_role == edgifc.IFCRegistryTypeRole.INDEX_SORT:
      self._add_db_print_cur_indent(branch)
      self._add_db_printf(branch, f"{value_label}:")

      branch_writer = edgcppgen.BranchWriter()

      true_branch = []
      self._add_db_printf(true_branch, ' NULL\\n')
      branch_writer.add_branch(
        f"is_null_index({value_ref})",
        true_branch
      )

      false_branch = []
      self._add_db_printf(false_branch, '\\n')
      self._add_db_print_cur_indent(false_branch)
      self._add_db_printf(
        false_branch,
        '  sort: %s\\n',
        f"str_for({value_ref}.sort)"
      )
      self._add_db_print_cur_indent(false_branch)
      self._add_db_printf(
        false_branch,
        '  value: %llu\\n',
        f"(unsigned long long){value_ref}.value"
      )
      branch_writer.add_fallback(false_branch)

      branch.append(branch_writer)
    elif value_type_role == edgifc.IFCRegistryTypeRole.SIMPLE_SORT:
      self._add_db_print_cur_indent(branch)
      self._add_db_printf(
        branch,
        f"{value_label}: %s\\n",
        f"str_for({value_ref})"
      )
    elif (value_type_role == edgifc.IFCRegistryTypeRole.NODE_OFFSET or
          value_type_role == edgifc.IFCRegistryTypeRole.STRING_TABLE_OFFSET or
          value_type_role == edgifc.IFCRegistryTypeRole.RAW_NUMERIC):
      self._add_db_print_cur_indent(branch)
      self._add_db_printf(
        branch,
        f"{value_label}: %llu\\n",
        f"(unsigned long long){value_ref}.value"
      )
    elif value_type_role == edgifc.IFCRegistryTypeRole.BITFIELD:
      unique_queries = self.agg_type_info.get_bitfield_queries(value_type_name)

      self._add_db_printf(
        branch,
        f"{value_label}:\\n"
      )

      branch.append('++indent;')

      for query in unique_queries:
        formatted_query_name = self._get_universal_enumerator(
          value_type_name,
          query
        )

        test_condition = edgcppgen.BranchWriter()

        bitmask_test_call = edgcppgen.FunctionCallExprWriter(
          f"test_bitmask<{formatted_query_name}>",
          [
            value_ref
          ],
          terminator = ')) {'
        )

        subbranch = []
        self._add_db_print_cur_indent(subbranch)
        self._add_db_printf(
          subbranch,
          f"- {query}\\n"
        )

        test_condition.add_branch(
          bitmask_test_call,
          subbranch
        )

        branch.append(test_condition)

      branch.append('--indent;')

    elif edgifc.is_node_role(value_type_role):
      self._add_db_print_cur_indent(branch)
      self._add_db_printf(branch, f"{value_label}:\\n")

      recursive_call = edgcppgen.FunctionCallExprWriter(
        'db_node',
        [
          value_ref,
          'indent + 1'
        ]
      )
      branch.append(recursive_call)
    elif value_type_role == edgifc.IFCRegistryTypeRole.VALUE_CATEGORY:
      self._add_db_print_cur_indent(branch)
      self._add_db_printf(branch, f"{value_label}:\\n")

      self._add_db_print_cur_indent(branch)
      self._add_db_printf(
        branch,
        '  sort: %s\\n',
        f"str_for({value_ref}.sort)"
      )

      branch.append('++indent;')

      category_switch = edgcppgen.SwitchWriter(f"{value_ref}.sort")
      sort_type_name = self._get_sort_type_name(value_type_name)
      for sort_label in self.agg_type_info.get_all_sort_values(sort_type_name):
        case_type_name = self.agg_type_info.get_category_case_type_name(
          value_type_name,
          sort_label
        )
        case_universal_type_name = self._get_universal_name(case_type_name)
        formatted_enumerator = self._get_universal_enumerator(
          sort_type_name,
          sort_label
        )

        variant_var_name = edgcppgen.to_snake_case(sort_label)
        variant_var_ref_name = f"{edgcppgen.to_acronym(variant_var_name)}_ref"

        sort_branch = []

        debug_logic = self._get_value_debug(
          variant_var_name,
          case_type_name,
          variant_var_ref_name
        )

        if len(debug_logic) == 0:
          self._add_db_unimplemented(sort_branch, variant_var_name)
        else:
          sort_branch.append(edgcppgen.VariableBlockWriter(
            [
              (
                f"{case_universal_type_name}&",
                variant_var_ref_name,
                f"{value_ref}.variant.{variant_var_name}"
              )
            ]
          ))

          sort_branch.extend(debug_logic)

        category_switch.add_case(formatted_enumerator, sort_branch)

      branch.append(category_switch)
      branch.append('--indent;')

    return branch

  def _write_field_debug(self, node_type_name, field_name, output_stream):
    field_info = self.agg_type_info.get_field_info(
      node_type_name,
      field_name
    )

    branch = []

    field_type_name = field_info.get_type_name()
    field_universal_type_name = self._get_universal_name(field_type_name)

    debug_logic = self._get_value_debug(field_name, field_type_name, 'field')

    if len(debug_logic) == 0:
      self._add_db_unimplemented(branch, field_name)
    else:
      branch.append(edgcppgen.VariableBlockWriter(
        [
          (
            field_universal_type_name,
            'field',
            f"get_ifc_{field_name}(universal)"
          )
        ]
      ))

      branch.extend(debug_logic)

    writer = edgcppgen.BranchWriter()
    writer.add_branch(
      f"has_ifc_{field_name}(universal)",
      branch
    )
    writer.write(output_stream)

  def _write_node_debug_low_level(self, type_name, type_versions,
                                  split_output_stream):
    universal_type_name = self._get_universal_name(type_name)

    function_name = 'db_node'
    function_decl_args = [
      function_name,
      'void',
      [
        (f"const {universal_type_name}&", 'universal'),
        ('unsigned', 'indent')
      ]
    ]
    decl_output_stream = split_output_stream.get_decl()
    edgcppgen.write_function_decl(
      *function_decl_args,
      decl_output_stream,
      terminator = ');',
      specifiers = ['extern']
    )

    def_output_stream = split_output_stream.get_dbg_def()
    edgcppgen.write_function_decl(
      *function_decl_args,
      def_output_stream,
      specifiers = []
    )
    edgcppgen.write_comment(
      f"""
      Given the universal representation of {type_name}, print a diagnostic
      textual representation with the given indent.
      """,
      def_output_stream,
      large_block = True
    )
    def_output_stream.write('{\n')

    for field_name in self.agg_type_info.get_all_field_names(type_name):
      self._write_field_debug(
        type_name,
        field_name,
        def_output_stream
      )

    edgcppgen.write_function_def_end(function_name, def_output_stream)

  def _write_node_debug_high_level(self, type_name, type_versions,
                                   split_output_stream):
    # Write a useful overload using the Byte_buffer_entry type.
    universal_type_name = self._get_universal_name(type_name)

    function_name = 'db_node'
    function_decl_args = [
      function_name,
      'void',
      [
        (f"const {universal_type_name}&", 'universal')
      ]
    ]
    decl_output_stream = split_output_stream.get_decl()
    edgcppgen.write_function_decl(
      *function_decl_args,
      decl_output_stream,
      terminator = ');',
      specifiers = ['extern']
    )

    def_output_stream = split_output_stream.get_dbg_def()
    edgcppgen.write_function_decl(
      *function_decl_args,
      def_output_stream,
      specifiers = []
    )
    edgcppgen.write_comment(
      f"""
      Given the universal representation of {type_name}, print a diagnostic
      textual representation.
      """,
      def_output_stream,
      large_block = True
    )
    def_output_stream.write('{\n')
    # Center the header, split it, then reconstruct it with whitespace.  This
    # allows us to print, "pretty C++ code" that at runtime, prints a pretty
    # header.
    for idx, part in enumerate(f" {type_name} ".center(80, '=').split(' ')):
      whitespace = '\\n' if idx == 2 else ' '
      self._db_printf(f"{part}{whitespace}").write(
        def_output_stream,
        indent = '  '
      )
    edgcppgen.FunctionCallExprWriter(
      f"  {function_name}",
      [
        'universal',
        '0'
      ]
    ).write(def_output_stream)
    edgcppgen.write_function_def_end(function_name, def_output_stream)

  def _write_node_debug(self, type_name, type_versions, split_output_stream):
    split_output_stream.get_decl().write('#if DEBUG\n')

    self._write_node_debug_low_level(
      type_name,
      type_versions,
      split_output_stream
    )

    split_output_stream.get_decl().write('\n')
    split_output_stream.get_dbg_def().write('\n\n')

    self._write_node_debug_high_level(
      type_name,
      type_versions,
      split_output_stream
    )

    split_output_stream.get_decl().write('#endif /* DEBUG */\n')

  def _write_node_construct_instantiations(self, type_name, index_type_name,
                                           output_stream):
    universal_type_name = self._get_universal_name(type_name)
    universal_index_type_name = self._get_universal_name(index_type_name)

    edgcppgen.FunctionCallExprWriter(
      'INST_CONSTRUCT_NODE_ALL',
      [
        universal_type_name,
        universal_index_type_name
      ],
      terminator = ')\n'
    ).write(output_stream)

  def _write_node_instantiations(self, type_name, split_output_stream):
    inst_output_stream = split_output_stream.get_tmpl_inst()

    partition_ref_types = (
      self.agg_type_info.get_all_partition_reference_types()
    )
    relevant_ref_types = []
    for ref_type_name in partition_ref_types:
      if self.agg_type_info.is_type_referenced(type_name, ref_type_name):
        relevant_ref_types.append(ref_type_name)

    if len(relevant_ref_types) > 0:
      inst_output_stream.write('\n\n')

      edgcppgen.write_comment(
        f"""
        Explicit instantiations of functions for {type_name}.
        """,
        inst_output_stream,
        large_block = True
      )

    for ref_type_name in relevant_ref_types:
      self._write_node_construct_instantiations(
        type_name,
        ref_type_name,
        inst_output_stream
      )

  def _write_node_desierialize_mmap(self, type_name, type_layout_versions,
                                    output_stream, *, from_header):
    # For the memcpy case, we only care if the byte counts changed/we need to
    # change how many bytes are being copied. Note that it's not safe to simply
    # copy the largest possible version of the type as we might overflow.
    last_type_size = None
    memcpy_writer = CPPVersionBranchWriter(file_ref = 'file')
    for version in type_layout_versions:
      registry = self.version_to_registry[version]
      type_size = registry.get_type(type_name).size()

      if last_type_size is not None and type_size == last_type_size:
        continue
      else:
        last_type_size = type_size

      memcpy_writer.add_branch(
        version,
        [
          edgcppgen.FunctionCallExprWriter(
            'memcpy',
            [
              '*storage',
              'get_byte_buffer(file)',
              f"/*size=*/{type_size}"
            ]
          )
        ]
      )

    storage_method_writer = edgcppgen.BranchWriter()
    storage_method_writer.add_branch(
      'fill_storage',
      [
        memcpy_writer
      ]
    )
    storage_method_writer.add_fallback(
      [
        'storage = (storage_type*)(get_byte_buffer(file));'
      ]
    )

    writer = edgcppgen.BranchWriter(closing_comment = ' else\n')
    memcpy_condition = (
      'host_little_endian' if from_header
      else 'has_matching_endianness(file)'
    )
    writer.add_branch(memcpy_condition, [storage_method_writer])
    writer.write(output_stream)

  def _write_node_field_deserialize(self, registry, type_name,
                                    branch, *, from_header,
                                    breadcrum = '', base_offset = 0):
    type_info = registry.get_type(type_name)

    fields = type_info.fields()
    last_field_idx = len(fields) - 1
    for idx, field in enumerate(fields):
      field_type_name = field.type_name()

      field_name = field.name()
      offset = type_info.field_offset_of(field_name)

      new_breadcrum = (
        f"{field_name}" if len(breadcrum) == 0 else f"{breadcrum}.{field_name}"
      )

      role = registry.get_type_role(field_type_name)
      if edgifc.is_node_role(role):
        self._write_node_field_deserialize(
          registry,
          field_type_name,
          branch,
          from_header = from_header,
          breadcrum = new_breadcrum,
          base_offset = base_offset + offset
        )
      else:
        num_bytes_to_copy = field.size()
        if idx == last_field_idx:
          num_bytes_to_copy += type_info.padding()

        branch.append(
          f"/* {new_breadcrum} */"
        )
        branch.append(
          edgcppgen.FunctionCallExprWriter(
            'get_bytes',
            [
              'file',
              f"(*storage) + {base_offset + offset}",
              f"/*num_bytes=*/{num_bytes_to_copy}",
              f"/*from_header=*/{edgcppgen.to_bool(from_header)}"
            ]
          )
        )

  def _write_node_desierialize_no_mmap(self, type_name, type_layout_versions,
                                       universal_name, output_stream, *,
                                       from_header):
    writer = CPPVersionBranchWriter(file_ref = 'file')

    for version in type_layout_versions:
      registry = self.version_to_registry[version]

      branch = []
      self._write_node_field_deserialize(
        registry,
        type_name,
        branch,
        from_header = from_header
      )
      writer.add_branch(version, branch)

    output_stream.write('  /* Do not put code here. */\n')
    output_stream.write('  {\n')
    writer.write(output_stream, indent = '    ')
    output_stream.write('  }  /* if */\n')

  def _write_node_specialized_desierialize(self, type_name,
                                           split_output_stream, *,
                                           from_header):
    node_storage_type = self._get_universal_storage_name(type_name)
    function_name = f"get<{node_storage_type}>"
    return_type = f"{node_storage_type}*"
    function_decl_args = [
      [],
      function_name,
      return_type,
      [
        ('an_ifc_module_file*', 'file'),
        (f"{node_storage_type}*", 'storage'),
        ('a_boolean', 'fill_storage')
      ]
    ]
    decl_output_stream = split_output_stream.get_decl()
    edgcppgen.write_function_template_decl(
      *function_decl_args,
      decl_output_stream,
      specifiers = [],
      terminator = ');'
    )

    def_output_stream = split_output_stream.get_def()
    edgcppgen.write_function_template_decl(
      *function_decl_args,
      def_output_stream,
      specifiers = []
    )
    edgcppgen.write_comment(
      f"""

      Retrieve an instance of {type_name} from the IFC module file.

      %BREAK%

      If memory mapping is used and both the host and the target have the
      same endianness, then the file layout and the alignment/padding of the
      host must have exactly the same characteristics. In this case, simply
      return a pointer to a suitably-cast byte_buffer and increment it as
      appropriate (the storage argument is unused in this scenario).

      %BREAK%

      Otherwise, the storage passed in to the function is used to store copies
      of each field of the structure and each field is individually copied (and
      byte-swapped if necessary).

      %BREAK%

      If fill_storage is TRUE, always copy the data into the passed storage
      (i.e., the storage specified by the storage argument).
      """,
      def_output_stream,
      large_block = True
    )
    def_output_stream.write('{\n')

    type_layout_versions = self.revision_info.get_type_layout_versions(
      type_name
    )

    def_output_stream.write('#if USE_MMAP_FOR_MODULES\n')
    edgcppgen.write_right_split(
      '  using storage_type =',
      f"{node_storage_type};",
      def_output_stream
    )
    self._write_node_desierialize_mmap(
      type_name,
      type_layout_versions,
      def_output_stream,
      from_header = from_header
    )
    def_output_stream.write('#endif /* USE_MMAP_FOR_MODULES */\n')
    self._write_node_desierialize_no_mmap(
      type_name,
      type_layout_versions,
      node_storage_type,
      def_output_stream,
      from_header = from_header
    )
    def_output_stream.write('  return storage;\n')
    edgcppgen.write_function_def_end(function_name, def_output_stream)

  def _write_node_get_partition_specialization(self, type_name,
                                               split_output_stream):
    node_universal_type = self._get_universal_name(type_name)
    function_name = f"get_ifc_partition_kind<{node_universal_type}>"
    function_decl_args = [
      [],
      function_name,
      'an_ifc_partition_kind',
      []
    ]
    decl_output_stream = split_output_stream.get_decl()
    edgcppgen.write_function_template_decl(
      *function_decl_args,
      decl_output_stream,
      specifiers = [],
      terminator = ');'
    )

    def_output_stream = split_output_stream.get_def()
    edgcppgen.write_function_template_decl(
      *function_decl_args,
      def_output_stream,
      specifiers = []
    )
    edgcppgen.write_comment(
      f"""
      Return the corresponding partition kind for {type_name}.
      """,
      def_output_stream,
      large_block = True
    )
    def_output_stream.write('{\n')
    partition_id = self.agg_type_info.get_partition_for_type_name(type_name)
    partition_enumerator = self._get_partition_enumerator(partition_id)
    def_output_stream.write(f"  return {partition_enumerator};\n")
    edgcppgen.write_function_def_end(
      'get_ifc_partition_kind',
      def_output_stream
    )

  def _write_node(self, type_name, split_output_stream, *,
                  include_deserializer = False, from_header = False):
    try:
      type_versions = self.revision_info.get_type_versions(type_name)

      type_output_stream = split_output_stream.get_type()

      type_output_stream.write('\n\n/*')
      for version in type_versions:
        type_output_stream.write('\n')
        self._write_node_table(type_name, version, type_output_stream)
      type_output_stream.write('*/\n')

      self._write_universal_byte_buffer(type_name, split_output_stream)

      decl_output_stream = split_output_stream.get_decl()
      decl_output_stream.write('\n')
      edgcppgen.write_comment(
        f"""
        Functions for interacting with IFC {type_name} nodes.
        """,
        decl_output_stream,
        large_block = True
      )

      split_output_stream.get_acc_def().write('\n\n')

      self._write_accessors(type_name, type_versions, split_output_stream)

      split_output_stream.get_mut_def().write('\n\n')

      self._write_mutators(type_name, type_versions, split_output_stream)

      decl_output_stream.write('\n')
      split_output_stream.get_val_def().write('\n\n')

      self._write_validation(type_name, type_versions, split_output_stream)

      decl_output_stream.write('\n')
      split_output_stream.get_dbg_def().write('\n\n')

      self._write_node_debug(type_name, type_versions, split_output_stream)

      if include_deserializer:
        decl_output_stream.write('\n')
        split_output_stream.get_def().write('\n\n')
        self._write_node_specialized_desierialize(
          type_name,
          split_output_stream,
          from_header = from_header
        )

      if include_deserializer and not from_header:
        decl_output_stream.write('\n')
        split_output_stream.get_def().write('\n\n')
        self._write_node_get_partition_specialization(
          type_name,
          split_output_stream
        )

        self._write_node_instantiations(type_name, split_output_stream)
    except Exception as e:
      e.add_note(f"while writing the node {type_name}")
      raise

  def _write_node_copy_from_sized_field_template(self, output_stream):
    output_stream.write('\n\n')
    function_name = 'copy_from_node_field'
    edgcppgen.write_function_template_decl(
      [
        ('typename', 'a_Desired_type'),
        ('typename', 'an_ifc_Node_type')
      ],
      function_name,
      'void',
      [
        ('a_Desired_type*', 'result'),
        ('const an_ifc_Node_type*', 'node_start'),
        ('size_t', 'offset'),
        ('size_t', 'size')
      ],
      output_stream
    )
    edgcppgen.write_comment(
      '''
      Given the starting position of a node's storage, the offset into the
      storage of the field, and the field size, copy the field's bytes into
      result.

      %BREAK%

      node_start should be a pointer to the byte array representing the node's
      storage. This will be added to the offset to get the start of the field
      value's bytes. This function guarantees even if the byte position is not
      an aligned representation of the desired type (a_Desired_type), so long
      as the result pointer points to aligned storage, the result will
      be properly aligned.

      %BREAK%

      This function is not a replacement for get_bytes and should NEVER be
      used with byte arrays that do not have the host's endianness. The byte
      array pointed to by node_start should already have been (if necessary)
      realigned to match the host's endianness before being passed to this
      function.

      %BREAK%

      It is strongly advised not to directly use this function in the front
      end, and instead to use a get_ifc_X function to get the field you want
      when working with IFC data. This function exists primarily as an
      implementation detail for code generation to make use of (where code
      generation also handles additional usage/sanity checks).
      ''',
      output_stream,
      large_block = True
    )
    output_stream.write('{\n')
    edgcppgen.write_comment(
      '''
      As the resulting pointer to the beginning of the field can be unaligned,
      casting to the desired type and dereferencing the byte array pointer
      is not an inherently safe operation. While this is not (practically)
      problematic on x86, this can be an issue on some architectures that are
      more sensitive to pointer alignment.

      %BREAK%

      Thus, in the interest of portability, copy the bytes manually with
      memcpy into the aligned storage pointed to by result.
      ''',
      output_stream,
      indent = '  '
    )
    edgcppgen.FunctionCallExprWriter(
      'memcpy',
      [
        'result',
        '(void*)((*node_start) + offset)',
        'size'
      ]
    ).write(output_stream, indent = '  ')
    edgcppgen.write_function_def_end(function_name, output_stream)

  def _write_node_copy_from_field_template(self, output_stream):
    output_stream.write('\n\n')
    function_name = 'copy_from_node_field'
    edgcppgen.write_function_template_decl(
      [
        ('typename', 'a_Desired_type'),
        ('typename', 'an_ifc_Node_type')
      ],
      function_name,
      'void',
      [
        ('a_Desired_type*', 'result'),
        ('const an_ifc_Node_type*', 'node_start'),
        ('size_t', 'offset')
      ],
      output_stream
    )
    edgcppgen.write_comment(
      '''
      Given the starting position of a node's storage, and the offset into the
      storage of the field, copy the field's bytes into result.

      %BREAK%

      node_start should be a pointer to the byte array representing the node's
      storage. This will be added to the offset to get the start of field
      value's bytes. This function guarantees even if the byte position is not
      an aligned representation of the desired type (a_Desired_type), so long
      as the result pointer points to aligned storage, the result will
      be properly aligned.

      %BREAK%

      This function is not a replacement for get_bytes and should NEVER be
      used with byte arrays that do not have the host's endianness. The byte
      array pointed to by node_start should already have been (if necessary)
      realigned to match the host's endianness before being passed to this
      function.

      %BREAK%

      It's additionally important when using this form of copy_from_node_field
      that the result type's byte size corresponds exactly to the byte size of
      the encoded field (otherwise buffer overflow is possible). In terms of
      the IFC versioning code, this means "versioned" types are the only types
      that should be used with this function, "universal" representations are
      NOT safe.

      %BREAK%

      It is strongly advised not to directly use this function in the front
      end, and instead to use a get_ifc_X function to get the field you want
      when working with IFC data. This function exists primarily as an
      implementation detail for code generation to make use of (where code
      generation also handles additional usage/sanity checks).
      ''',
      output_stream,
      large_block = True
    )
    output_stream.write('{\n')
    edgcppgen.FunctionCallExprWriter(
      'copy_from_node_field',
      [
        'result',
        'node_start',
        'offset',
        '/*size=*/sizeof(a_Desired_type)'
      ]
    ).write(output_stream, indent = '  ')
    edgcppgen.write_function_def_end(function_name, output_stream)

  def _write_node_copy_to_sized_field_template(self, output_stream):
    output_stream.write('\n\n')
    function_name = 'copy_to_node_field'
    edgcppgen.write_function_template_decl(
      [
        ('typename', 'a_Field_type'),
        ('typename', 'an_ifc_Node_type')
      ],
      function_name,
      'void',
      [
        ('const a_Field_type*', 'field'),
        ('an_ifc_Node_type*', 'node_start'),
        ('size_t', 'offset'),
        ('size_t', 'size')
      ],
      output_stream
    )
    edgcppgen.write_comment(
      '''
      Given the starting position of a node's storage, the offset into the
      storage of the field, and the field size, copy field's bytes into
      the node.

      %BREAK%

      node_start should be a pointer to the byte array representing the node's
      storage. This will be added to the offset to get the start of the field
      value's bytes. This function guarantees even if the byte position is not
      an aligned representation of the field type (a_Field_type), so long as
      the result pointer points to aligned storage, the result will be properly
      aligned.

      %BREAK%

      It is strongly advised not to directly use this function in the front
      end, and instead to use a set_ifc_X function to modify node data when
      working with IFC data. This function exists primarily as an
      implementation detail for code generation to make use of (where code
      generation also handles additional usage/sanity checks).
      ''',
      output_stream,
      large_block = True
    )
    output_stream.write('{\n')
    edgcppgen.FunctionCallExprWriter(
      'memcpy',
      [
        '(void*)((*node_start) + offset)',
        'field',
        'size'
      ]
    ).write(output_stream, indent = '  ')
    edgcppgen.write_function_def_end(function_name, output_stream)

  def _write_node_copy_to_field_template(self, output_stream):
    output_stream.write('\n\n')
    function_name = 'copy_to_node_field'
    edgcppgen.write_function_template_decl(
      [
        ('typename', 'a_Field_type'),
        ('typename', 'an_ifc_Node_type')
      ],
      function_name,
      'void',
      [
        ('const a_Field_type*', 'field'),
        ('an_ifc_Node_type*', 'node_start'),
        ('size_t', 'offset')
      ],
      output_stream
    )
    edgcppgen.write_comment(
      '''
      Given the starting position of a node's storage and the offset into the
      storage of the field, copy field's bytes into the node.

      %BREAK%

      node_start should be a pointer to the byte array representing the node's
      storage. This will be added to the offset to get the start of field
      value's bytes. This function guarantees even if the byte position is not
      an aligned representation of the desired type (a_Field_type), so long as
      the result pointer points to aligned storage, the result will be properly
      aligned.

      %BREAK%

      It's important when using this form of copy_to_node_field that the result
      type's byte size corresponds exactly to the byte size of the encoded
      field (otherwise buffer overflow is possible). In terms of the IFC
      versioning code, this means "versioned" types are the only types that
      should be used with this function, "universal" representations are NOT
      safe.

      %BREAK%

      It is strongly advised not to directly use this function in the front
      end, and instead to use a set_ifc_X function to modify node data when
      working with IFC data. This function exists primarily as an
      implementation detail for code generation to make use of (where code
      generation also handles additional usage/sanity checks).
      ''',
      output_stream,
      large_block = True
    )
    output_stream.write('{\n')
    edgcppgen.FunctionCallExprWriter(
      'copy_to_node_field',
      [
        'field',
        'node_start',
        'offset',
        '/*size=*/sizeof(a_Field_type)'
      ]
    ).write(output_stream, indent = '  ')
    edgcppgen.write_function_def_end(function_name, output_stream)

  def _write_node_get_template(self, output_stream):
    output_stream.write('\n\n')
    edgcppgen.write_function_template_decl(
      [
        ('typename', 'an_ifc_Node_type')
      ],
      'get',
      'an_ifc_Node_type*',
      [
        ('an_ifc_module_file*', 'file'),
        ('an_ifc_Node_type*', 'storage'),
        ('a_boolean', 'fill_storage = FALSE')
      ],
      output_stream,
      specifiers = ['extern'],
      terminator = ') DELETED_FN_DEF'
    )

  def _write_node_get_partition_template(self, output_stream):
    output_stream.write('\n\n')
    edgcppgen.write_function_template_decl(
      [
        ('typename', 'an_ifc_Node_type')
      ],
      'get_ifc_partition_kind',
      'an_ifc_partition_kind',
      [],
      output_stream,
      specifiers = ['extern'],
      terminator = ') DELETED_FN_DEF'
    )

  def _write_node_accessor_metadata_specialization(self, field_name,
                                                   cpp_type_name,
                                                   node_type_name,
                                                   output_stream):
    universal_type_name = self._get_universal_name(node_type_name)
    edgcppgen.write_comment(
      f"""
      The IFC {field_name} field has multiple return types. This type is a
      metadata type that allows resolution of the return type for
      {node_type_name} nodes.
      """,
      output_stream,
      large_block = True
    )
    output_stream.write(f"template<>\n")
    edgcppgen.write_right_split(
      f"struct {cpp_type_name}<",
      f"{universal_type_name}> {{",
      output_stream,
      inline_join = ''
    )
    field_type_name = self.agg_type_info.get_field_type(
      node_type_name,
      field_name
    )
    field_universal_type_name = self._get_universal_name(field_type_name)
    output_stream.write(
      f"  using return_type = {field_universal_type_name};\n"
    )
    output_stream.write(f"}};  /* {cpp_type_name} */\n")

  def _write_node_accessor_metadata(self, field_name, node_type_names,
                                    output_stream):
    cpp_type_name = self._get_cpp_field_metadata_type(field_name)


    edgcppgen.write_comment(
      f"""
      The IFC {field_name} field has multiple return types. This type is a
      metadata type that allows resolution of those return types based on
      the respective node type.
      """,
      output_stream,
      large_block = True
    )
    output_stream.write(f"template<typename an_ifc_Node_type>\n")
    output_stream.write(f"struct {cpp_type_name};\n")

    for node_type_name in node_type_names:
      output_stream.write('\n\n')
      self._write_node_accessor_metadata_specialization(
        field_name,
        cpp_type_name,
        node_type_name,
        output_stream
      )

  def _write_node_accessor_metadata_templates(self, output_stream):
    field_name_types = self.agg_type_info.get_fields_for_all_nodes()
    for field_name, node_type_names in field_name_types:
      if len(self.agg_type_info.get_types_of_field(field_name)) == 1:
        continue

      output_stream.write('\n\n')
      self._write_node_accessor_metadata(
        field_name,
        node_type_names,
        output_stream
      )

  def _get_node_accessor_template_return_type(self, field_name):
    return_types = self.agg_type_info.get_types_of_field(field_name)
    if len(return_types) == 1:
      return self._get_universal_name(return_types[0])

    metadata_type_name = self._get_cpp_field_metadata_type(field_name)
    return f"typename {metadata_type_name}<an_ifc_Node_type>::return_type"

  def _write_node_accessor_validity_template(self, field_name, output_stream):
    edgcppgen.write_function_template_decl(
      [
        ('typename', 'an_ifc_Node_type')
      ],
      f"has_ifc_{field_name}",
      'a_boolean',
      [
        ('const an_ifc_Node_type&', 'universal')
      ],
      output_stream,
      specifiers = ['extern'],
      terminator = ') DELETED_FN_DEF'
    )

  def _write_node_accessor_template(self, field_name, output_stream):
    edgcppgen.write_function_template_decl(
      [
        ('typename', 'an_ifc_Node_type')
      ],
      f"get_ifc_{field_name}",
      self._get_node_accessor_template_return_type(field_name),
      [
        ('const an_ifc_Node_type&', 'universal')
      ],
      output_stream,
      specifiers = ['extern'],
      terminator = ') DELETED_FN_DEF'
    )

  def _write_node_accessor_templates(self, output_stream):
    field_name_types = self.agg_type_info.get_fields_for_all_nodes()
    for field_name, _ in field_name_types:
      output_stream.write('\n\n')
      self._write_node_accessor_validity_template(field_name, output_stream)
      output_stream.write('\n\n')
      self._write_node_accessor_template(field_name, output_stream)

  def _write_node_mutator_template(self, field_name, output_stream):
    edgcppgen.write_function_template_decl(
      [
        ('typename', 'an_ifc_Node_type'),
        ('typename', 'an_ifc_Value_type')
      ],
      f"set_ifc_{field_name}",
      'void',
      [
        ('an_ifc_Node_type*', 'universal'),
        ('const an_ifc_Value_type&', 'value')
      ],
      output_stream,
      specifiers = ['extern'],
      terminator = ') DELETED_FN_DEF'
    )

  def _write_node_mutator_templates(self, output_stream):
    field_name_types = self.agg_type_info.get_fields_for_all_nodes()
    for field_name, _ in field_name_types:
      output_stream.write('\n\n')
      self._write_node_mutator_template(field_name, output_stream)

  def _write_node_validate_template(self, output_stream):
    output_stream.write('\n\n')
    edgcppgen.write_function_template_decl(
      [
        ('typename', 'an_ifc_Node_type')
      ],
      'validate',
      'a_boolean',
      [
        ('const an_ifc_Node_type&', 'universal'),
        ('const an_ifc_validation_trace*', 'parent')
      ],
      output_stream,
      specifiers = ['extern'],
      terminator = ') DELETED_FN_DEF'
    )

  def _get_partition_enumerator(self, partition_id):
    partition_id = PARTITION_ID_SANITIZATION_REGEX.sub('_', partition_id)
    if partition_id[0] == '_':
      partition_id = partition_id[1:]
    return f"ifc_pk_{partition_id}"

  def _write_partition_kind_enum(self, partition_ids, output_stream):
    output_stream.write('\n\n')

    enumerators = [
      # Build in some special partition kinds.
      ('ifc_pk_none', None)
    ]
    for partition_id in partition_ids:
      enumerator = self._get_partition_enumerator(partition_id)
      enumerators.append((enumerator, None))

    edgcppgen.write_enumeration(
      'an_ifc_partition_kind',
      enumerators,
      output_stream,
      size_type = 'uint32_t'
    )

  def _write_partition_count(self, partition_ids, output_stream):
    output_stream.write('\n\n')
    output_stream.write(f"#define IFC_PARTITION_COUNT {len(partition_ids)}\n")

  def _write_partition_map_element_type(self, output_stream):
    edgcppgen.write_comment(
      f"""
      A method for mapping partition names to an_ifc_partition_kind values.
      Used when reading an IFC file to identify which partitions are which. The
      list is guaranteed to be sorted by the partition name (for binary
      search).
      """,
      output_stream,
      large_block = True
    )
    output_stream.write('struct an_ifc_partition_map {\n')

    name_comment_writer = edgcppgen.CommentWriter(
      '''
      The textual identifier for the IFC partition.
      '''
    )
    edgcppgen.write_field(
      'a_const_char*',
      'name',
      output_stream,
      comment_writer = name_comment_writer
    )

    kind_comment_writer = edgcppgen.CommentWriter(
      '''
      The respective partition kind enumerator.
      '''
    )
    edgcppgen.write_field(
      'an_ifc_partition_kind',
      'kind',
      output_stream,
      comment_writer = kind_comment_writer
    )

    output_stream.write('};  /* an_ifc_partition_map */\n')

  def _write_partition_map_var(self, partition_ids, output_stream):
    output_stream.write(
      'EXTERN an_ifc_partition_map ifc_partition_map[IFC_PARTITION_COUNT]\n'
    )
    output_stream.write('#if VAR_INITIALIZERS\n')
    output_stream.write('= {\n')

    last_idx = len(partition_ids) - 1
    for idx, partition_id in enumerate(partition_ids):
      opt_comma = '' if idx == last_idx else ','
      enumerator = self._get_partition_enumerator(partition_id)

      edgcppgen.write_right_split(
        f"{{ \"{partition_id}\",",
        f"{enumerator} }}{opt_comma}",
        output_stream,
        indent = '  '
      )

    output_stream.write('}\n')
    output_stream.write('#endif /* VAR_INITIALIZERS */\n')
    output_stream.write(';  /* ifc_partition_map */\n')

  def _write_partition_mapping(self, partition_ids, output_stream):
    self._write_partition_map_element_type(output_stream)

    output_stream.write('\n')

    self._write_partition_map_var(partition_ids, output_stream)

  def _write_partition_to_sort_kind(self, index_type_name,
                                    split_output_stream):
    universal_sort_name = self._get_universal_sort_name(index_type_name)

    sort_name = index_type_name.replace('Index', 'Sort')
    function_name = f"to_{edgcppgen.to_snake_case(sort_name)}"
    function_decl_args = [
      function_name,
      universal_sort_name,
      [
        ('an_ifc_partition_kind', 'kind')
      ]
    ]
    decl_output_stream = split_output_stream.get_decl()
    edgcppgen.write_function_decl(
      *function_decl_args,
      decl_output_stream,
      specifiers = ['extern'],
      terminator = ');'
    )

    def_output_stream = split_output_stream.get_def()
    edgcppgen.write_function_decl(
      *function_decl_args,
      def_output_stream,
      specifiers = []
    )
    edgcppgen.write_comment(
      f"""
      Given the partition kind, return the corresponding universal
      representation of {sort_name}. If no corresponding sort kind exists for
      {sort_name}, abort.
      """,
      def_output_stream,
      large_block = True
    )
    def_output_stream.write('{\n')
    edgcppgen.write_variable_block(
      [
        (universal_sort_name, 'result', None)
      ],
      def_output_stream
    )

    switch_writer = edgcppgen.SwitchWriter('kind')

    type_partitions = self.agg_type_info.get_type_partitions_for_index_type(
      index_type_name
    )
    for type_name, partition_id in type_partitions.items():
      partition_enumerator = self._get_partition_enumerator(partition_id)
      sort_enumerator = self._get_universal_enumerator(
        index_type_name,
        type_name
      )

      switch_writer.add_case(
        partition_enumerator,
        [
          f"result = {sort_enumerator};"
        ]
      )

    switch_writer.add_default_case(
      [
        edgcppgen.FunctionCallExprWriter(
          'unexpected_condition_str',
          [
            f"\"No known conversion to {sort_name}.\""
          ]
        )
      ]
    )

    switch_writer.write(def_output_stream)
    def_output_stream.write('  return result;\n')
    edgcppgen.write_function_def_end(function_name, def_output_stream)

  def _write_partition_is_sort_kind(self, index_type_name,
                                    split_output_stream):
    universal_sort_name = self._get_universal_sort_name(index_type_name)

    sort_name = index_type_name.replace('Index', 'Sort')
    function_name = f"is_{edgcppgen.to_snake_case(sort_name)}"
    function_decl_args = [
      function_name,
      'a_boolean',
      [
        ('an_ifc_partition_kind', 'kind')
      ]
    ]
    decl_output_stream = split_output_stream.get_decl()
    edgcppgen.write_function_decl(
      *function_decl_args,
      decl_output_stream,
      specifiers = ['extern'],
      terminator = ');'
    )

    def_output_stream = split_output_stream.get_def()
    edgcppgen.write_function_decl(
      *function_decl_args,
      def_output_stream,
      specifiers = []
    )
    edgcppgen.write_comment(
      f"""
      Given the partition kind, return TRUE if there is a corresponding
      universal representation of {sort_name}; otherwise, return FALSE.
      """,
      def_output_stream,
      large_block = True
    )
    def_output_stream.write('{\n')
    edgcppgen.write_variable_block(
      [
        ('a_boolean', 'result', None)
      ],
      def_output_stream
    )

    switch_writer = edgcppgen.SwitchWriter('kind')

    type_partitions = self.agg_type_info.get_type_partitions_for_index_type(
      index_type_name
    )
    partition_enumerators = []
    for partition_id in type_partitions.values():
      partition_enumerator = self._get_partition_enumerator(partition_id)
      partition_enumerators.append(partition_enumerator)

    switch_writer.add_cases(
      partition_enumerators,
      [
        'result = TRUE;'
      ]
    )

    switch_writer.add_default_case(
      [
        'result = FALSE;'
      ]
    )

    switch_writer.write(def_output_stream)
    def_output_stream.write('  return result;\n')
    edgcppgen.write_function_def_end(function_name, def_output_stream)

  def _write_sort_has_partition_kind(self, index_type_name,
                                     split_output_stream):
    universal_sort_name = self._get_universal_sort_name(index_type_name)

    function_name = f"has_partition_kind"
    function_decl_args = [
      function_name,
      'a_boolean',
      [
        (universal_sort_name, 'sort')
      ]
    ]
    decl_output_stream = split_output_stream.get_decl()
    edgcppgen.write_function_decl(
      *function_decl_args,
      decl_output_stream,
      specifiers = ['extern'],
      terminator = ');'
    )

    def_output_stream = split_output_stream.get_def()
    edgcppgen.write_function_decl(
      *function_decl_args,
      def_output_stream,
      specifiers = []
    )
    sort_name = self._get_sort_type_name(index_type_name)
    edgcppgen.write_comment(
      f"""
      Given the universal representation of {sort_name}, return TRUE if
      there is a corresponding partition kind; otherwise, return FALSE.
      """,
      def_output_stream,
      large_block = True
    )
    def_output_stream.write('{\n')
    edgcppgen.write_variable_block(
      [
        ('a_boolean', 'result', None)
      ],
      def_output_stream
    )

    switch_writer = edgcppgen.SwitchWriter('sort')

    type_partitions = self.agg_type_info.get_type_partitions_for_index_type(
      index_type_name
    )
    true_cases = []
    for type_name, partition_id in type_partitions.items():
      sort_enumerator = self._get_universal_enumerator(
        index_type_name,
        type_name
      )

      true_cases.append(sort_enumerator)

    switch_writer.add_cases(true_cases, ['result = TRUE;'])
    switch_writer.add_default_case(
      [
        f"result = FALSE;"
      ]
    )

    switch_writer.write(def_output_stream)
    def_output_stream.write('  return result;\n')
    edgcppgen.write_function_def_end(function_name, def_output_stream)

  def _write_sort_to_partition_kind(self, index_type_name,
                                    split_output_stream):
    universal_sort_name = self._get_universal_sort_name(index_type_name)

    function_name = f"to_partition_kind"
    function_decl_args = [
      function_name,
      'an_ifc_partition_kind',
      [
        (universal_sort_name, 'sort')
      ]
    ]
    decl_output_stream = split_output_stream.get_decl()
    edgcppgen.write_function_decl(
      *function_decl_args,
      decl_output_stream,
      specifiers = ['extern'],
      terminator = ');'
    )

    def_output_stream = split_output_stream.get_def()
    edgcppgen.write_function_decl(
      *function_decl_args,
      def_output_stream,
      specifiers = []
    )
    sort_name = self._get_sort_type_name(index_type_name)
    edgcppgen.write_comment(
      f"""
      Given the universal representation of {sort_name}, return the
      corresponding partition kind. If no corresponding partition kind exists,
      abort.
      """,
      def_output_stream,
      large_block = True
    )
    def_output_stream.write('{\n')
    edgcppgen.write_variable_block(
      [
        ('an_ifc_partition_kind', 'result', None)
      ],
      def_output_stream
    )

    switch_writer = edgcppgen.SwitchWriter('sort')

    type_partitions = self.agg_type_info.get_type_partitions_for_index_type(
      index_type_name
    )
    for type_name, partition_id in type_partitions.items():
      partition_enumerator = self._get_partition_enumerator(partition_id)
      sort_enumerator = self._get_universal_enumerator(
        index_type_name,
        type_name
      )

      switch_writer.add_case(
        sort_enumerator,
        [
          f"result = {partition_enumerator};"
        ]
      )

    switch_writer.add_default_case(
      [
        'unexpected_condition_str("No known conversion to a partition kind.");'
      ]
    )

    switch_writer.write(def_output_stream)
    def_output_stream.write('  return result;\n')
    edgcppgen.write_function_def_end(function_name, def_output_stream)

  def _write_partitions_to_sort_kind(self, split_output_stream):
    def_output_stream = split_output_stream.get_def()

    intro_block = (
      '''
      Functions for converting IFC partition kinds to various IFC sorts.
      '''
    )
    def_output_stream.write('\n\n')
    edgcppgen.write_comment(
      intro_block,
      def_output_stream,
      large_block = True
    )
    decl_output_stream = split_output_stream.get_decl()
    decl_output_stream.write('\n')
    edgcppgen.write_comment(
      intro_block,
      decl_output_stream,
      large_block = True
    )

    partition_index_types = self.agg_type_info.get_all_partition_index_types()
    for index_type_name in partition_index_types:
      decl_output_stream.write('\n')
      def_output_stream.write('\n\n')
      self._write_partition_is_sort_kind(index_type_name, split_output_stream)
      decl_output_stream.write('\n')
      def_output_stream.write('\n\n')
      self._write_partition_to_sort_kind(index_type_name, split_output_stream)

  def _write_partitions_to_element_size(self, partition_ids,
                                        split_output_stream):
    function_name = f"get_ifc_partition_element_size"
    function_decl_args = [
      function_name,
      'an_ifc_entity_size_storage',
      [
        ('an_ifc_module_file*', 'file'),
        ('an_ifc_partition_kind', 'kind')
      ]
    ]
    decl_output_stream = split_output_stream.get_decl()
    edgcppgen.write_function_decl(
      *function_decl_args,
      decl_output_stream,
      specifiers = ['extern'],
      terminator = ');'
    )

    def_output_stream = split_output_stream.get_def()
    edgcppgen.write_function_decl(
      *function_decl_args,
      def_output_stream,
      specifiers = []
    )
    edgcppgen.write_comment(
      f"""
      Given the partition kind and the associated module file, return the
      corresponding expected partition element size.
      """,
      def_output_stream,
      large_block = True
    )
    def_output_stream.write('{\n')
    edgcppgen.write_variable_block(
      [
        ('an_ifc_entity_size_storage', 'result', None)
      ],
      def_output_stream
    )

    switch_writer = edgcppgen.SwitchWriter('kind')

    for partition_id in partition_ids:
      type_name = self.agg_type_info.get_type_name_for_partition(partition_id)
      type_layout_versions = self.revision_info.get_type_layout_versions(
        type_name
      )

      branch_writer = CPPVersionBranchWriter()
      last_size = 0
      for type_version in type_layout_versions:
        registry = self.version_to_registry[type_version]

        size = registry.get_type(type_name).size()
        if size == last_size:
          continue
        last_size = size

        branch_writer.add_branch(type_version, [f"result = {size};"])

      partition_enumerator = self._get_partition_enumerator(partition_id)
      switch_writer.add_case(
        partition_enumerator,
        [branch_writer]
      )

    unexpected_none_partition_call = edgcppgen.FunctionCallExprWriter(
      'unexpected_condition_str',
      [
        '"Attempted to get the size of the \\"none\\" partition."'
      ]
    )
    switch_writer.add_case('ifc_pk_none', [unexpected_none_partition_call])

    switch_writer.write(def_output_stream)
    def_output_stream.write('  return result;\n')
    edgcppgen.write_function_def_end(function_name, def_output_stream)

  def _write_sorts_to_partition_kind(self, split_output_stream):
    def_output_stream = split_output_stream.get_def()

    intro_block = (
      '''
      Functions for converting various IFC sorts to IFC partition kinds.
      '''
    )
    def_output_stream.write('\n\n')
    edgcppgen.write_comment(
      intro_block,
      def_output_stream,
      large_block = True
    )
    decl_output_stream = split_output_stream.get_decl()
    decl_output_stream.write('\n')
    edgcppgen.write_comment(
      intro_block,
      decl_output_stream,
      large_block = True
    )

    partition_index_types = self.agg_type_info.get_all_partition_index_types()
    for index_type_name in partition_index_types:
      decl_output_stream.write('\n')
      def_output_stream.write('\n\n')
      self._write_sort_has_partition_kind(index_type_name, split_output_stream)
      decl_output_stream.write('\n')
      def_output_stream.write('\n\n')
      self._write_sort_to_partition_kind(index_type_name, split_output_stream)

  def _write_partition_info(self, split_output_stream):
    type_output_stream = split_output_stream.get_type()

    partition_ids = set()
    for version in edgifc.SUPPORTED_VERSIONS:
      registry = self.version_to_registry[version]
      partition_ids.update(registry.get_all_partitions())

    partition_ids = list(partition_ids)
    partition_ids.sort()

    self._write_partition_kind_enum(partition_ids, type_output_stream)
    self._write_partition_count(partition_ids, type_output_stream)

    type_output_stream.write('\n')
    self._write_partition_mapping(partition_ids, type_output_stream)

    split_output_stream.get_decl().write('\n')
    split_output_stream.get_def().write('\n\n')
    self._write_partitions_to_element_size(partition_ids, split_output_stream)
    self._write_partitions_to_sort_kind(split_output_stream)
    self._write_sorts_to_partition_kind(split_output_stream)

  def _write_visitor_dereference_case(self, index_type_name, node_type_name,
                                      deref_function_name,
                                      construct_valid_branch, switch_writer,
                                      *, trust_data_path = False):
    universal_index_type_name = self._get_universal_name(index_type_name)
    data_source = 'universal' if trust_data_path else '*opt_universal'
    dereferenced_vars = [
      (
        universal_index_type_name,
        'remote_idx',
        f"{deref_function_name}({data_source})"
      )
    ]


    node_universal_type_name = self._get_universal_name(node_type_name)
    enumerator = self._get_universal_enumerator(
      index_type_name,
      node_type_name
    )
    if trust_data_path:
      universal_vars = edgcppgen.VariableBlockWriter(
        [
          (node_universal_type_name, 'universal', None)
        ]
      )

      node_construct_expr = edgcppgen.FunctionCallExprWriter(
        'construct_node_prechecked',
        [
          '&universal',
          'idx'
        ]
      )

      dereference_vars_writer = edgcppgen.VariableBlockWriter(
        dereferenced_vars,
        include_preceding_line = True,
        include_trailing_line = False
      )

      switch_writer.add_case(enumerator, [
        universal_vars,
        node_construct_expr,
        dereference_vars_writer,
        *construct_valid_branch
      ])
    else:
      universal_vars = edgcppgen.VariableBlockWriter(
        [
          (f"Opt<{node_universal_type_name}>", 'opt_universal', None)
        ]
      )

      node_construct_expr = edgcppgen.FunctionCallExprWriter(
        'construct_node',
        [
          '&opt_universal',
          'idx'
        ]
      )

      dereference_vars_writer = edgcppgen.VariableBlockWriter(
        dereferenced_vars
      )

      construct_check_writer = edgcppgen.BranchWriter()
      construct_check_writer.add_branch(
        'opt_universal.has_value()',
        [
          dereference_vars_writer,
          *construct_valid_branch
        ]
      )

      switch_writer.add_case(enumerator, [
        universal_vars,
        node_construct_expr,
        construct_check_writer
      ])

  def _get_validation_visitor_statements(self, index_type_name,
                                         node_type_name):
    universal_node_type_name = self._get_universal_name(node_type_name)
    var_block_writer = edgcppgen.VariableBlockWriter(
      [
        (f"Opt<{universal_node_type_name}>", 'opt_universal', None)
      ]
    )

    return [
      var_block_writer,
      'construct_node(&opt_universal, idx);',
    ]

  def _write_validation_visitor_case(self, index_type_name, node_type_name,
                                     switch_writer):
    enumerator = self._get_universal_enumerator(
      index_type_name,
      node_type_name
    )

    stmts = self._get_validation_visitor_statements(
      index_type_name,
      node_type_name
    )
    stmts.append('result = opt_universal.has_value();')

    switch_writer.add_case(enumerator, stmts)

  def _write_validation_visitor(self, index_type_name, split_output_stream):
    universal_index_type_name = self._get_universal_name(index_type_name)

    function_name = 'validate'
    function_decl_args = [
      function_name,
      'a_boolean',
      [
        (universal_index_type_name, 'idx')
      ]
    ]
    decl_output_stream = split_output_stream.get_decl()
    edgcppgen.write_function_decl(
      *function_decl_args,
      decl_output_stream,
      specifiers = ['extern'],
      terminator = ');'
    )

    def_output_stream = split_output_stream.get_def()
    edgcppgen.write_function_decl(
      *function_decl_args,
      def_output_stream,
      specifiers = []
    )
    edgcppgen.write_comment(
      f"""
      Given the {index_type_name}, validate the associated node. Return
      TRUE if the node's representation is valid; otherwise, return FALSE.
      """,
      def_output_stream,
      large_block = True
    )
    def_output_stream.write('{\n')

    index_type_role = self.revision_info.get_type_role(index_type_name)
    if index_type_role == edgifc.IFCRegistryTypeRole.NODE_OFFSET:
      node_type_name, _ = (
        self.agg_type_info.get_type_partition_for_node_offset_type(
          index_type_name
        )
      )
      stmts = self._get_validation_visitor_statements(
        index_type_name,
        node_type_name
      )
      stmts.append('return opt_universal.has_value();')

      edgcppgen.write_stmt_seq(stmts, def_output_stream)
    elif index_type_role == edgifc.IFCRegistryTypeRole.INDEX_SORT:
      edgcppgen.write_variable_block(
        [
          ('a_boolean', 'result', 'FALSE')
        ],
        def_output_stream
      )

      dereference_mapping = {}
      index_name = self._get_index_name(index_type_name)
      if index_name in self._visitor_implicit_dereference:
        dereference_mapping = self._visitor_implicit_dereference[index_name]

      switch_writer = edgcppgen.SwitchWriter('idx.sort')
      type_partitions = self.agg_type_info.get_type_partitions_for_index_type(
        index_type_name
      )
      for node_type_name in type_partitions.keys():
        if node_type_name in dereference_mapping:
          construct_valid_branch_writer = edgcppgen.BranchWriter()
          construct_valid_branch_writer.add_branch(
            f"{function_name}(remote_idx)",
            ['result = TRUE;']
          )

          self._write_visitor_dereference_case(
            index_type_name,
            node_type_name,
            dereference_mapping[node_type_name],
            [construct_valid_branch_writer],
            switch_writer
          )
        else:
          self._write_validation_visitor_case(
            index_type_name,
            node_type_name,
            switch_writer
          )

      switch_writer.add_default_case(
        [
          'unexpected_condition_str("No known way to validate '
          'partition kind.");'
        ]
      )
      switch_writer.write(def_output_stream)
      def_output_stream.write('  return result;\n')
    else:
      assert False, f"Unexpected node role: {index_type_role}"

    edgcppgen.write_function_def_end(function_name, def_output_stream)

  def _write_has_value_visitor_case(self, index_type_name, node_type_name,
                                    field_name, switch_writer):
    enumerator = self._get_universal_enumerator(
      index_type_name,
      node_type_name
    )

    switch_writer.add_case(
      enumerator,
      [
        self._get_branch_writer_for_accessor_validity(
          node_type_name,
          field_name
        )
      ]
    )

  def _write_has_value_visitor(self, index_name, field_name,
                               expected_field_type, split_output_stream, *,
                               conversions = {}):
    index_type_name = f"{index_name}Index"
    universal_index_type_name = self._get_universal_name(index_type_name)

    function_name = f"has_ifc_{field_name}"
    function_decl_args = [
      function_name,
      'a_boolean',
      [
        (universal_index_type_name, 'idx')
      ]
    ]
    decl_output_stream = split_output_stream.get_decl()
    edgcppgen.write_function_decl(
      *function_decl_args,
      decl_output_stream,
      specifiers = [],
      terminator = ');'
    )

    def_output_stream = split_output_stream.get_def()
    edgcppgen.write_function_decl(
      *function_decl_args,
      def_output_stream,
      specifiers = []
    )
    edgcppgen.write_comment(
      f"""
      Given the {index_type_name}, test whether the associated node has the
      field "{field_name}". Return TRUE if the node has the field
      "{field_name}"; otherwise, return FALSE.
      """,
      def_output_stream,
      large_block = True
    )
    def_output_stream.write('{\n')

    edgcppgen.write_variable_block(
      [
        ('an_ifc_module_file*', 'file', 'idx.file'),
        ('a_boolean', 'result', 'FALSE')
      ],
      def_output_stream
    )

    switch_writer = edgcppgen.SwitchWriter('idx.sort')

    handled_node_type_names = set()
    node_type_names = self.agg_type_info.get_all_sort_values(index_type_name)
    for node_type_name in node_type_names:
      field_exists_for_type_in_sort = self.agg_type_info.has_any_field_named(
        node_type_name,
        field_name
      )
      if not field_exists_for_type_in_sort:
        continue

      field_type = self.agg_type_info.get_field_type(
        node_type_name,
        field_name
      )
      universal_field_type = self._get_universal_name(field_type)
      if universal_field_type != expected_field_type:
        if universal_field_type in conversions:
          conversion_writer = conversions[universal_field_type]
          self._write_has_value_visitor_case(
            index_type_name,
            node_type_name,
            field_name,
            switch_writer
          )
        continue

      handled_node_type_names.add(node_type_name)
      self._write_has_value_visitor_case(
        index_type_name,
        node_type_name,
        field_name,
        switch_writer
      )

    if index_name in self._visitor_implicit_dereference:
      dereference_mapping = self._visitor_implicit_dereference[index_name]
      for node_type_name, deref_function_name in dereference_mapping.items():
        if node_type_name in handled_node_type_names:
          continue

        construct_valid_branch_writer = edgcppgen.BranchWriter()
        construct_valid_branch_writer.add_branch(
          f"{function_name}(remote_idx)",
          ['result = TRUE;']
        )

        self._write_visitor_dereference_case(
          index_type_name,
          node_type_name,
          deref_function_name,
          [construct_valid_branch_writer],
          switch_writer
        )

    switch_writer.add_default_case(['result = FALSE;'])
    switch_writer.write(def_output_stream)
    def_output_stream.write('  return result;\n')
    edgcppgen.write_function_def_end(function_name, def_output_stream)

  def _write_value_visitor_case(self, index_type_name, node_type_name,
                                field_name, switch_writer):
    enumerator = self._get_universal_enumerator(
      index_type_name,
      node_type_name
    )

    universal_node_type_name = self._get_universal_name(node_type_name)
    var_block_writer = edgcppgen.VariableBlockWriter(
      [
        (universal_node_type_name, 'universal', None)
      ]
    )

    switch_writer.add_case(
      enumerator,
      [
        var_block_writer,
        'construct_node_prechecked(&universal, idx);',
        f"result = get_ifc_{field_name}(universal);"
      ]
    )

  def _write_value_visitor_case_conversion(self, index_type_name,
                                           node_type_name, field_name,
                                           unconverted_type, conversion_writer,
                                           switch_writer):
    enumerator = self._get_universal_enumerator(
      index_type_name,
      node_type_name
    )

    universal_node_type_name = self._get_universal_name(node_type_name)
    field_type_name = self.agg_type_info.get_field_type(
      node_type_name,
      field_name
    )
    raw_result_type = self._get_accessor_return_type(field_type_name)
    var_block_writer = edgcppgen.VariableBlockWriter(
      [
        (universal_node_type_name, 'universal', None),
        (raw_result_type, 'raw_result', None)
      ]
    )

    switch_writer.add_case(
      enumerator,
      [
        var_block_writer,
        'construct_node_prechecked(&universal, idx);',
        f"raw_result = get_ifc_{field_name}(universal);",
        conversion_writer
      ]
    )

  def _write_value_visitor(self, index_name, field_name,
                           expected_field_type, split_output_stream, *,
                           conversions = {}):
    index_type_name = f"{index_name}Index"
    universal_index_type_name = self._get_universal_name(index_type_name)

    function_name = f"get_ifc_{field_name}"
    function_decl_args = [
      function_name,
      expected_field_type,
      [
        (universal_index_type_name, 'idx')
      ]
    ]
    decl_output_stream = split_output_stream.get_decl()
    edgcppgen.write_function_decl(
      *function_decl_args,
      decl_output_stream,
      specifiers = ['extern'],
      terminator = ');'
    )

    def_output_stream = split_output_stream.get_def()
    edgcppgen.write_function_decl(
      *function_decl_args,
      def_output_stream,
      specifiers = []
    )
    edgcppgen.write_comment(
      f"""
      Given the {index_type_name}, return the universal representation of the
      associated node's "{field_name}" field value.
      """,
      def_output_stream,
      large_block = True
    )
    def_output_stream.write('{\n')
    edgcppgen.write_variable_block(
      [
        (expected_field_type, 'result', None)
      ],
      def_output_stream
    )

    switch_writer = edgcppgen.SwitchWriter('idx.sort')

    handled_node_type_names = set()
    node_type_names = self.agg_type_info.get_all_sort_values(index_type_name)
    for node_type_name in node_type_names:
      field_exists_for_type_in_sort = self.agg_type_info.has_any_field_named(
        node_type_name,
        field_name
      )
      if not field_exists_for_type_in_sort:
        continue

      field_type = self.agg_type_info.get_field_type(
        node_type_name,
        field_name
      )
      universal_field_type = self._get_universal_name(field_type)
      if universal_field_type != expected_field_type:
        if universal_field_type in conversions:
          conversion_writer = conversions[universal_field_type]
          self._write_value_visitor_case_conversion(
            index_type_name,
            node_type_name,
            field_name,
            universal_field_type,
            conversion_writer,
            switch_writer
          )
        continue

      handled_node_type_names.add(node_type_name)
      self._write_value_visitor_case(
        index_type_name,
        node_type_name,
        field_name,
        switch_writer
      )

    if index_name in self._visitor_implicit_dereference:
      dereference_mapping = self._visitor_implicit_dereference[index_name]
      for node_type_name, deref_function_name in dereference_mapping.items():
        if node_type_name in handled_node_type_names:
          continue

        self._write_visitor_dereference_case(
          index_type_name,
          node_type_name,
          deref_function_name,
          [f"result = {function_name}(remote_idx);"],
          switch_writer,
          trust_data_path = True
        )

    switch_writer.add_default_case(
      [
        f"unexpected_condition_str(\"Invalid query, no {field_name} value.\");"
      ]
    )

    switch_writer.write(def_output_stream)
    def_output_stream.write('  return result;\n')
    edgcppgen.write_function_def_end(function_name, def_output_stream)

  def _write_validation_visitors(self, split_output_stream):
    def_output_stream = split_output_stream.get_def()

    intro_block = (
      '''
      Visitor functions for validating the nodes at a given index.
      '''
    )
    def_output_stream.write('\n\n')
    edgcppgen.write_comment(
      intro_block,
      def_output_stream,
      large_block = True
    )
    decl_output_stream = split_output_stream.get_decl()
    decl_output_stream.write('\n')
    edgcppgen.write_comment(
      intro_block,
      decl_output_stream,
      large_block = True
    )

    partition_types = self.agg_type_info.get_all_partition_reference_types()
    for index_type_name in partition_types:
      decl_output_stream.write('\n')
      def_output_stream.write('\n\n')
      self._write_validation_visitor(index_type_name, split_output_stream)

  def _write_value_visitors(self, split_output_stream):
    def_output_stream = split_output_stream.get_def()

    for index, field_name, return_type, extra_args in self._value_visitors:
      intro_block = (
        f"""
        Visitor functions for retrieving {field_name} values from nodes on the
        {index}Index.
        """
      )
      def_output_stream.write('\n\n')
      edgcppgen.write_comment(
        intro_block,
        def_output_stream,
        large_block = True
      )
      decl_output_stream = split_output_stream.get_decl()
      decl_output_stream.write('\n')
      edgcppgen.write_comment(
        intro_block,
        decl_output_stream,
        large_block = True
      )

      decl_output_stream.write('\n')
      def_output_stream.write('\n\n')
      self._write_has_value_visitor(
        index,
        field_name,
        return_type,
        split_output_stream,
        **extra_args
      )
      decl_output_stream.write('\n')
      def_output_stream.write('\n\n')
      self._write_value_visitor(
        index,
        field_name,
        return_type,
        split_output_stream,
        **extra_args
      )

  def _get_debug_visitor_statements(self, index_type_name, node_type_name):
    universal_node_type_name = self._get_universal_name(node_type_name)
    var_block_writer = edgcppgen.VariableBlockWriter(
      [
        (universal_node_type_name, 'universal', None)
      ]
    )

    return [
      var_block_writer,
      'construct_node_prechecked(&universal, idx);',
      'db_node(universal);'
    ]

  def _write_debug_visitor_case(self, index_type_name, node_type_name,
                                switch_writer):
    enumerator = self._get_universal_enumerator(
      index_type_name,
      node_type_name
    )
    stmts = self._get_debug_visitor_statements(
      index_type_name,
      node_type_name
    )

    switch_writer.add_case(enumerator, stmts)

  def _write_debug_visitor(self, index_type_name, split_output_stream):
    universal_index_type_name = self._get_universal_name(index_type_name)

    function_name = f"db_node_at_idx"
    function_decl_args = [
      function_name,
      'void',
      [
        (universal_index_type_name, 'idx')
      ]
    ]
    decl_output_stream = split_output_stream.get_decl()
    edgcppgen.write_function_decl(
      *function_decl_args,
      decl_output_stream,
      specifiers = ['extern'],
      terminator = ');'
    )

    def_output_stream = split_output_stream.get_dbg_def()
    edgcppgen.write_function_decl(
      *function_decl_args,
      def_output_stream,
      specifiers = []
    )
    edgcppgen.write_comment(
      f"""
      Given the {index_type_name}, print a diagnostic textual representation of
      the associated node.
      """,
      def_output_stream,
      large_block = True
    )
    def_output_stream.write('{\n')

    valid_branch_stmts = []
    invalid_branch_stmts = []

    index_type_role = self.revision_info.get_type_role(index_type_name)
    if index_type_role == edgifc.IFCRegistryTypeRole.NODE_OFFSET:
      node_type_name, _ = (
        self.agg_type_info.get_type_partition_for_node_offset_type(
          index_type_name
        )
      )
      stmts = self._get_debug_visitor_statements(
        index_type_name,
        node_type_name
      )

      valid_branch_stmts.extend(stmts)
      invalid_branch_stmts.append(
        f"fputs(\"Invalid {node_type_name} node.\\n\", f_debug);"
      )
    elif index_type_role == edgifc.IFCRegistryTypeRole.INDEX_SORT:
      switch_writer = edgcppgen.SwitchWriter('idx.sort')
      node_type_names = self.agg_type_info.get_type_partitions_for_index_type(
        index_type_name
      )

      for node_type_name in node_type_names.keys():
        self._write_debug_visitor_case(
          index_type_name,
          node_type_name,
          switch_writer
        )

      switch_writer.add_default_case(
        [
          self._db_printf("Node not found.")
        ]
      )

      valid_branch_stmts.append(switch_writer)
      self._add_db_printf(
        invalid_branch_stmts,
        'Invalid %s node.\\n',
        'str_for(idx.sort)'
      )
    else:
      assert False, f"Unexpected node role: {index_type_role}"

    branch_writer = edgcppgen.BranchWriter()
    branch_writer.add_branch(
      'validate(idx)',
      valid_branch_stmts
    )
    branch_writer.add_fallback(invalid_branch_stmts)
    branch_writer.write(def_output_stream)

    edgcppgen.write_function_def_end(function_name, def_output_stream)

  def _write_debug_visitors(self, split_output_stream):
    def_output_stream = split_output_stream.get_dbg_def()
    decl_output_stream = split_output_stream.get_decl()

    intro_block = (
      f"""
      Visitor functions for printing diagnostic textual representations on
      a given index.
      """
    )
    def_output_stream.write('\n\n')
    edgcppgen.write_comment(
      intro_block,
      def_output_stream,
      large_block = True
    )
    decl_output_stream = split_output_stream.get_decl()
    decl_output_stream.write('\n')
    edgcppgen.write_comment(
      intro_block,
      decl_output_stream,
      large_block = True
    )

    partition_types = self.agg_type_info.get_all_partition_reference_types()
    for index_type_name in partition_types:
      decl_output_stream.write('\n')
      def_output_stream.write('\n\n')
      self._write_debug_visitor(index_type_name, split_output_stream)

  def _write_visitors(self, split_output_stream):
    self._write_validation_visitors(split_output_stream)
    self._write_value_visitors(split_output_stream)
    self._write_debug_visitors(split_output_stream)

  def write_core(self, split_output_stream, *, standalone = False):
    # Unwrap the split output stream, as these get used quite a bit in this
    # function.
    type_output_stream = split_output_stream.get_type()
    decl_output_stream = split_output_stream.get_decl()
    def_output_stream = split_output_stream.get_def()
    acc_def_output_stream = split_output_stream.get_acc_def()
    dbg_def_output_stream = split_output_stream.get_dbg_def()
    mut_def_output_stream = split_output_stream.get_mut_def()
    val_def_output_stream = split_output_stream.get_val_def()
    inst_output_stream = split_output_stream.get_tmpl_inst()
    spec_output_stream = split_output_stream.get_tmpl_spec()

    split_output_stream.write(COPYRIGHT_NOTICE)
    split_output_stream.write('\n\n')
    type_output_stream.write(TYPE_FILE_HEADER)
    decl_output_stream.write(DECL_FILE_HEADER)
    def_output_stream.write(DEF_FILE_HEADER)
    acc_def_output_stream.write(ACC_DEF_FILE_HEADER)
    dbg_def_output_stream.write(DBG_DEF_FILE_HEADER)
    mut_def_output_stream.write(MUT_DEF_FILE_HEADER)
    val_def_output_stream.write(VAL_DEF_FILE_HEADER)
    inst_output_stream.write(TEMPL_INST_FILE_HEADER)
    spec_output_stream.write(TEMPL_SPEC_FILE_HEADER)

    if standalone:
      type_output_stream.write('\n\n')
      type_output_stream.write(EDG_MACRO_PRELUDE)

      split_output_stream.get_all_def().write('\n')
      split_output_stream.get_all_def().write('#include "ifc_map.h"\n')
      split_output_stream.get_all_def().write('#include "ifc_map_functions.h"')
    else:
      split_output_stream.get_all_def().write('\n\n')
      split_output_stream.get_all_def().write(
        '#include "basic_hdrs.h"\n'
        '#include "checking.h"\n'
        '#include "header_util.h"\n'
        '#include "ifc_map.h"\n'
        '#include "ifc_map_functions.h"\n'
        '#include "ifc_modules_internal.h"\n'
      )

      split_output_stream.get_all_def().write(
        '\n\n#if !STANDALONE_UTILITY_PROGRAM'
      )

    split_output_stream.write('\n\n')

    dbg_def_output_stream.write('#if DEBUG\n\n')

    split_output_stream.write(EDG_NAMESPACE_START)
    split_output_stream.write('\n\n')
    split_output_stream.write(EDG_DISABLE_SPURIOUS_WARNINGS_START)

    if standalone:
      # Add a newline to finish the file header and add a single blank line
      # before the start of the standalone prelude.
      type_output_stream.write('\n\n')
      type_output_stream.write(STANDALONE_TYPE_PRELUDE)

      decl_output_stream.write('\n\n')
      decl_output_stream.write(STANDALONE_DECL_PRELUDE)

    # Add a newline to finish the file header or standalone prelude.
    split_output_stream.write('\n')

    self._write_is_supported_check(split_output_stream)

    self._write_buffer_get_size_template(decl_output_stream)

    self._write_byte_buffer_type(split_output_stream)

    raw_byte_types = self.revision_info.get_types_by_role(
      edgifc.IFCRegistryTypeRole.RAW_BYTES
    )
    raw_byte_types.sort()
    for type_name in raw_byte_types:
      self._write_raw_byte(type_name, split_output_stream)

    raw_numeric_types = self.revision_info.get_types_by_role(
      edgifc.IFCRegistryTypeRole.RAW_NUMERIC
    )
    raw_numeric_types.sort()
    for type_name in raw_numeric_types:
      self._write_raw_numeric(type_name, split_output_stream)

    simple_sort_types = self.revision_info.get_types_by_role(
      edgifc.IFCRegistryTypeRole.SIMPLE_SORT
    )
    simple_sort_types.sort()
    for type_name in simple_sort_types:
      self._write_simple_sort(type_name, split_output_stream)

    index_sort_types = self.revision_info.get_types_by_role(
      edgifc.IFCRegistryTypeRole.INDEX_SORT
    )
    index_sort_types.sort()
    for type_name in index_sort_types:
      self._write_index_sort(type_name, split_output_stream)

    self._write_index_alias_type(split_output_stream)

    string_table_offset_types = self.revision_info.get_types_by_role(
      edgifc.IFCRegistryTypeRole.STRING_TABLE_OFFSET
    )
    string_table_offset_types.sort()
    for type_name in string_table_offset_types:
      self._write_string_table_offset(type_name, split_output_stream)

    foreign_index_types = self.revision_info.get_types_by_role(
      edgifc.IFCRegistryTypeRole.FOREIGN_INDEX
    )
    foreign_index_types.sort()
    for type_name in foreign_index_types:
      self._write_foreign_index(type_name, split_output_stream)

    bitfield_types = self.revision_info.get_types_by_role(
      edgifc.IFCRegistryTypeRole.BITFIELD
    )
    bitfield_types.sort()
    for type_name in bitfield_types:
      self._write_bitfield(type_name, split_output_stream)

    value_category_types = self.revision_info.get_types_by_role(
      edgifc.IFCRegistryTypeRole.VALUE_CATEGORY
    )
    value_category_types.sort()
    for type_name in value_category_types:
      self._write_value_category(type_name, split_output_stream)

    self._write_node_copy_from_sized_field_template(decl_output_stream)
    self._write_node_copy_from_field_template(decl_output_stream)
    self._write_node_copy_to_sized_field_template(decl_output_stream)
    self._write_node_copy_to_field_template(decl_output_stream)
    self._write_node_get_template(decl_output_stream)
    self._write_node_get_partition_template(decl_output_stream)
    self._write_node_accessor_metadata_templates(
      decl_output_stream
    )
    self._write_node_accessor_templates(decl_output_stream)
    self._write_node_mutator_templates(decl_output_stream)
    self._write_node_validate_template(decl_output_stream)

    # Consume the nodes by role, in the order where there's least likely to be
    # a dependency issue for the prioritizer to resolve.
    basic_node_types = self.revision_info.get_types_by_role(
      edgifc.IFCRegistryTypeRole.BASIC_NODE
    )
    basic_node_types.sort()
    for type_name in basic_node_types:
      self._write_node(type_name, split_output_stream)

    header_node_types = self.revision_info.get_types_by_role(
      edgifc.IFCRegistryTypeRole.HEADER_NODE
    )
    header_node_types.sort()
    for type_name in header_node_types:
      self._write_node(
        type_name,
        split_output_stream,
        include_deserializer = True,
        from_header = True
      )

    partition_node_types = self.revision_info.get_types_by_role(
      edgifc.IFCRegistryTypeRole.PARTITION_NODE
    )
    partition_node_types.sort()
    for type_name in partition_node_types:
      self._write_node(
        type_name,
        split_output_stream,
        include_deserializer = True
      )

    node_offset_types = self.revision_info.get_types_by_role(
      edgifc.IFCRegistryTypeRole.NODE_OFFSET
    )
    node_offset_types.sort()
    for type_name in node_offset_types:
      self._write_node_offset(type_name, split_output_stream)

    self._write_partition_info(split_output_stream)

    self._write_visitors(split_output_stream)

    split_output_stream.write('\n\n')
    split_output_stream.write(EDG_DISABLE_SPURIOUS_WARNINGS_END)
    split_output_stream.write('\n\n')
    split_output_stream.write(EDG_NAMESPACE_END)
    split_output_stream.write('\n')

    dbg_def_output_stream.write('\n#endif /* DEBUG */\n')

    if not standalone:
      split_output_stream.get_all_def().write(
        '\n#endif /* !STANDALONE_UTILITY_PROGRAM */\n'
      )

    split_output_stream.write('\n')

class IFCTextOffsetToNameIndex:
  def __init__(self):
    self._call_writer = edgcppgen.FunctionCallExprWriter(
      'result = an_ifc_name_index',
      [
        'raw_result.file',
        'ifc_ns_text_offset',
        'raw_result.value'
      ],
      terminator = '};\n'
    )

  def write(self, output_stream, *, indent = '', existing_indent = 0):
    self._call_writer.write(output_stream, indent = indent,
                            existing_indent = existing_indent)

def load_registries():
  version_to_registry = {}
  for version in edgifc.SUPPORTED_VERSIONS:
    try:
      version_to_registry[version] = edgifc.get_registry_version(version)
    except Exception as e:
      e.add_note(f"for version {version}")
      raise

  return version_to_registry

def parse_args():
  parser = argparse.ArgumentParser(
    description = 'EDG IFC support code generator.'
  )
  parser.add_argument(
    '--header',
    dest = 'header_file_name',
    default = 'ifc_map.h',
    help = 'the name of the header file'
  )
  parser.add_argument(
    '--header-functions',
    dest = 'header_functions_file_name',
    default = 'ifc_map_functions.h',
    help = 'the name of the functions header file'
  )
  parser.add_argument(
    '--impl-functions',
    dest = 'impl_functions_file_name',
    default = 'ifc_map_functions.c',
    help = 'the name of the functions implementation file'
  )
  parser.add_argument(
    '--impl-accessor-functions',
    dest = 'impl_functions_acc_file_name',
    default = 'ifc_map_functions_acc.c',
    help = 'the name of the accessor functions implementation file'
  )
  parser.add_argument(
    '--impl-validation-functions',
    dest = 'impl_functions_val_file_name',
    default = 'ifc_map_functions_val.c',
    help = 'the name of the validation functions implementation file'
  )
  parser.add_argument(
    '--impl-mutator-functions',
    dest = 'impl_functions_mut_file_name',
    default = 'ifc_map_functions_mut.c',
    help = 'the name of the mutator functions implementation file'
  )
  parser.add_argument(
    '--impl-debug-functions',
    dest = 'impl_functions_dbg_file_name',
    default = 'ifc_map_functions_dbg.c',
    help = 'the name of the debug functions implementation file'
  )
  parser.add_argument(
    '--impl-instantiations',
    dest = 'impl_inst_file_name',
    default = 'ifc_modules_inst.h',
    help = 'the name of the explicit template instantiations file'
  )
  parser.add_argument(
    '--impl-specializations',
    dest = 'impl_spec_file_name',
    default = 'ifc_modules_spec.h',
    help = 'the name of the explicit template specializations file'
  )
  parser.add_argument(
    '--standalone',
    dest = 'standalone',
    action="store_true",
    help=(
      'make the produced file compilable by itself'
    )
  )
# The non-expensive dedup option needs more work before it's viable (and
# it may never be necessary).
#   parser.add_argument(
#     '--expensive-dedup',
#     dest = 'use_expensive_dedup',
#     action="store_true",
#     help=(
#       'use a more expensive (but guaranteed to be accurate branch '
#       'deduplication strategy'
#     )
#   )
  return parser.parse_args()

def main() -> None:
  version_to_registry = load_registries()
  revision_info = generate_revision_information(version_to_registry)

  args = parse_args()

  file_role_to_path = {
    'type': args.header_file_name,
    'decl': args.header_functions_file_name,
    'def': args.impl_functions_file_name,
    'acc_def': args.impl_functions_acc_file_name,
    'dbg_def': args.impl_functions_dbg_file_name,
    'mut_def': args.impl_functions_mut_file_name,
    'val_def': args.impl_functions_val_file_name,
    'tmpl_inst': args.impl_inst_file_name,
    'tmpl_spec': args.impl_spec_file_name
  }
  file_paths = list(file_role_to_path.values())

  # Find any missing files and prompt to create them.
  missing_file_paths = []
  for file_path in file_paths:
    if not os.path.exists(file_path):
      missing_file_paths.append(file_path)
  if len(missing_file_paths) > 0:
    print('The following requested files are missing:')
    for path in missing_file_paths:
      print(f" - {path}")
    result = input('Create them now [y/N]? ')
    if result != 'y':
      sys.exit(0)

  # This can be changed to a much cleaner with statement when we bump to Python
  # 3.10 (revert the commit adding this comment).
  with contextlib.ExitStack() as stack:
    # Open the files using the exit stack.
    files = [stack.enter_context(open(fname, 'w')) for fname in file_paths]

    file_roles = list(file_role_to_path.keys())
    file_role_to_file_handle = {}
    for idx, file in enumerate(files):
      role = file_roles[idx]
      file_role_to_file_handle[role] = file

    # Form a split ouput stream from the file handles.
    split_output_stream = SplitOutputStream(file_role_to_file_handle)

    codegen = CPPCodeGen(
      version_to_registry,
      revision_info,
      use_expensive_branch_dedup = True
      # The non-expensive dedup option needs more work before it's viable (and
      # it may never be necessary).
      # use_expensive_branch_dedup = args.use_expensive_dedup
    )
    codegen.write_core(split_output_stream, standalone = args.standalone)

main()
