import argparse
import asyncio
import os
import sys
import uuid

import edgtest
import edgacknowledg
import edgutil

from pathlib import Path

from edgacknowledg.client import (
  BackgroundWorkerPool,
  DirectClient,
  add_endpoint_arguments,
  form_section_http_url,
)
from edgacknowledg.client.shared import SandboxContext
from edgacknowledg.client.test import TestEditHandler, TestSourceHandler
from edgacknowledg import IncompatibleProtocolVersion
from edgutil import eprint

def print_connection_status(message: str) -> None:
  eprint(f"[Connection] {message}")


class _CliConnectionStatusListener:
  '''Print direct-socket lifecycle events for the CLI.'''

  def connected(self) -> None:
    print_connection_status('Connected!')

  def attempting_reconnect(self) -> None:
    print_connection_status('Attempting to reconnect...')

  def disconnected(self) -> None:
    print_connection_status('Disconnected.')


def parse_args() -> argparse.Namespace:
  '''Parse the commandline arguments for this script.'''
  parser = argparse.ArgumentParser(
    description = 'Tool to launch an AcknowlEDG test review session'
  )
  parser.add_argument(
    '--api-key',
    dest = 'api_key',
    default = os.environ.get('EDG_ACKNOWLEDG_API_KEY'),
    help = 'API key for /source and /edit (or EDG_ACKNOWLEDG_API_KEY)'
  )
  add_endpoint_arguments(parser)
  parser.add_argument(
    '--id',
    dest = 'run_id',
    default = str(uuid.uuid4()),
    help = 'the UUID that identifies the run'
  )
  parser.add_argument(
    '--name',
    dest = 'output_name',
    default = None,
    help = (
      'review title (default: "Review opened by <username>")'
    )
  )
  parser.add_argument(
    '--section-name',
    dest = 'section_name',
    default = 'Tests',
    help = 'display name for this review section/tab'
  )
  parser.add_argument(
    '--die-after',
    dest = 'die_after',
    default = 0,
    type = int,
    help = (
      'if set, the program will automatically terminate after the specified '
      'number of minutes'
    )
  )
  parser.add_argument(
    '--ignore-replays',
    dest = 'ignore_replays',
    action = 'store_true',
    help = 'ignore edgy test replays when considering test runs'
  )
  parser.add_argument(
    '-b',
    dest = 'num_runs_back',
    action = 'count',
    default = 0,
    help = (
      'examine the previous test run (if this flag is repeated, go back the '
      'number of times the flag was repeated)'
    )
  )
  parser.add_argument(
    '--root',
    dest = 'root_path',
    type = Path,
    required = False,
    help = 'the root path to examine'
  )
  return parser.parse_args()

def main() -> None:
  args = parse_args()

  test_home = edgtest.load_test_home_or_exit()

  previous_run_dirs = edgtest.get_test_runs(
    test_home,
    include_replays = not args.ignore_replays
  )
  test_comparison = edgtest.TestRunInspection(
    args.root_path,
    args.num_runs_back,
    previous_run_dirs
  )
  run_dir = test_comparison.get_run_directory()
  if not run_dir.exists():
    eprint(f"Path does not exist: {run_dir}")
    sys.exit(1)

  changes_files = edgtest.find_changes_files(run_dir)
  if len(changes_files) < 1:
    eprint("Could not find any changes.elist file(s).")
    sys.exit(1)

  run_id = uuid.UUID(args.run_id)
  review_name = edgacknowledg.review_display_name(args.output_name)
  created_at = edgacknowledg.utc_now_iso()
  slug = edgacknowledg.section_slug(args.section_name)
  specified_timeout = args.die_after * 60 if args.die_after > 0 else None

  print_connection_status("Starting new session view at:")
  review_url = form_section_http_url(
    args.ui_hostname,
    args.ui_port,
    run_id,
    edgacknowledg.TAG_PREFIX_TEST_SRC,
    slug
  )
  print_connection_status(f"  {review_url}")

  async def run_tasks(loop: asyncio.AbstractEventLoop) -> None:
    try:
      worker_pool = BackgroundWorkerPool()
      async with DirectClient(
        api_host = args.api_hostname,
        api_port = args.api_port,
        api_key = args.api_key,
        status_listener = _CliConnectionStatusListener()
      ) as session:
        review = await session.create_review(
          run_id, [edgacknowledg.rich_text(review_name)], created_at
        )
        # The run (given with --root, it may lie elsewhere) and the test
        # home are all a review may read.
        context = SandboxContext(test_home, run_dir)
        await review.add_section(TestSourceHandler(
          args.section_name,
          slug,
          context,
          context.subpath(test_home),
          context.subpath(run_dir)
        ))
        await review.add_section(
          TestEditHandler(args.section_name, slug, worker_pool)
        )
        print_connection_status(
          f"Section: \"{args.section_name}\" of review: \"{review_name}\"."
        )

        if specified_timeout is not None:
          await asyncio.sleep(specified_timeout)
          print_connection_status('die-after elapsed, shutting down...')
          await session.stop()
    except IncompatibleProtocolVersion:
      eprint('Client out of date, please update tools.')
    except asyncio.CancelledError:
      pass

  edgutil.run_asyncio_loop(run_tasks)

main()
