# Route --il_display to the first (C++-generating) stage of cpfe-cp-gen-be.
# Some IL fields, such as declared_storage_class, are only present in that
# source-sequence-list configuration.

if [ -z "$CPFE" ] ; then
  echo 'CPFE is not set.' >&2
  exit 1
fi

CPFEA_IL_DISPLAY=1 exec "$CPFE" "$@"
