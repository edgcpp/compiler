#!/usr/bin/env python3

# Part of the EDG Compiler Project, under the Apache License v2.0 with LLVM
# Exceptions.
# See https://edgcpp.org/LICENSE.txt for license information.
# SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception

import argparse
import re
import sys

from pathlib import Path
from typing import Iterator, List, Optional, Tuple

CMD_DESCRIPTION = '''
Compare the C code produced by two runs of the C-generating back end.

Two front ends built from the same sources must generate the same C for the
same input, but some parts of the output are expected to differ from run to
run:

  - the date and time in the header comment (and in the expansions of
    __DATE__ and __TIME__);
  - the names of temporaries, which are formed from IL pointer values
    (e.g., "__T139870915871024");
  - where long lines are wrapped (which depends on the lengths of those
    names), including the line directives and split comments that wrapping
    introduces.

The comparison ignores comments, line directives, white space, the digits of
temporary names, and date and time strings.  Everything else must match token
for token.

For example, in a build configured with -DEDG_SELF_COMPILE=ON, the following
compares the C generated by cpfe and by cpfe-self (the front end compiled
from that C):

  edg-compare-gen-c src/cmake/cpfe-self/cpfe-c src/cmake/cpfe-self/cpfe-self-c
'''

# This regex splits generated C into the pieces relevant to the comparison.
# Comments, line directives (e.g., '# 123 "file.c"'), and white space are
# ignored; string and character literals are kept whole so that their contents
# are compared exactly.
_TOKEN_REGEX = re.compile(
  r'''
    (?P<comment>/\*.*?\*/)
  | (?P<line_directive>^[ \t]*\#[ \t]*(?:line[ \t]+)?[0-9][^\n]*$)
  | (?P<white_space>\s+)
  | (?P<literal>"(?:\\.|[^"\\\n])*"|'(?:\\.|[^'\\\n])*')
  | (?P<identifier>[A-Za-z_][A-Za-z_0-9]*)
  | (?P<other>.)
  ''',
  re.DOTALL | re.MULTILINE | re.VERBOSE
)

_IGNORED_TOKEN_KINDS = ('comment', 'line_directive', 'white_space')

# Temporary names are "__T" followed by a number derived from an IL pointer.
_TEMPORARY_NAME_REGEX = re.compile(r'__T[0-9]+')

# The expansions of __DATE__ (e.g., "Oct  7 2026") and __TIME__ (e.g.,
# "17:16:23").
_DATE_OR_TIME_REGEX = re.compile(
  r'"(?:[A-Z][a-z]{2} [ 0-9][0-9] [0-9]{4}|[0-9]{2}:[0-9]{2}:[0-9]{2})"'
)

# The number of tokens shown on each side of the first difference.
_CONTEXT_TOKEN_COUNT = 12

def _parse_args() -> argparse.Namespace:
  parser = argparse.ArgumentParser(
    description = CMD_DESCRIPTION,
    formatter_class = argparse.RawDescriptionHelpFormatter
  )
  parser.add_argument(
    'first_dir',
    type = Path,
    help = 'the directory containing the first set of generated C files'
  )
  parser.add_argument(
    'second_dir',
    type = Path,
    help = 'the directory containing the second set of generated C files'
  )
  parser.add_argument(
    'file_names',
    nargs = '*',
    help = (
      'the names of the files to compare (by default, every "*.c" file in '
      'first_dir)'
    )
  )
  return parser.parse_args()

def _normalized_tokens(file_path: Path) -> Iterator[Tuple[str, int]]:
  '''
  Yield the tokens of the generated C file at file_path that take part in the
  comparison (with the expected run-to-run differences normalized away), each
  paired with its line number.
  '''
  # Generated C need not be valid UTF-8 (e.g., it may contain string literals
  # in other encodings), so read it as Latin-1, which maps every byte.
  text = file_path.read_text(encoding = 'latin-1')
  line_number = 1
  for match in _TOKEN_REGEX.finditer(text):
    kind = match.lastgroup
    token = match.group()
    token_line_number = line_number
    line_number += token.count('\n')
    if kind in _IGNORED_TOKEN_KINDS:
      continue
    if kind == 'identifier' and _TEMPORARY_NAME_REGEX.fullmatch(token):
      token = '__T'
    elif kind == 'literal' and _DATE_OR_TIME_REGEX.fullmatch(token):
      token = '"<date or time>"'
    yield token, token_line_number

def _tokenize(file_path: Path) -> Tuple[List[str], List[int]]:
  '''
  Return the normalized tokens of the generated C file at file_path and their
  line numbers.
  '''
  tokens: List[str] = []
  line_numbers: List[int] = []
  for token, line_number in _normalized_tokens(file_path):
    tokens.append(token)
    line_numbers.append(line_number)
  return tokens, line_numbers

def _describe_location(file_path: Path, tokens: List[str],
                       line_numbers: List[int], index: int) -> str:
  '''
  Return a description of where the token at index is in the generated C file
  at file_path (whose normalized tokens and their line numbers are given),
  along with the surrounding tokens.
  '''
  if index < len(tokens):
    location = f"{file_path}, line {line_numbers[index]}"
  else:
    location = f"{file_path}, at the end"
  start = max(0, index - _CONTEXT_TOKEN_COUNT)
  context = ' '.join(tokens[start:index + _CONTEXT_TOKEN_COUNT])
  return f"  {location}:\n    ... {context} ..."

def _describe_difference(first_path: Path,
                         second_path: Path) -> Optional[str]:
  '''
  Return None if the two generated C files match, and otherwise a description
  of the first difference between them.
  '''
  first_tokens, first_line_numbers = _tokenize(first_path)
  second_tokens, second_line_numbers = _tokenize(second_path)
  if first_tokens == second_tokens:
    return None
  index = 0
  while (index < len(first_tokens) and index < len(second_tokens) and
         first_tokens[index] == second_tokens[index]):
    index += 1
  return '\n'.join([
    f"{first_path.name}: the generated C differs:",
    _describe_location(first_path, first_tokens, first_line_numbers, index),
    _describe_location(second_path, second_tokens, second_line_numbers,
                       index)
  ])

def main() -> None:
  args = _parse_args()
  file_names: List[str] = args.file_names
  if not file_names:
    file_names = sorted(path.name for path in args.first_dir.glob('*.c'))
    if not file_names:
      sys.exit(f"error: no generated C files found in {args.first_dir}")

  mismatch_count = 0
  for file_name in file_names:
    first_path = args.first_dir / file_name
    second_path = args.second_dir / file_name
    missing_paths = [path for path in (first_path, second_path)
                     if not path.is_file()]
    if missing_paths:
      for path in missing_paths:
        print(f"{file_name}: missing {path}")
      mismatch_count += 1
      continue
    difference = _describe_difference(first_path, second_path)
    if difference is not None:
      print(difference)
      mismatch_count += 1

  print(
    f"{len(file_names) - mismatch_count} of {len(file_names)} generated C "
    'files match.'
  )
  if mismatch_count != 0:
    sys.exit(1)

main()
