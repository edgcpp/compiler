import argparse
import os

import edgdocker
import edgutil

from pathlib import Path, PurePosixPath

CMD_DESCRIPTION = f"""
EDG development environment shell.

This tool is a specialized version of edg-exec used to launch a development
shell within the standardized docker.

  edg-docker-shell

Like edg-exec, this will provide a bash shell inside of the standardized
development environment.  However, unlike edg-exec, this command will
intelligently set /edg/workspace to the compiler source directory.

Additionally, this command will attempt to launch your preferred shell in
the container.

Currently this command only supports the {edgdocker.DEFAULT_IMAGE} image.

-----------------------------------------------------------------------------
"""

def parse_args():
  parser = argparse.ArgumentParser(
    description = CMD_DESCRIPTION,
    formatter_class = argparse.RawDescriptionHelpFormatter
  )
  parser.add_argument(
    '--platform',
    dest = 'platform_specifier',
    default = 'linux/amd64',
    help = 'the expected platform for the image'
  )
  parser.add_argument(
    '--wdir',
    dest = 'working_dir',
    default = '',
    type = PurePosixPath,
    help = (
      'the working directory inside of the container to launch into '
      '(unless an absolute path is specified, this is relative '
      'to "/edg/workspace")'
    )
  )
  parser.add_argument(
    '--memory',
    dest = 'memory_limit',
    default = '',
    help = 'the memory limit for the container, e.g. 10g (none by default)'
  )
  parser.add_argument(
    '--x11',
    dest = 'enable_x11',
    action = 'store_true',
    help = 'enable mapping of X11 from the container to the host system'
  )
  parser.add_argument(
    '--core-dumps',
    dest = 'enable_core_dumps',
    action = 'store_true',
    help = 'enable core dumps within the container'
  )
  parser.add_argument(
    '--dry-run',
    dest = 'dry_run',
    action = 'store_true',
    help = 'echo the command rthat would have been run, but don\'t run it'
  )
  parser.add_argument(
    '--verbose',
    dest = 'verbose',
    action = 'store_true',
    help = 'enable verbose mode'
  )
  return parser.parse_args()

def _resolve_working_directory(args: argparse.Namespace,
                               src_dir: Path) -> PurePosixPath:
  result_path = PurePosixPath('/edg/workspace')

  if args.working_dir != PurePosixPath(''):
    # If a working dir was given on the CLI, try to use it.
    working_dir = args.working_dir

    if str(working_dir).startswith('/'):
      result_path = working_dir
    else:
      result_path = result_path.joinpath(working_dir)
  else:
    # Otherwise, calculate a working directory maintaining the same
    # relativity to the root project source directory.
    cwd = Path.cwd()
    if edgutil.is_path_relative_to(cwd, src_dir):
      result_path = result_path.joinpath(cwd.relative_to(src_dir))

  return result_path

def _resolve_preferred_shell_name() -> str:
  return PurePosixPath(os.environ.get('SHELL', '/usr/bin/bash')).name

def main() -> None:
  edgdocker.terminate_if_running_in_docker()

  args = parse_args()

  workspace_dir = edgutil.find_mono_repo_or_exit()

  edgdocker.ensure_edg_docker_image_present(edgdocker.DEFAULT_IMAGE)

  command_string = f"edg-match-shell \"{_resolve_preferred_shell_name()}\""
  container_working_dir = _resolve_working_directory(args, workspace_dir)

  edgdocker.exec_docker_cmd(
    edgdocker.DEFAULT_IMAGE,
    workspace_dir,
    container_working_dir,
    command_string,
    enable_x11 = args.enable_x11,
    platform_specifier = args.platform_specifier,
    enable_core_dumps = args.enable_core_dumps,
    memory_limit = args.memory_limit,
    dry_run = args.dry_run,
    verbose = args.verbose
  )

main()
